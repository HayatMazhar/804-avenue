@page "/Account/ForgotPassword"
@model Avenue804.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = Cms[ContentBlockSlugs.AccountForgotTitle, "Reset Password"];
}
<div class="auth-card">
  <h1 class="auth-heading">@Cms[ContentBlockSlugs.AccountForgotHeading, "Forgot Password?"]</h1>
  <p class="auth-sub">@Cms[ContentBlockSlugs.AccountForgotSub, "Enter your email and we'll send you a link to reset your password."]</p>

  @if (Model.Sent)
  {
    <div class="auth-success">@Cms[ContentBlockSlugs.AccountForgotSent, "If an account with that email exists, a reset link has been sent."]</div>
    <a asp-page="/Account/Login" class="btn-outline auth-submit">@Cms[ContentBlockSlugs.AccountForgotBackBtn, "Back to Sign In"]</a>
  }
  else
  {
    <form method="post">
      @if (!string.IsNullOrEmpty(Model.Error))
      {
        <div class="auth-error">@Model.Error</div>
      }
      <div class="modal-field"><label asp-for="Email">@Cms[ContentBlockSlugs.AccountLoginEmailLabel, "Email address"]</label><input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" /></div>
      <button type="submit" class="btn-primary auth-submit"><span>@Cms[ContentBlockSlugs.AccountForgotSubmit, "Send Reset Link"]</span></button>
    </form>
    <p class="auth-footer"><a asp-page="/Account/Login">@Cms[ContentBlockSlugs.AccountForgotBackLink, "Back to sign in"]</a></p>
  }
</div>
