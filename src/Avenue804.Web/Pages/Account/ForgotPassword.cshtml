@page "/Account/ForgotPassword"
@model Avenue804.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="auth-card">
  <h1 class="auth-heading">Forgot Password?</h1>
  <p class="auth-sub">Enter your email and we'll send you a link to reset your password.</p>

  @if (Model.Sent)
  {
    <div class="auth-success">If an account with that email exists, a reset link has been sent.</div>
    <a asp-page="/Account/Login" class="btn-outline auth-submit">Back to Sign In</a>
  }
  else
  {
    <form method="post">
      @if (!string.IsNullOrEmpty(Model.Error))
      {
        <div class="auth-error">@Model.Error</div>
      }
      <div class="modal-field"><label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" /></div>
      <button type="submit" class="btn-primary auth-submit"><span>Send Reset Link</span></button>
    </form>
    <p class="auth-footer"><a asp-page="/Account/Login">Back to sign in</a></p>
  }
</div>
