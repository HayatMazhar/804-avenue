@page "/Account/Login"
@model Avenue804.Web.Pages.Account.LoginModel
@inject Avenue804.Web.Services.IFeatureFlagService FeatureFlagService
@using Avenue804.Web.Services
@{
    ViewData["Title"] = "Sign In";
    var flags = await FeatureFlagService.GetAllAsync();
    bool FF(string f) => flags.TryGetValue(f, out var v) && v;
}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem 1rem">
  <div style="width:100%;max-width:460px">

    <!-- Brand -->
    <div style="text-align:center;margin-bottom:2rem">
      <a asp-page="/Index" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
        <span style="font-family:var(--font-nav);font-size:1.4rem;font-weight:800;letter-spacing:.06em;color:var(--text-primary)">804 <span style="color:var(--accent)">AVENUE</span></span>
      </a>
      <p style="font-size:.82rem;color:var(--text-tertiary);margin-top:.5rem">Properties &amp; Contracting — Abu Dhabi</p>
    </div>

    <!-- Card -->
    <div class="card" style="border-top:4px solid var(--accent)">
      <div class="card-content">
        <h1 style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;color:var(--text-primary);letter-spacing:-.02em;margin-bottom:.25rem">Welcome back</h1>
        <p style="font-size:.85rem;color:var(--text-secondary);margin-bottom:1.5rem">Sign in to access your saved properties, reviews, and inquiry history.</p>

        @if (FF(FeatureFlags.GoogleSignIn) || FF(FeatureFlags.FacebookSignIn) || FF(FeatureFlags.AppleSignIn))
        {
          <div style="display:flex;flex-direction:column;gap:.6rem;margin-bottom:1.25rem">
            @if (FF(FeatureFlags.GoogleSignIn))
            {
              <a href="/signin-google?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")" class="button is-google is-fullwidth">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>
                <span>Continue with Google</span>
              </a>
            }
            @if (FF(FeatureFlags.FacebookSignIn))
            {
              <a href="/signin-facebook?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")" class="button is-facebook is-fullwidth">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073c0 6.025 4.388 11.022 10.125 11.927v-8.436H7.078v-3.491h3.047v-2.66c0-3.025 1.791-4.694 4.533-4.694 1.313 0 2.686.235 2.686.235v2.953h-1.514c-1.491 0-1.955.93-1.955 1.884v2.282h3.328l-.532 3.491h-2.796v8.436C19.612 23.095 24 18.098 24 12.073z"/></svg></span>
                <span>Continue with Facebook</span>
              </a>
            }
            @if (FF(FeatureFlags.AppleSignIn))
            {
              <a href="/signin-apple?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")" class="button is-apple is-fullwidth">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg></span>
                <span>Continue with Apple</span>
              </a>
            }
          </div>
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.25rem">
            <hr style="flex:1;border:none;border-top:1px solid var(--border-subtle)">
            <span style="font-size:.72rem;color:var(--text-tertiary);font-family:var(--font-nav);letter-spacing:.1em;text-transform:uppercase">or</span>
            <hr style="flex:1;border:none;border-top:1px solid var(--border-subtle)">
          </div>
        }

        <!-- Email / Phone tabs -->
        @if (FF(FeatureFlags.PhoneOtp))
        {
          <div class="tabs is-boxed is-small" style="margin-bottom:1rem">
            <ul>
              <li class="is-active" id="tabEmail"><a onclick="switchTab('email')" style="cursor:pointer">Email</a></li>
              <li id="tabPhone"><a onclick="switchTab('phone')" style="cursor:pointer">Phone OTP</a></li>
            </ul>
          </div>
        }

        <!-- Email panel -->
        <div id="panelEmail">
          <form method="post" asp-page-handler="Email">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
              <div class="notification is-danger is-light" style="padding:.75rem 1rem;margin-bottom:1rem">@Model.ErrorMessage</div>
            }
            <div class="field">
              <label class="label">Email address</label>
              <div class="control has-icons-left">
                <input class="input" asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" />
                <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
              </div>
            </div>
            <div class="field">
              <label class="label" style="display:flex;justify-content:space-between;align-items:center">
                <span>Password</span>
                <a asp-page="/Account/ForgotPassword" style="font-size:.72rem;color:var(--accent);text-transform:none;letter-spacing:0;font-weight:600">Forgot password?</a>
              </label>
              <div class="control has-icons-left">
                <input class="input" asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" />
                <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></span>
              </div>
            </div>
            <div class="field">
              <label class="checkbox" style="font-size:.85rem">
                <input type="checkbox" asp-for="RememberMe" /> Remember me for 30 days
              </label>
            </div>
            <div class="field">
              <div class="control">
                <button type="submit" class="button is-primary is-fullwidth is-medium">Sign In</button>
              </div>
            </div>
          </form>
        </div>

        <!-- Phone OTP panel -->
        @if (FF(FeatureFlags.PhoneOtp))
        {
          <div id="panelPhone" style="display:none">
            @if (!string.IsNullOrEmpty(Model.PhoneError))
            {
              <div class="notification is-danger is-light" style="padding:.75rem 1rem;margin-bottom:1rem">@Model.PhoneError</div>
            }
            <form method="post" asp-page-handler="SendOtp" id="phoneSendForm">
              <div class="field">
                <label class="label">Mobile number</label>
                <div class="control has-icons-left">
                  <input class="input" name="phoneNumber" type="tel" inputmode="tel" placeholder="+971 50 000 0000" />
                  <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.11 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg></span>
                </div>
              </div>
              <div class="control"><button type="submit" class="button is-primary is-fullwidth">Send OTP</button></div>
            </form>
            <form method="post" asp-page-handler="VerifyOtp" id="otpVerifyForm" style="display:none;margin-top:1rem">
              <input type="hidden" name="phoneNumber" id="phoneHidden" />
              <div class="field">
                <label class="label">6-digit verification code</label>
                <div class="control"><input class="input" name="code" type="text" inputmode="numeric" maxlength="6" placeholder="123 456" autocomplete="one-time-code" style="letter-spacing:.3em;font-size:1.1rem;text-align:center" /></div>
              </div>
              <div class="control"><button type="submit" class="button is-primary is-fullwidth">Verify &amp; Sign In</button></div>
            </form>
            <div class="notification is-info is-light" id="otpSentMsg" style="display:none;padding:.75rem 1rem;margin-top:.75rem">OTP sent! Enter the code from your SMS.</div>
          </div>
        }

        <!-- Footer -->
        <p style="text-align:center;font-size:.82rem;color:var(--text-tertiary);margin-top:1.25rem">
          New to 804 Avenue? <a asp-page="/Account/Register" style="color:var(--accent);font-weight:700">Create account</a>
        </p>
      </div>
    </div>

  </div>
</div>

@section Scripts {
<script>
function switchTab(tab) {
  document.getElementById('panelEmail').style.display = tab === 'email' ? '' : 'none';
  document.getElementById('panelPhone').style.display = tab === 'phone' ? '' : 'none';
  var te=document.getElementById('tabEmail'), tp=document.getElementById('tabPhone');
  if(te) te.classList.toggle('is-active', tab==='email');
  if(tp) tp.classList.toggle('is-active', tab==='phone');
}
document.getElementById('phoneSendForm')?.addEventListener('submit', function() {
  var phone = this.querySelector('input[name=phoneNumber]').value;
  setTimeout(function() {
    document.getElementById('otpVerifyForm').style.display = '';
    document.getElementById('otpSentMsg').style.display = '';
    document.getElementById('phoneHidden').value = phone;
  }, 800);
});
</script>
}
