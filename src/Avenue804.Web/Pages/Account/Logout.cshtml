@page "/Account/Logout"
@model Avenue804.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = Cms[ContentBlockSlugs.AccountLogoutTitle, "Signed out"];
}
<div class="auth-card" style="text-align:center;padding:48px 24px">
  <p style="color:var(--text-secondary)">@Cms[ContentBlockSlugs.AccountLogoutMessage, "You have been signed out."]</p>
  <a asp-page="/Index" class="btn-primary" style="display:inline-flex;margin-top:20px"><span>@Cms[ContentBlockSlugs.AccountLogoutBackBtn, "Back to home"]</span></a>
</div>
