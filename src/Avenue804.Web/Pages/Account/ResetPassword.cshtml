@page "/Account/ResetPassword"
@model Avenue804.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="auth-card">
  <h1 class="auth-heading">Set New Password</h1>
  @if (Model.Done)
  {
    <div class="auth-success">Password updated successfully!</div>
    <a asp-page="/Account/Login" class="btn-primary auth-submit"><span>Sign In</span></a>
  }
  else
  {
    <form method="post">
      <div asp-validation-summary="ModelOnly" class="auth-error"></div>
      <input type="hidden" asp-for="UserId" />
      <input type="hidden" asp-for="Token" />
      <div class="modal-field"><label asp-for="Password">New password</label><input asp-for="Password" type="password" placeholder="••••••••" /></div>
      <div class="modal-field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" placeholder="••••••••" /></div>
      <button type="submit" class="btn-primary auth-submit"><span>Update Password</span></button>
    </form>
  }
</div>
