@page "/Contact"
@model ContactModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Avenue804.Web.Infrastructure
@{
    ViewData["Title"] = "Contact Us";
    ViewData["MetaDescription"] = "Get in touch with 804 Avenue — Abu Dhabi office address, phone, email, and WhatsApp. Send us a message and our team will respond shortly.";
    ViewData["NavActive"] = "contact";
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
}
@section Styles {
  <link rel="stylesheet" href="~/css/service-pages.css" asp-append-version="true" />
  <style>
    /* ════════════════════════════════════════════════════════════════
       CONTACT US — modern split-screen design
       Shares the .lyp2-* design system used by /ListYourProperty and
       /Inquiry so all three flows feel like one product.
    ════════════════════════════════════════════════════════════════ */
    .lyp2 {
      --lyp-ink:        #0F172A;
      --lyp-ink-soft:   #475569;
      --lyp-ink-faint:  #94A3B8;
      --lyp-line:       #E5E7EB;
      --lyp-line-soft:  #F1F5F9;
      --lyp-card:       #FFFFFF;
      --lyp-page:       #F7F8FB;
      --lyp-accent:     var(--accent, #C9A04F);
      --lyp-accent-08:  rgba(201,160,79,.08);
      --lyp-accent-15:  rgba(201,160,79,.15);
      --lyp-accent-30:  rgba(201,160,79,.30);
      --lyp-radius:     14px;
      --lyp-radius-sm:  10px;
    }

    /* ─── Hero split section ────────────────────────────────────── */
    .lyp2-hero {
      position: relative;
      padding: 110px 0 80px;
      background:
        radial-gradient(1200px 600px at 110% -10%, rgba(201,160,79,.18), transparent 60%),
        radial-gradient(900px 500px  at -10% 100%, rgba(201,160,79,.08), transparent 55%),
        linear-gradient(180deg, #0B1224 0%, #111B33 100%);
      color: #fff;
      overflow: hidden;
    }
    .lyp2-hero::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 36px 36px;
      mask-image: radial-gradient(900px 500px at 30% 40%, #000 30%, transparent 70%);
      -webkit-mask-image: radial-gradient(900px 500px at 30% 40%, #000 30%, transparent 70%);
      pointer-events: none;
    }

    .lyp2-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: start;
    }
    @@media (min-width: 1024px) {
      .lyp2-grid { grid-template-columns: 1fr 1.18fr; gap: 56px; }
    }

    /* ─── Left column: marketing + contact methods ───────────────── */
    .lyp2-content { position: relative; padding: 0 4px; }
    .lyp2-content__crumbs {
      font-size: .78rem;
      color: rgba(255,255,255,.65);
      margin-bottom: 26px;
      display: flex; align-items: center; gap: 8px;
    }
    .lyp2-content__crumbs a { color: rgba(255,255,255,.65); text-decoration: none; }
    .lyp2-content__crumbs a:hover { color: #fff; }
    .lyp2-content__crumbs .sep { opacity: .5; }

    .lyp2-content__eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 12px;
      border-radius: 999px;
      background: var(--lyp-accent-15);
      color: var(--lyp-accent);
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .lyp2-content__eyebrow::before {
      content: ''; width: 6px; height: 6px; border-radius: 999px;
      background: var(--lyp-accent);
      box-shadow: 0 0 0 4px var(--lyp-accent-15);
    }

    .lyp2-content__title {
      font-family: var(--font-display, inherit);
      font-size: clamp(2rem, 4.4vw, 3.4rem);
      line-height: 1.08;
      font-weight: 700;
      margin: 0 0 18px;
      color: #fff;
      letter-spacing: -.01em;
    }
    .lyp2-content__title em {
      font-style: normal;
      background: linear-gradient(135deg, #E5C681 0%, var(--lyp-accent) 60%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .lyp2-content__lead {
      font-size: 1.05rem;
      line-height: 1.65;
      color: rgba(255,255,255,.78);
      margin: 0 0 32px;
      max-width: 540px;
    }

    /* Direct-contact bullets (action links: phone / email / wa / pin) */
    .lyp2-contacts {
      list-style: none;
      padding: 0;
      margin: 0 0 28px;
      display: flex; flex-direction: column; gap: 4px;
      max-width: 540px;
    }
    .lyp2-contacts li { padding: 0; }
    .lyp2-contact-row {
      display: flex; align-items: center; gap: 14px;
      padding: 12px 12px;
      border-radius: var(--lyp-radius-sm);
      text-decoration: none;
      color: inherit;
      transition: background .15s ease, transform .15s ease;
    }
    .lyp2-contact-row:hover {
      background: rgba(255,255,255,.06);
      transform: translateX(2px);
    }
    .lyp2-contact-row > svg {
      flex: 0 0 38px;
      width: 38px; height: 38px;
      padding: 9px;
      border-radius: 10px;
      background: var(--lyp-accent-15);
      color: var(--lyp-accent);
      stroke-width: 1.8;
    }
    .lyp2-contact-row .label {
      display: block;
      font-size: .66rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.55);
      margin-bottom: 2px;
    }
    .lyp2-contact-row .value {
      display: block;
      font-size: .98rem;
      color: #fff;
      font-weight: 500;
      line-height: 1.4;
    }

    /* Compact business-hours badge */
    .lyp2-hours-card {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 18px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.10);
      border-radius: var(--lyp-radius);
      max-width: 540px;
    }
    .lyp2-hours-card svg {
      flex: 0 0 22px;
      width: 22px; height: 22px;
      color: var(--lyp-accent);
    }
    .lyp2-hours-card .h-title {
      font-size: .68rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.55);
      margin-bottom: 2px;
    }
    .lyp2-hours-card .h-body {
      font-size: .88rem;
      color: rgba(255,255,255,.85);
      line-height: 1.45;
    }
    .lyp2-hours-card .h-body em {
      font-style: normal;
      color: var(--lyp-accent);
      font-weight: 600;
    }

    /* ─── Right column: floating form card ───────────────────────── */
    .lyp2-card {
      position: relative;
      background: var(--lyp-card);
      border-radius: 18px;
      box-shadow:
        0 32px 80px -20px rgba(8,15,35,.45),
        0 0 0 1px rgba(255,255,255,.05);
      overflow: hidden;
      transform: translateZ(0);
    }
    .lyp2-card__head {
      position: relative;
      padding: 22px 28px 18px;
      background: linear-gradient(135deg, var(--lyp-accent) 0%, #B98A3D 100%);
      color: #fff;
      overflow: hidden;
    }
    .lyp2-card__head::after {
      content: '';
      position: absolute;
      top: -40%; right: -15%;
      width: 240px; height: 240px;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgba(255,255,255,.20), transparent 70%);
      pointer-events: none;
    }
    .lyp2-card__head h2 {
      font-family: var(--font-display, inherit);
      font-size: 1.25rem; font-weight: 700;
      margin: 0; letter-spacing: -.005em;
    }
    .lyp2-card__head p {
      margin: 4px 0 0;
      font-size: .82rem;
      color: rgba(255,255,255,.85);
    }

    .lyp2-card__body { padding: 24px 28px 8px; }
    .lyp2-card__foot {
      padding: 18px 28px 26px;
      border-top: 1px solid var(--lyp-line-soft);
      background: linear-gradient(180deg, #fff, #FBFAF6);
    }
    @@media (max-width: 540px) {
      .lyp2-card__head, .lyp2-card__body, .lyp2-card__foot { padding-left: 18px; padding-right: 18px; }
    }

    /* Cross-link callout above the form */
    .lyp2-callout {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 12px 14px;
      background: var(--lyp-accent-08);
      border: 1px solid var(--lyp-accent-15);
      border-radius: var(--lyp-radius-sm);
      margin-bottom: 18px;
    }
    .lyp2-callout svg {
      flex: 0 0 18px;
      width: 18px; height: 18px;
      color: var(--lyp-accent);
      margin-top: 2px;
    }
    .lyp2-callout p {
      margin: 0;
      font-size: .85rem;
      color: var(--lyp-ink-soft);
      line-height: 1.5;
    }
    .lyp2-callout p strong { color: var(--lyp-ink); font-weight: 600; }
    .lyp2-callout p a { color: var(--lyp-accent); font-weight: 600; }

    /* Section heading inside the form */
    .lyp2-sec {
      display: flex; align-items: center; gap: 10px;
      font-size: .68rem;
      font-weight: 700;
      color: var(--lyp-ink-soft);
      letter-spacing: .12em;
      text-transform: uppercase;
      margin: 22px 0 14px;
    }
    .lyp2-sec:first-child { margin-top: 4px; }
    .lyp2-sec__num {
      width: 22px; height: 22px;
      border-radius: 7px;
      background: var(--lyp-accent-08);
      color: var(--lyp-accent);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: .72rem; font-weight: 800;
    }
    .lyp2-sec::after {
      content: ''; flex: 1;
      height: 1px;
      background: var(--lyp-line);
      margin-left: 6px;
    }

    /* Field grid */
    .lyp2-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @@media (max-width: 640px) { .lyp2-row { grid-template-columns: 1fr; gap: 10px; } }

    /* Floating-label input */
    .float {
      position: relative;
      margin-bottom: 14px;
    }
    .float input,
    .float textarea {
      width: 100%; box-sizing: border-box;
      padding: 22px 14px 8px;
      font: inherit;
      font-size: .95rem;
      color: var(--lyp-ink);
      background: #fff;
      border: 1.5px solid var(--lyp-line);
      border-radius: var(--lyp-radius-sm);
      transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
      -webkit-appearance: none;
    }
    .float textarea { resize: vertical; min-height: 130px; padding-top: 26px; }
    .float input::placeholder,
    .float textarea::placeholder { color: transparent; }
    .float label {
      position: absolute;
      top: 16px; left: 14px;
      font-size: .92rem;
      color: var(--lyp-ink-faint);
      pointer-events: none;
      transition: top .14s ease, font-size .14s ease, color .14s ease, font-weight .14s ease;
      background: transparent;
      padding: 0 2px;
    }
    .float input:focus,
    .float textarea:focus {
      outline: none;
      border-color: var(--lyp-accent);
      box-shadow: 0 0 0 4px var(--lyp-accent-15);
      background: #fff;
    }
    .float input:focus + label,
    .float input:not(:placeholder-shown) + label,
    .float textarea:focus + label,
    .float textarea:not(:placeholder-shown) + label {
      top: 6px;
      font-size: .66rem;
      font-weight: 700;
      color: var(--lyp-accent);
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .float .req { color: var(--lyp-accent); margin-left: 2px; }
    .float .opt { color: var(--lyp-ink-faint); font-weight: 400; }

    /* Validation error spans */
    .lyp2-error {
      display: block;
      font-size: .72rem;
      color: #DC2626;
      margin-top: -8px;
      margin-bottom: 10px;
      font-weight: 500;
    }
    .lyp2-error:empty { display: none; }

    /* Inline alert above form */
    .lyp2-alert {
      padding: 10px 14px;
      border-radius: var(--lyp-radius-sm);
      font-size: .85rem;
      margin-bottom: 14px;
    }
    .lyp2-alert--error {
      background: #FEF2F2;
      color: #B91C1C;
      border: 1px solid #FECACA;
    }
    .lyp2-alert:empty { display: none; }

    /* Submit */
    .lyp2-submit {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 22px;
      background: linear-gradient(135deg, var(--lyp-accent) 0%, #B98A3D 100%);
      color: #fff;
      border: none;
      border-radius: var(--lyp-radius-sm);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: .01em;
      cursor: pointer;
      box-shadow: 0 10px 28px rgba(201,160,79,.32);
      transition: transform .12s ease, box-shadow .15s ease, filter .15s ease;
    }
    .lyp2-submit:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 36px rgba(201,160,79,.42);
      filter: brightness(1.04);
    }
    .lyp2-submit:active { transform: translateY(0); }
    .lyp2-submit svg { transition: transform .15s ease; }
    .lyp2-submit:hover svg { transform: translateX(3px); }

    .lyp2-foot-note {
      display: flex; align-items: center; justify-content: center;
      gap: 6px;
      font-size: .72rem;
      color: var(--lyp-ink-faint);
      margin: 12px 0 0;
      text-align: center;
    }
    .lyp2-foot-note svg { flex: 0 0 12px; color: var(--lyp-accent); }
    .lyp2-foot-note a { color: var(--lyp-accent); font-weight: 600; }

    /* ─── Channel triage strip ───────────────────────────────────── */
    .lyp2-how {
      padding: 72px 0 88px;
      background: var(--lyp-page);
    }
    .lyp2-how__title {
      text-align: center;
      font-family: var(--font-display, inherit);
      font-size: clamp(1.5rem, 2.6vw, 2rem);
      font-weight: 700;
      color: var(--lyp-ink);
      margin: 0 0 12px;
      letter-spacing: -.01em;
    }
    .lyp2-how__title em {
      font-style: normal;
      color: var(--lyp-accent);
    }
    .lyp2-how__sub {
      text-align: center;
      font-size: .98rem;
      color: var(--lyp-ink-soft);
      max-width: 580px;
      margin: 0 auto 48px;
    }
    .lyp2-how__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @@media (max-width: 820px) {
      .lyp2-how__grid { grid-template-columns: 1fr; }
    }
    .lyp2-channel {
      position: relative;
      display: flex; flex-direction: column;
      background: #fff;
      padding: 28px 26px 26px;
      border: 1px solid var(--lyp-line);
      border-radius: var(--lyp-radius);
      box-shadow: 0 4px 16px rgba(8,15,35,.04);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
      text-decoration: none;
      color: inherit;
    }
    .lyp2-channel:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 36px rgba(8,15,35,.08);
      border-color: var(--lyp-accent-30);
      color: inherit;
    }
    .lyp2-channel__icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--lyp-accent), #B98A3D);
      color: #fff;
      margin-bottom: 14px;
      box-shadow: 0 8px 18px rgba(201,160,79,.28);
    }
    .lyp2-channel__title {
      font-size: 1.05rem; font-weight: 700;
      color: var(--lyp-ink);
      margin: 0 0 6px;
      letter-spacing: -.005em;
    }
    .lyp2-channel__body {
      font-size: .88rem;
      line-height: 1.55;
      color: var(--lyp-ink-soft);
      margin: 0 0 16px;
      flex: 1;
    }
    .lyp2-channel__cta {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .82rem;
      font-weight: 700;
      color: var(--lyp-accent);
      letter-spacing: .01em;
      transition: gap .15s ease;
    }
    .lyp2-channel:hover .lyp2-channel__cta { gap: 10px; }
    .lyp2-channel__cta svg { transition: transform .15s ease; }
    .lyp2-channel:hover .lyp2-channel__cta svg { transform: translateX(2px); }

    /* fade-up entry */
    .lyp2-fade { opacity: 0; transform: translateY(14px); animation: lypFade .6s ease forwards; }
    .lyp2-fade.d2 { animation-delay: .08s; }
    .lyp2-fade.d3 { animation-delay: .16s; }
    .lyp2-fade.d4 { animation-delay: .24s; }
    @@keyframes lypFade { to { opacity: 1; transform: translateY(0); } }
  </style>
}

<section class="lyp2 lyp2-hero">
  <div class="container">
    <div class="lyp2-grid">

      <!-- ─── LEFT: marketing + direct-contact methods ─────────── -->
      <div class="lyp2-content">
        <div class="lyp2-content__crumbs lyp2-fade">
          <a asp-page="/Index">Home</a>
          <span class="sep">/</span>
          <span>Contact</span>
        </div>

        <span class="lyp2-content__eyebrow lyp2-fade">Get in touch</span>

        <h1 class="lyp2-content__title lyp2-fade d2">
          We'd love to<br />
          <em>hear from you</em>
        </h1>

        <p class="lyp2-content__lead lyp2-fade d2">
          Got a question, feedback, or just want to say hello? Send us a message — we
          typically respond within a few hours during business days. Or reach us
          directly through any of the channels below.
        </p>

        <ul class="lyp2-contacts lyp2-fade d3">
          @if (!string.IsNullOrWhiteSpace(site?.Address))
          {
            <li>
              <span class="lyp2-contact-row" style="cursor: default">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>
                  <span class="label">Office address</span>
                  <span class="value">@site.Address</span>
                </span>
              </span>
            </li>
          }
          @if (!string.IsNullOrWhiteSpace(site?.PhoneDisplay))
          {
            <li>
              <a class="lyp2-contact-row" href="@site.TelHref">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.11 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                <span>
                  <span class="label">Call us</span>
                  <span class="value">@site.PhoneDisplay</span>
                </span>
              </a>
            </li>
          }
          @if (!string.IsNullOrWhiteSpace(site?.Email))
          {
            <li>
              <a class="lyp2-contact-row" href="mailto:@site.Email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span>
                  <span class="label">Email us</span>
                  <span class="value">@site.Email</span>
                </span>
              </a>
            </li>
          }
          @if (!string.IsNullOrWhiteSpace(site?.WhatsAppHref))
          {
            <li>
              <a class="lyp2-contact-row" href="@site.WhatsAppHref" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
                <span>
                  <span class="label">WhatsApp</span>
                  <span class="value">Chat with our team</span>
                </span>
              </a>
            </li>
          }
        </ul>

        <div class="lyp2-hours-card lyp2-fade d4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <div>
            <div class="h-title">Business hours</div>
            <div class="h-body"><em>Mon – Fri</em> 9 AM – 6 PM &nbsp;·&nbsp; <em>Sat</em> 10 AM – 2 PM &nbsp;·&nbsp; <em>Sun</em> Closed</div>
          </div>
        </div>
      </div>

      <!-- ─── RIGHT: form card ───────────────────────────────── -->
      <div class="lyp2-card lyp2-fade d2">
        <div class="lyp2-card__head">
          <h2>Send us a message</h2>
          <p>We typically respond within a few hours on business days.</p>
        </div>

        <div class="lyp2-card__body">
          <div class="lyp2-callout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            <p>
              <strong>Looking to buy, sell or rent?</strong>
              Use our <a asp-page="/Inquiry">property inquiry form</a> instead — it captures the right details so we can match you faster.
            </p>
          </div>

          <div asp-validation-summary="ModelOnly" class="lyp2-alert lyp2-alert--error"></div>

          <form method="post" id="contactForm" novalidate>

            <!-- Section 1: Your details -->
            <div class="lyp2-sec"><span class="lyp2-sec__num">1</span>Your details</div>

            <div class="lyp2-row">
              <div class="float">
                <input id="cName" asp-for="Name" type="text" autocomplete="name" maxlength="200" placeholder=" " />
                <label for="cName">Full name <span class="req">*</span></label>
              </div>
              <div class="float">
                <input id="cEmail" asp-for="Email" type="email" autocomplete="email" maxlength="256" placeholder=" " />
                <label for="cEmail">Email address <span class="req">*</span></label>
              </div>
            </div>
            <span asp-validation-for="Name" class="lyp2-error"></span>
            <span asp-validation-for="Email" class="lyp2-error"></span>

            <!-- Section 2: Your message -->
            <div class="lyp2-sec"><span class="lyp2-sec__num">2</span>Your message</div>

            <div class="lyp2-row">
              <div class="float">
                <input id="cPhone" asp-for="Phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="50" placeholder=" " />
                <label for="cPhone">Phone <span class="opt">(optional)</span></label>
              </div>
              <div class="float">
                <input id="cSubject" asp-for="Subject" type="text" maxlength="200" placeholder=" " />
                <label for="cSubject">Subject <span class="opt">(optional)</span></label>
              </div>
            </div>
            <span asp-validation-for="Phone" class="lyp2-error"></span>
            <span asp-validation-for="Subject" class="lyp2-error"></span>

            <div class="float">
              <textarea id="cMessage" asp-for="Message" rows="6" maxlength="4000" placeholder=" "></textarea>
              <label for="cMessage">Message <span class="req">*</span></label>
            </div>
            <span asp-validation-for="Message" class="lyp2-error"></span>
          </form>
        </div>

        <div class="lyp2-card__foot">
          <button type="submit" form="contactForm" class="lyp2-submit">
            <span>Send message</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="lyp2-foot-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Secure submission — by submitting you agree to our <a href="/Privacy">Privacy Policy</a>.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ─── Channel triage strip — pick the right form ─────────────── -->
<section class="lyp2 lyp2-how">
  <div class="container">
    <h2 class="lyp2-how__title">Pick the <em>right channel</em></h2>
    <p class="lyp2-how__sub">For faster service, jump straight to the form that matches your need.</p>

    <div class="lyp2-how__grid">
      <a class="lyp2-channel" asp-page="/Inquiry">
        <span class="lyp2-channel__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2h-4v-7H10v7H5a2 2 0 01-2-2z"/></svg>
        </span>
        <h3 class="lyp2-channel__title">Buy, sell or rent property</h3>
        <p class="lyp2-channel__body">Looking for an apartment, villa, office or warehouse? Submit a property requirement and we'll match listings within 24 hours.</p>
        <span class="lyp2-channel__cta">
          Submit a property inquiry
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <a class="lyp2-channel" asp-page="/ListYourProperty">
        <span class="lyp2-channel__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
        </span>
        <h3 class="lyp2-channel__title">List your property</h3>
        <p class="lyp2-channel__body">Own a property you'd like to rent or sell? Get a free valuation and a marketing plan from our property team.</p>
        <span class="lyp2-channel__cta">
          List my property
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <a class="lyp2-channel" asp-page="/Submit/AmcRequest">
        <span class="lyp2-channel__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        <h3 class="lyp2-channel__title">Maintenance &amp; AMC</h3>
        <p class="lyp2-channel__body">Need a maintenance contract, on-call repairs, or facility management? Request a tailored proposal from our operations team.</p>
        <span class="lyp2-channel__cta">
          Request an AMC proposal
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
