@page "/Properties"
@model Avenue804.Web.Pages.Properties.IndexModel
@inject Avenue804.Web.Services.IFeatureFlagService FeatureFlagService
@using Avenue804.Web.Services
@{
    ViewData["Title"] = "Properties for Sale & Rent — Abu Dhabi UAE";
    ViewData["MetaDescription"] = "Browse apartments, villas, townhouses, and commercial properties for sale and rent across Abu Dhabi and the UAE with 804 Avenue.";
    ViewData["NavActive"] = "properties";
    bool mapsEnabled = await FeatureFlagService.IsEnabledAsync(FeatureFlags.GoogleMaps);
    bool compareEnabled = await FeatureFlagService.IsEnabledAsync(FeatureFlags.PropertyCompare);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchKeyword)
        || !string.IsNullOrWhiteSpace(Model.SearchLocation)
        || !string.IsNullOrWhiteSpace(Model.SearchArea)
        || !string.IsNullOrWhiteSpace(Model.SearchCategory)
        || !string.IsNullOrWhiteSpace(Model.SearchType)
        || !string.IsNullOrWhiteSpace(Model.SearchSize)
        || !string.IsNullOrWhiteSpace(Model.SearchBudget)
        || !string.IsNullOrWhiteSpace(Model.Filter);
    var currentOffer = Model.Filter ?? "";
    var currentSort = Model.SortBy ?? "newest";
}
@* properties.css now loaded globally from _Layout.cshtml *@

<!-- ── Compact page header ── -->
<div class="pl-header">
  <div class="container-fluid px-3 px-xl-5">
    <div class="pl-header__inner">
      <nav class="pl-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Index">Home</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        <span>Properties</span>
      </nav>
      <h1 class="pl-header__title">
        @if (hasFilters)
        {
          <span>@Model.TotalCount result@(Model.TotalCount != 1 ? "s" : "")</span><em> found</em>
        }
        else
        {
          <text>Browse <em>Properties</em></text>
        }
      </h1>
    </div>
    <!-- Offer tabs -->
    <div class="pl-offer-tabs">
      <a class="pl-offer-tab @(currentOffer == "" ? "active" : "")" asp-page="/Properties/Index" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" asp-route-sort="@currentSort">All</a>
      <a class="pl-offer-tab @(currentOffer == "sale" ? "active" : "")" asp-page="/Properties/Index" asp-route-offer="sale" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" asp-route-sort="@currentSort">Buy</a>
      <a class="pl-offer-tab @(currentOffer == "rent" ? "active" : "")" asp-page="/Properties/Index" asp-route-offer="rent" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" asp-route-sort="@currentSort">Rent</a>
    </div>
  </div>
</div>

<!-- ── Main search bar ── -->
<div class="pl-searchbar">
  <div class="container-fluid px-3 px-xl-5">
    <form method="get" id="propSearchForm" class="pl-searchbar__form">
      <input type="hidden" name="offer" value="@currentOffer" id="sfOfferHidden" />
      <input type="hidden" name="q" value="@Model.SearchKeyword" />
      <div class="pl-searchbar__field">
        <select name="category" id="sfCategory" class="pl-searchbar__select">
          <option value="">All categories</option>
          <option value="Residential" selected="@(Model.SearchCategory == "Residential")">Residential</option>
          <option value="Commercial" selected="@(Model.SearchCategory == "Commercial")">Commercial</option>
        </select>
      </div>
      <div class="pl-searchbar__sep"></div>
      <div class="pl-searchbar__field">
        <select name="location" id="sfLocation" class="pl-searchbar__select">
          <option value="">Any emirate</option>
          <option value="Abu Dhabi" selected="@(Model.SearchLocation == "Abu Dhabi")">Abu Dhabi</option>
          <option value="Dubai" selected="@(Model.SearchLocation == "Dubai")">Dubai</option>
          <option value="Sharjah" selected="@(Model.SearchLocation == "Sharjah")">Sharjah</option>
          <option value="Ajman" selected="@(Model.SearchLocation == "Ajman")">Ajman</option>
          <option value="Ras Al Khaimah" selected="@(Model.SearchLocation == "Ras Al Khaimah")">Ras Al Khaimah</option>
        </select>
      </div>
      <div class="pl-searchbar__sep"></div>
      <div class="pl-searchbar__field pl-searchbar__field--wide">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <input type="text" name="area" value="@Model.SearchArea" placeholder="Area, community, tower…" autocomplete="off" data-autocomplete="uae" data-ac-emirate-target="sfLocation" class="pl-searchbar__input" />
      </div>
      <div class="pl-searchbar__sep"></div>
      <div class="pl-searchbar__field">
        <select name="type" id="sfType" class="pl-searchbar__select"
                data-details-residential='["Apartment","Villa Apartment","Villa Compound","Villa","Building","Land"]'
                data-details-commercial='["Shell &amp; Core Offices","Furnished Offices","Warehouse / Stores","Showroom","Shop","Villa","Labor Camp","Building","Land"]'>
          <option value="">All types</option>
          <optgroup label="Residential">
            <option value="Apartment" selected="@(Model.SearchType == "Apartment")">Apartment</option>
            <option value="Villa Apartment" selected="@(Model.SearchType == "Villa Apartment")">Villa Apartment</option>
            <option value="Villa Compound" selected="@(Model.SearchType == "Villa Compound")">Villa Compound</option>
            <option value="Villa" selected="@(Model.SearchType == "Villa")">Villa</option>
            <option value="Building" selected="@(Model.SearchType == "Building")">Building</option>
            <option value="Land" selected="@(Model.SearchType == "Land")">Land</option>
          </optgroup>
          <optgroup label="Commercial">
            <option value="Shell &amp; Core Offices" selected="@(Model.SearchType == "Shell & Core Offices")">Shell &amp; Core Offices</option>
            <option value="Furnished Offices" selected="@(Model.SearchType == "Furnished Offices")">Furnished Offices</option>
            <option value="Warehouse / Stores" selected="@(Model.SearchType == "Warehouse / Stores")">Warehouse / Stores</option>
            <option value="Showroom" selected="@(Model.SearchType == "Showroom")">Showroom</option>
            <option value="Shop" selected="@(Model.SearchType == "Shop")">Shop</option>
            <option value="Labor Camp" selected="@(Model.SearchType == "Labor Camp")">Labor Camp</option>
          </optgroup>
        </select>
      </div>
      <div class="pl-searchbar__sep"></div>
      <div class="pl-searchbar__field">
        <select name="size" id="sfSize" class="pl-searchbar__select">
          <option value="">Any size</option>
          <option value="u500" selected="@(Model.SearchSize == "u500")">&lt; 500 sqft</option>
          <option value="500-1000" selected="@(Model.SearchSize == "500-1000")">500 – 1,000 sqft</option>
          <option value="1000-2000" selected="@(Model.SearchSize == "1000-2000")">1,000 – 2,000 sqft</option>
          <option value="2000-5000" selected="@(Model.SearchSize == "2000-5000")">2,000 – 5,000 sqft</option>
          <option value="5000+" selected="@(Model.SearchSize == "5000+")">5,000+ sqft</option>
        </select>
      </div>
      <div class="pl-searchbar__sep"></div>
      <div class="pl-searchbar__field">
        <select name="budget" id="sfBudget" class="pl-searchbar__select">
          <option value="">Any price</option>
          <option value="u500" selected="@(Model.SearchBudget == "u500")">Under 500K</option>
          <option value="500-1m" selected="@(Model.SearchBudget == "500-1m")">500K – 1M</option>
          <option value="1m-5m" selected="@(Model.SearchBudget == "1m-5m")">1M – 5M</option>
          <option value="5m+" selected="@(Model.SearchBudget == "5m+")">5M+</option>
        </select>
      </div>
      <button type="submit" class="pl-searchbar__btn">Search</button>
      @if (hasFilters)
      {
        <a asp-page="/Properties/Index" class="pl-searchbar__clear" title="Clear all filters">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </a>
      }
    </form>
  </div>
</div>

<!-- ── Body: sidebar + grid ── -->
<div class="pl-body">
  <div class="container-fluid px-3 px-xl-5">
    <div class="pl-layout">

      <!-- ── Sidebar filters ── -->
      <aside class="pl-sidebar" id="plSidebar">
        <div class="pl-sidebar__inner">
          <div class="pl-sidebar__head">
            <span class="pl-sidebar__title">Filters</span>
            @if (hasFilters)
            {
              <a asp-page="/Properties/Index" class="pl-sidebar__reset">Reset all</a>
            }
          </div>

            <form method="get" id="sidebarFilterForm">
            <input type="hidden" name="offer" value="@currentOffer" />
            <input type="hidden" name="q" value="@Model.SearchKeyword" />
            <input type="hidden" name="area" value="@Model.SearchArea" />

            <!-- Category -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Property Type</div>
              <div class="pl-filter-checkboxes">
                <label class="pl-filter-check @(Model.SearchCategory == "Residential" ? "is-checked" : "")">
                  <input type="radio" name="category" value="Residential" @(Model.SearchCategory == "Residential" ? "checked" : "") />
                  Residential
                </label>
                <label class="pl-filter-check @(Model.SearchCategory == "Commercial" ? "is-checked" : "")">
                  <input type="radio" name="category" value="Commercial" @(Model.SearchCategory == "Commercial" ? "checked" : "") />
                  Commercial
                </label>
                <label class="pl-filter-check @(string.IsNullOrWhiteSpace(Model.SearchCategory) ? "is-checked" : "")">
                  <input type="radio" name="category" value="" @(string.IsNullOrWhiteSpace(Model.SearchCategory) ? "checked" : "") />
                  All categories
                </label>
              </div>
            </div>

            <!-- Emirate -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Emirate</div>
              <div class="pl-filter-checkboxes">
                @{
                  var emirates = new[] { "Abu Dhabi", "Dubai", "Sharjah", "Ajman", "Ras Al Khaimah" };
                }
                @foreach (var em in emirates)
                {
                  <label class="pl-filter-check @(Model.SearchLocation == em ? "is-checked" : "")">
                    <input type="radio" name="location" value="@em" @(Model.SearchLocation == em ? "checked" : "") />
                    @em
                  </label>
                }
                <label class="pl-filter-check @(string.IsNullOrWhiteSpace(Model.SearchLocation) ? "is-checked" : "")">
                  <input type="radio" name="location" value="" @(string.IsNullOrWhiteSpace(Model.SearchLocation) ? "checked" : "") />
                  Any emirate
                </label>
              </div>
            </div>

            <!-- Property details -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Property Details</div>
              <div class="pl-filter-checkboxes">
                @{
                  var residentialTypes = new[] { "Apartment", "Villa Apartment", "Villa Compound", "Villa", "Building", "Land" };
                  var commercialTypes  = new[] { "Shell & Core Offices", "Furnished Offices", "Warehouse / Stores", "Showroom", "Shop", "Labor Camp", "Building", "Land" };
                  var allTypes = string.IsNullOrWhiteSpace(Model.SearchCategory)
                      ? residentialTypes.Union(commercialTypes).Distinct().ToArray()
                      : Model.SearchCategory == "Commercial" ? commercialTypes : residentialTypes;
                }
                @foreach (var t in allTypes)
                {
                  <label class="pl-filter-check @(Model.SearchType == t ? "is-checked" : "")">
                    <input type="radio" name="type" value="@t" @(Model.SearchType == t ? "checked" : "") />
                    @t
                  </label>
                }
                <label class="pl-filter-check @(string.IsNullOrWhiteSpace(Model.SearchType) ? "is-checked" : "")">
                  <input type="radio" name="type" value="" @(string.IsNullOrWhiteSpace(Model.SearchType) ? "checked" : "") />
                  All types
                </label>
              </div>
            </div>

            <!-- Size -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Size (sqft)</div>
              <div class="pl-filter-checkboxes">
                <label class="pl-filter-check @(Model.SearchSize == "u500" ? "is-checked" : "")">
                  <input type="radio" name="size" value="u500" @(Model.SearchSize == "u500" ? "checked" : "") />
                  Under 500
                </label>
                <label class="pl-filter-check @(Model.SearchSize == "500-1000" ? "is-checked" : "")">
                  <input type="radio" name="size" value="500-1000" @(Model.SearchSize == "500-1000" ? "checked" : "") />
                  500 – 1,000
                </label>
                <label class="pl-filter-check @(Model.SearchSize == "1000-2000" ? "is-checked" : "")">
                  <input type="radio" name="size" value="1000-2000" @(Model.SearchSize == "1000-2000" ? "checked" : "") />
                  1,000 – 2,000
                </label>
                <label class="pl-filter-check @(Model.SearchSize == "2000-5000" ? "is-checked" : "")">
                  <input type="radio" name="size" value="2000-5000" @(Model.SearchSize == "2000-5000" ? "checked" : "") />
                  2,000 – 5,000
                </label>
                <label class="pl-filter-check @(Model.SearchSize == "5000+" ? "is-checked" : "")">
                  <input type="radio" name="size" value="5000+" @(Model.SearchSize == "5000+" ? "checked" : "") />
                  5,000+
                </label>
                <label class="pl-filter-check @(string.IsNullOrWhiteSpace(Model.SearchSize) ? "is-checked" : "")">
                  <input type="radio" name="size" value="" @(string.IsNullOrWhiteSpace(Model.SearchSize) ? "checked" : "") />
                  Any size
                </label>
              </div>
            </div>

            <!-- Price -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Price (AED)</div>
              <div class="pl-filter-checkboxes">
                <label class="pl-filter-check @(Model.SearchBudget == "u500" ? "is-checked" : "")">
                  <input type="radio" name="budget" value="u500" @(Model.SearchBudget == "u500" ? "checked" : "") />
                  Under 500K
                </label>
                <label class="pl-filter-check @(Model.SearchBudget == "500-1m" ? "is-checked" : "")">
                  <input type="radio" name="budget" value="500-1m" @(Model.SearchBudget == "500-1m" ? "checked" : "") />
                  500K – 1M
                </label>
                <label class="pl-filter-check @(Model.SearchBudget == "1m-5m" ? "is-checked" : "")">
                  <input type="radio" name="budget" value="1m-5m" @(Model.SearchBudget == "1m-5m" ? "checked" : "") />
                  1M – 5M
                </label>
                <label class="pl-filter-check @(Model.SearchBudget == "5m+" ? "is-checked" : "")">
                  <input type="radio" name="budget" value="5m+" @(Model.SearchBudget == "5m+" ? "checked" : "") />
                  5M+
                </label>
                <label class="pl-filter-check @(string.IsNullOrWhiteSpace(Model.SearchBudget) ? "is-checked" : "")">
                  <input type="radio" name="budget" value="" @(string.IsNullOrWhiteSpace(Model.SearchBudget) ? "checked" : "") />
                  Any price
                </label>
              </div>
            </div>

            <!-- Features (Verified) -->
            <div class="pl-filter-group">
              <div class="pl-filter-group__label">Features</div>
              <div class="pl-filter-checkboxes">
                <label class="pl-filter-check @(currentSort == "verified" ? "is-checked" : "")">
                  <input type="radio" name="sort" value="verified" @(currentSort == "verified" ? "checked" : "") />
                  Verified only
                </label>
                <label class="pl-filter-check @(currentSort == "reduced" ? "is-checked" : "")">
                  <input type="radio" name="sort" value="reduced" @(currentSort == "reduced" ? "checked" : "") />
                  Price reduced
                </label>
              </div>
            </div>

            <button type="submit" class="pl-filter-apply">Apply Filters</button>
          </form>
        </div>
      </aside>

      <!-- ── Grid content ── -->
      <main class="pl-main">

        <!-- Sort bar -->
        <div class="pl-sortbar">
          <div class="pl-sortbar__count">
            @if (hasFilters)
            {
              <strong>@Model.TotalCount</strong> @(Model.TotalCount != 1 ? "properties" : "property") 
            }
            else
            {
              <strong>@Model.TotalCount</strong> @(Model.TotalCount != 1 ? "properties" : "property")
            }
          </div>
          <div class="pl-sortbar__right">
            <!-- Save search -->
            @if (hasFilters)
            {
              <form method="post" asp-page="/Api/SaveSearch" style="display:inline">
                @foreach (var kv in HttpContext.Request.Query)
                {
                  <input type="hidden" name="@kv.Key" value="@kv.Value" />
                }
                <button type="submit" class="pl-sortbar__save">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                  Save search
                </button>
              </form>
            }
            <!-- Sort -->
            <div class="pl-sortbar__sort-wrap">
              <label class="pl-sortbar__sort-label">Sort:</label>
              <select id="sfSort" name="sort" class="pl-sortbar__sort-select" onchange="document.getElementById('propSearchForm').submit()">
                <option value="newest" selected="@(currentSort == "newest")">Newest first</option>
                <option value="price-asc" selected="@(currentSort == "price-asc")">Price: Low → High</option>
                <option value="price-desc" selected="@(currentSort == "price-desc")">Price: High → Low</option>
                <option value="views" selected="@(currentSort == "views")">Most viewed</option>
                <option value="verified" selected="@(currentSort == "verified")">Verified first</option>
                <option value="reduced" selected="@(currentSort == "reduced")">Price reduced</option>
              </select>
            </div>
            <!-- View toggle -->
            <div class="pl-view-toggle" id="viewToggle">
              <button class="pl-view-btn active" id="btnGrid" title="Grid view">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              </button>
              <button class="pl-view-btn" id="btnList" title="List view">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              </button>
            </div>
            <!-- Map toggle -->
            @if (mapsEnabled)
            {
              <button class="pl-map-toggle" id="btnMapToggle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                Map view
              </button>
            }
            <!-- Mobile filter toggle -->
            <button class="pl-mobile-filter-btn" id="btnMobileFilter">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
              Filters
              @if (hasFilters) { <span class="pl-mobile-filter-badge">!</span> }
            </button>
          </div>
        </div>

        <!-- Map panel (hidden by default) -->
        @if (mapsEnabled)
        {
          <div id="plMapPanel" class="pl-map-panel" style="display:none">
            <div id="propMap" style="width:100%;height:100%"></div>
          </div>
        }

        <!-- Active filter chips -->
        @if (hasFilters)
        {
          <div class="pl-chips">
            @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
            {
              <span class="pl-chip">
                "@Model.SearchKeyword"
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchLocation))
            {
              <span class="pl-chip">
                @Model.SearchLocation
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-area="@Model.SearchArea" asp-route-category="@Model.SearchCategory" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchCategory))
            {
              <span class="pl-chip">
                @Model.SearchCategory
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchArea))
            {
              <span class="pl-chip">
                Area: @Model.SearchArea
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-category="@Model.SearchCategory" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchType))
            {
              <span class="pl-chip">
                @Model.SearchType
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-category="@Model.SearchCategory" asp-route-size="@Model.SearchSize" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchSize))
            {
              <span class="pl-chip">
                @(Model.SearchSize switch { "u500"=>"< 500 sqft","500-1000"=>"500–1,000 sqft","1000-2000"=>"1,000–2,000 sqft","2000-5000"=>"2,000–5,000 sqft","5000+"=>"5,000+ sqft",_=>Model.SearchSize })
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-budget="@Model.SearchBudget" class="pl-chip__x">×</a>
              </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchBudget))
            {
              <span class="pl-chip">
                @(Model.SearchBudget switch { "u500"=>"Under 500K","500-1m"=>"500K–1M","1m-5m"=>"1M–5M","5m+"=>"5M+",_=>Model.SearchBudget })
                <a asp-page="/Properties/Index" asp-route-offer="@currentOffer" asp-route-q="@Model.SearchKeyword" asp-route-location="@Model.SearchLocation" asp-route-area="@Model.SearchArea" asp-route-type="@Model.SearchType" asp-route-size="@Model.SearchSize" class="pl-chip__x">×</a>
              </span>
            }
          </div>
        }

        <!-- Property grid -->
        @if (Model.Listings.Count == 0)
        {
          <div class="pl-empty">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <h3>No properties found</h3>
            <p>Try adjusting your filters — or <a asp-page="/Contact">contact us</a> and we'll find it for you.</p>
            <a asp-page="/Properties/Index" class="ph-btn ph-btn--primary" style="margin-top:20px">Clear all filters</a>
          </div>
        }
        else
        {
          <div class="pl-grid" id="plGrid">
            @foreach (var p in Model.Listings)
            {
              <partial name="Shared/_PropertyCard" model="p" />
            }
          </div>
        }

        <!-- Recently viewed -->
        <div id="recentlyViewedSection" style="display:none;margin-top:48px;padding-top:32px;border-top:1px solid #e5e7eb">
          <p class="ph-tag" style="margin-bottom:16px">Your Recent Views</p>
          <div id="recentlyViewedGrid" class="pl-grid"></div>
        </div>

      </main>
    </div><!-- .pl-layout -->
  </div>
</div>

@section Scripts {
<script>
(function() {
  // Sync URL params → selects
  var params = new URLSearchParams(window.location.search);
  ['sfCategory','sfLocation','sfType','sfSize','sfBudget','sfSort'].forEach(function(id) {
    var el = document.getElementById(id);
    var key = { sfCategory:'category', sfLocation:'location', sfType:'type', sfSize:'size', sfBudget:'budget', sfSort:'sort' }[id];
    if (el && params.has(key)) el.value = params.get(key);
  });

  // When category changes in searchbar, cascade the type options
  (function() {
    var cat = document.getElementById('sfCategory');
    var det = document.getElementById('sfType');
    if (!cat || !det) return;

    function readList(key) {
      var raw = det.getAttribute('data-details-' + key.toLowerCase());
      if (!raw) return null;
      try { return JSON.parse(raw.replace(/&amp;/g, '&')); } catch(e) { return null; }
    }

    function filterGroups() {
      var v = cat.value;
      Array.from(det.querySelectorAll('optgroup')).forEach(function(g) {
        if (!v) { g.hidden = false; return; }
        g.hidden = g.label.toLowerCase() !== v.toLowerCase();
      });
      if (det.selectedOptions.length && det.value) {
        var selGroup = det.selectedOptions[0].closest('optgroup');
        if (selGroup && selGroup.hidden) det.value = '';
      }
    }

    cat.addEventListener('change', filterGroups);
    filterGroups();
  })();

  // Grid / List toggle
  var grid = document.getElementById('plGrid');
  var btnGrid = document.getElementById('btnGrid');
  var btnList = document.getElementById('btnList');
  var savedView = localStorage.getItem('804-prop-view') || 'grid';
  function setView(v) {
    if (!grid) return;
    grid.classList.toggle('pl-grid--list', v === 'list');
    if (btnGrid) btnGrid.classList.toggle('active', v === 'grid');
    if (btnList) btnList.classList.toggle('active', v === 'list');
    localStorage.setItem('804-prop-view', v);
  }
  setView(savedView);
  if (btnGrid) btnGrid.addEventListener('click', function() { setView('grid'); });
  if (btnList) btnList.addEventListener('click', function() { setView('list'); });

  // Map toggle
  var mapPanel = document.getElementById('plMapPanel');
  var btnMap = document.getElementById('btnMapToggle');
  if (btnMap && mapPanel) {
    btnMap.addEventListener('click', function() {
      var open = mapPanel.style.display !== 'none';
      mapPanel.style.display = open ? 'none' : 'block';
      btnMap.classList.toggle('active', !open);
    });
  }

  // Mobile sidebar toggle
  var sidebar = document.getElementById('plSidebar');
  var btnMobile = document.getElementById('btnMobileFilter');
  if (btnMobile && sidebar) {
    btnMobile.addEventListener('click', function() {
      sidebar.classList.toggle('pl-sidebar--open');
    });
    document.addEventListener('click', function(e) {
      if (sidebar && !sidebar.contains(e.target) && e.target !== btnMobile) {
        sidebar.classList.remove('pl-sidebar--open');
      }
    });
  }

  // Sidebar radio auto-submit
  document.querySelectorAll('#sidebarFilterForm input[type="radio"]').forEach(function(r) {
    r.addEventListener('change', function() {
      document.getElementById('sidebarFilterForm').submit();
    });
  });

  // Recently viewed
  var viewed = JSON.parse(sessionStorage.getItem('804-viewed') || '[]');
  if (viewed.length) {
    var sec = document.getElementById('recentlyViewedSection');
    var g = document.getElementById('recentlyViewedGrid');
    if (sec && g) {
      sec.style.display = '';
      viewed.slice(0, 3).forEach(function(p) {
        var el = document.createElement('a');
        el.href = '/Properties/' + p.slug;
        el.className = 'prop-card fade-up';
        el.style.textDecoration = 'none';
        el.innerHTML = '<div class="prop-card-img"><img src="' + p.img + '" alt="' + p.title + '" loading="lazy" /></div><div class="prop-card-body"><div class="prop-name">' + p.title + '</div></div>';
        g.appendChild(el);
      });
    }
  }
})();
</script>

@if (mapsEnabled)
{
  string mapApiKey = ViewContext.HttpContext.RequestServices.GetRequiredService<IConfiguration>()["Maps:GoogleMapsApiKey"] ?? "";
  <text>
  <script>
  var _listingLocations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.Listings.Where(p => !string.IsNullOrWhiteSpace(p.Location))
          .Select(p => new { title = p.Title, loc = p.Location, slug = p.Slug, price = p.Price?.ToString("N0") ?? "" })
          .ToList()));

  function initMap() {
    var mapEl = document.getElementById('propMap');
    if (!mapEl || typeof google === 'undefined') return;
    var geocoder = new google.maps.Geocoder();
    var map = new google.maps.Map(mapEl, {
      zoom: 10, center: { lat: 24.4539, lng: 54.3773 },
      mapTypeControl: false, streetViewControl: false,
      styles: [{ featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] }]
    });
    _listingLocations.forEach(function(p) {
      geocoder.geocode({ address: p.loc + ', UAE' }, function(results, status) {
        if (status === 'OK') {
          var marker = new google.maps.Marker({ map: map, position: results[0].geometry.location, title: p.title });
          var info = new google.maps.InfoWindow({ content: '<div style="padding:4px"><strong>' + p.title + '</strong><br>AED ' + p.price + '<br><a href="/Properties/' + p.slug + '">View</a></div>' });
          marker.addListener('click', function() { info.open(map, marker); });
        }
      });
    });
  }
  </script>
  <script async src="https://maps.googleapis.com/maps/api/js?key=@mapApiKey&callback=initMap"></script>
  </text>
}
}
