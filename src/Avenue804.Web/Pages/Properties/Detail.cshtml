  .opd-spec-label{font-family:var(--font-nav);font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-tertiary)}
  .opd-spec-value{font-family:var(--font-display);font-size:1rem;font-weight:700;color:var(--text-primary)}
  .opd-chips{display:flex;flex-wrap:wrap;gap:8px}
  .opd-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:999px;font-size:.78rem;color:var(--text-secondary)}
  .opd-chip--feature{background:var(--accent-soft,rgba(245,158,11,.1));border-color:var(--accent-50,rgba(245,158,11,.3));color:var(--accent)}
  .opd-pay-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .opd-pay-tile{padding:22px 16px;background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--radius-md);text-align:center}
  .opd-pay-tile--accent{background:linear-gradient(135deg,var(--accent),var(--cyan,#0ea5e9));border-color:transparent;color:#fff}
  .opd-pay-tile--accent .opd-pay-pct{color:#fff}
  .opd-pay-tile--accent .opd-pay-label{color:rgba(255,255,255,.85)}
  .opd-pay-pct{font-family:var(--font-display);font-size:2.2rem;font-weight:800;color:var(--accent);line-height:1.05}
  .opd-pay-label{font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;color:var(--text-tertiary);margin-top:6px}
  .opd-pay-note{font-size:.78rem;color:var(--text-tertiary);margin:14px 0 0;text-align:center}
