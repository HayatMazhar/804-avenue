@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function copyLink(url, btn) {
  var orig = btn.innerHTML;
  var ok = function() {
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Copied!';
    btn.style.color = 'var(--accent, #c9a04f)';
    setTimeout(function() { btn.innerHTML = orig; btn.style.color = ''; }, 2500);
  };
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(url).then(ok).catch(function() {
      // fallback for permission denied
      var ta = document.createElement('textarea');
      ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); ok(); } catch(e) { alert(url); }
      document.body.removeChild(ta);
    });
  } else {
    // HTTP or older browser fallback
    var ta = document.createElement('textarea');
    ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); ok(); } catch(e) { alert(url); }
    document.body.removeChild(ta);
  }
}

// Price history chart
(function() {
  var ctx = document.getElementById('priceHistoryChart');
  if (!ctx) return;
  var history = @Html.Raw(!string.IsNullOrWhiteSpace(L.PriceHistoryJson) ? L.PriceHistoryJson : "[]");
  if (L.PreviousPrice && !history.some(function(h) { return h.price === @((long?)L.PreviousPrice ?? 0); }))
    history.push({ date: '@((L.UpdatedAt ?? L.CreatedAt).AddDays(-30).ToString("yyyy-MM-dd"))', price: @((long?)L.PreviousPrice ?? 0) });
  var currentPrice = @((long?)L.Price ?? 0);
  if (currentPrice > 0) history.push({ date: '@(DateTimeOffset.UtcNow.ToString("yyyy-MM-dd"))', price: currentPrice });
  if (history.length < 2) { ctx.closest('.price-history-section').style.display='none'; return; }
  history.sort(function(a,b) { return a.date.localeCompare(b.date); });

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: history.map(function(h) { return h.date; }),
      datasets: [{
        label: 'Price (AED)', data: history.map(function(h) { return h.price; }),
        borderColor: 'rgba(245,158,11,0.9)', backgroundColor: 'rgba(245,158,11,0.08)',
        borderWidth: 2, fill: true, tension: 0.3, pointRadius: 4, pointBackgroundColor: 'rgba(245,158,11,1)'
      }]
    },
    options: {
      responsive: true, plugins: { legend: { display: false } },
      scales: {
        y: { ticks: { color: '#64748B', callback: function(v) { return 'AED ' + (v/1000000).toFixed(1) + 'M'; }}, grid: { color: 'rgba(15,23,42,.06)' } },
        x: { ticks: { color: '#64748B' }, grid: { display: false } }
      }
    }
  });
})();

// ROI Calculator
function calcRoi() {
  var price = parseFloat(document.getElementById('roiPrice')?.value) || 0;
  var rent = parseFloat(document.getElementById('roiRent')?.value) || 0;
  var charge = parseFloat(document.getElementById('roiCharge')?.value) || 0;
  var res = document.getElementById('roiResults');
  if (!res || price <= 0 || rent <= 0) { if (res) res.style.display = 'none'; return; }
  var gross = (rent / price * 100).toFixed(2);
  var net = ((rent - charge) / price * 100).toFixed(2);
  var payback = rent > 0 ? (price / rent).toFixed(1) : '—';
  var monthly = Math.round(rent / 12).toLocaleString();
  document.getElementById('roiGross').textContent = gross + '%';
  document.getElementById('roiNet').textContent = net + '%';
  document.getElementById('roiIncome').textContent = 'AED ' + Math.round(rent).toLocaleString();
  document.getElementById('roiMonthly').textContent = 'AED ' + monthly;
  document.getElementById('roiPayback').textContent = payback + ' yrs';
  res.style.display = 'grid';
}

// Floor plan lightbox
function openFloorPlan() {
  var url = '@(L.FloorPlanUrl ?? "")';
  if (!url) return;
  var lb = document.createElement('div');
  lb.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(5,8,14,.96);display:flex;align-items:center;justify-content:center;cursor:zoom-out';
  lb.onclick = function() { document.body.removeChild(lb); };
  var img = document.createElement('img');
  img.src = url; img.style.cssText = 'max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px';
  lb.appendChild(img);
  document.body.appendChild(lb);
}

// Recently viewed — save to sessionStorage
(function trackViewed() {
  var key = '804-viewed';
  var viewed = JSON.parse(sessionStorage.getItem(key) || '[]');
  var id = @(L.Id);
  viewed = viewed.filter(function(v) { return v.id !== id; });
  viewed.unshift({ id: id, slug: '@L.Slug', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L.Title)), img: '@ListingFormat.ListingImageUrl(L.MainImageUrl)' });
  if (viewed.length > 10) viewed = viewed.slice(0, 10);
  sessionStorage.setItem(key, JSON.stringify(viewed));
})();

// Currency converter (static approximate rates)
var _aedPrice = @(L.Price.HasValue ? ((decimal)L.Price.Value).ToString("F0", System.Globalization.CultureInfo.InvariantCulture) : "0");
var _rates = { AED: 1, USD: 0.2723, EUR: 0.2497, GBP: 0.2131 };
function convertCurrency() {
  var sel = document.getElementById('currencySelect');
  var out = document.getElementById('convertedPrice');
  if (!sel || !out || !_aedPrice) return;
  var cur = sel.value;
  if (cur === 'AED') { out.style.display = 'none'; return; }
  var converted = Math.round(_aedPrice * (_rates[cur] || 1));
  out.textContent = '≈ ' + cur + ' ' + converted.toLocaleString();
  out.style.display = '';
}

// Gallery lightbox
var _galleryImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allImages));
var _lightboxIdx = 0;
function openLightbox(idx) {
  _lightboxIdx = idx;
  var lb = document.getElementById('lightbox');
  var img = document.getElementById('lightboxImg');
  if (!lb || !img) return;
  // Move the lightbox to <body> so its position:fixed isn't trapped by any
  // ancestor with a CSS transform (e.g. the .fade-up animation wrappers).
  if (lb.parentElement !== document.body) document.body.appendChild(lb);
  img.src = _galleryImages[idx];
  document.getElementById('lightboxCounter').textContent = (idx+1) + ' / ' + _galleryImages.length;
  lb.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').style.display = 'none';
  document.body.style.overflow = '';
}
function shiftLightbox(dir) {
  var next = (_lightboxIdx + dir + _galleryImages.length) % _galleryImages.length;
  openLightbox(next);
}
document.addEventListener('keydown', function(e) {
  var lb = document.getElementById('lightbox');
  if (!lb || lb.style.display === 'none') return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowRight') shiftLightbox(1);
  if (e.key === 'ArrowLeft') shiftLightbox(-1);
});

function toggleCalc() {
  var body = document.getElementById('calcBody');
  var chevron = document.querySelector('.calc-chevron');
  if (!body) return;
  var open = body.style.display === '';
  body.style.display = open ? 'none' : '';
  if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
  if (!open) calcMortgage();
}

function calcMortgage() {
  var price = parseFloat(document.getElementById('calcPrice')?.value) || 0;
  var downPct = parseFloat(document.getElementById('calcDown')?.value) || 25;
  var rate = parseFloat(document.getElementById('calcRate')?.value) || 4.5;
  var years = parseInt(document.getElementById('calcTerm')?.value) || 25;

  var loan = price * (1 - downPct / 100);
  var months = years * 12;
  var r = (rate / 100) / 12;
  var monthly = r === 0 ? loan / months : (loan * r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1);
  var totalInterest = (monthly * months) - loan;
  var waBtn = document.getElementById('waMortgageBtn');
  if (waBtn) waBtn.style.display = monthly > 0 ? '' : 'none';

  var fmt = function(v) { return 'AED ' + Math.round(v).toLocaleString(); };
  var el = function(id) { return document.getElementById(id); };
  if (el('calcMonthly')) el('calcMonthly').textContent = fmt(monthly);
  if (el('calcLoan')) el('calcLoan').textContent = fmt(loan);
  if (el('calcInterest')) el('calcInterest').textContent = fmt(totalInterest);
}

function signInToSave() {
  window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
}

function toggleQuickInquire(forceState) {
  var card = document.getElementById('quickInquireCard');
  var btn  = document.getElementById('quickInquireToggle');
  if (!card) return;
  var willOpen = typeof forceState === 'boolean' ? forceState : (card.style.display === 'none');
  card.style.display = willOpen ? 'block' : 'none';
  if (btn) btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
  if (willOpen) {
    var firstField = card.querySelector('input[name="Name"]');
    if (firstField) setTimeout(function() { firstField.focus(); }, 50);
  }
}

// Star picker
(function() {
  var picker = document.getElementById('starPicker');
  var input = document.getElementById('starsInput');
  if (!picker || !input) return;
  var stars = Array.from(picker.querySelectorAll('.star-pick'));
  function setVal(v) {
    input.value = v;
    stars.forEach(function(s, i) { s.classList.toggle('star-on', i < v); });
  }
  stars.forEach(function(s) {
    s.addEventListener('click', function() { setVal(+this.getAttribute('data-val')); });
    s.addEventListener('mouseenter', function() { stars.forEach(function(x, i) { x.classList.toggle('star-hover', i < +s.getAttribute('data-val')); }); });
    s.addEventListener('mouseleave', function() { stars.forEach(function(x) { x.classList.remove('star-hover'); }); });
  });
})();
</script>
}
