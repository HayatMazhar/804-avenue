@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Domain
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var waNum = site?.WhatsAppDigits ?? "971504399804";
    var phone = site?.TelHref ?? "tel:+971504399804";
    var phoneDisplay = site?.PhoneDisplay ?? "+971 50 43 99 804";
}

<!-- ═══ EMERGENCY STRIP ═══ -->
<section class="emergency-section" id="emergency">
  <div class="container">
    <div class="emergency-inner">
      <div class="emergency-badge">
        <div class="emergency-pulse"></div>
        <div>
          <div class="emergency-label">Available now</div>
          <div class="emergency-title">24/7 Emergency Maintenance Response</div>
        </div>
      </div>
      <div class="emergency-actions">
        <a href="https://wa.me/@waNum?text=EMERGENCY%3A+I+need+urgent+maintenance+assistance" target="_blank" rel="noopener" class="emergency-btn emergency-btn--wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
          WhatsApp Now
        </a>
        <a href="@phone" class="emergency-btn emergency-btn--call">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.11 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          @phoneDisplay
        </a>
        <button onclick="document.getElementById('ticketModal').style.display='flex'" class="emergency-btn emergency-btn--form">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Log a Ticket
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ═══ MAINTENANCE TICKET MODAL ═══ -->
<div id="ticketModal" style="display:none;position:fixed;inset:0;z-index:2000;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.5);backdrop-filter:blur(8px)">
  <div style="background:var(--bg-card);border:1px solid var(--border-accent);border-radius:var(--radius-lg);width:100%;max-width:520px;max-height:calc(100vh - 32px);overflow-y:auto;box-shadow:0 32px 80px rgba(15,23,42,.2)">
    <div style="height:4px;background:linear-gradient(90deg,#DC2626,#F97316);border-radius:var(--radius-lg) var(--radius-lg) 0 0"></div>
    <div style="padding:22px 26px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
      <div>
        <h2 style="font-family:var(--font-display);font-size:1.3rem;font-weight:700;color:var(--text-primary)">Submit Maintenance Request</h2>
        <p style="font-size:.82rem;color:var(--text-secondary);margin-top:4px">For emergencies, use the WhatsApp or call button above for fastest response.</p>
      </div>
      <button onclick="document.getElementById('ticketModal').style.display='none'" style="background:none;border:none;color:var(--text-tertiary);cursor:pointer;font-size:1.3rem;padding:4px">✕</button>
    </div>
    <form method="post" asp-page="/Submit/MaintenanceRequest" style="padding:20px 26px 26px">
      <div class="quote-field"><label>Priority</label>
        <div class="priority-selector">
          <label class="priority-option"><input type="radio" name="priority" value="@((int)TicketPriority.Normal)" checked /> Normal</label>
          <label class="priority-option"><input type="radio" name="priority" value="@((int)TicketPriority.High)" /> High</label>
          <label class="priority-option priority-option--emergency"><input type="radio" name="priority" value="@((int)TicketPriority.Emergency)" /> 🚨 Emergency</label>
        </div>
      </div>
      <div class="quote-grid-2">
        <div class="quote-field"><label>Your name *</label><input type="text" name="name" required maxlength="200" placeholder="Ahmed Al Mansoori" autocomplete="name" /></div>
        <div class="quote-field"><label>Mobile *</label><input type="tel" name="phone" required maxlength="50" placeholder="+971 50 000 0000" inputmode="tel" /></div>
      </div>
      <div class="quote-field"><label>Email *</label><input type="email" name="email" required maxlength="256" placeholder="you@example.com" /></div>
      <div class="quote-field"><label>Building / location *</label><input type="text" name="buildingOrLocation" required maxlength="400" placeholder="Building name, floor, unit number, emirate" /></div>
      <div class="quote-field"><label>Describe the issue *</label><textarea name="issueDescription" required rows="3" maxlength="4000" placeholder="Describe the problem in detail — what is broken, since when, any visible damage…"></textarea></div>
      <button type="submit" class="btn-primary" style="width:100%;justify-content:center;background:linear-gradient(135deg,#DC2626,#F97316)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9z"/></svg>
        <span>Submit Maintenance Ticket</span>
      </button>
    </form>
  </div>
</div>

