@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Domain
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var waNum = site?.WhatsAppDigits ?? "971504399804";
    var phone = site?.TelHref ?? "tel:+971504399804";
    var phoneDisplay = site?.PhoneDisplay ?? "+971 50 43 99 804";
}

<!-- ═══ EMERGENCY STRIP ═══ -->
<section class="emergency-section" id="emergency">
  <div class="container">
    <div class="emergency-inner">
      <div class="emergency-badge">
        <div class="emergency-pulse"></div>
        <div>
          <div class="emergency-label">Available now</div>
          <div class="emergency-title">24/7 Emergency Maintenance Response</div>
        </div>
      </div>
      <div class="emergency-actions">
        <a href="https://wa.me/@waNum?text=EMERGENCY%3A+I+need+urgent+maintenance+assistance" target="_blank" rel="noopener" class="emergency-btn emergency-btn--wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
          WhatsApp Now
        </a>
        <a href="@phone" class="emergency-btn emergency-btn--call">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.11 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          @phoneDisplay
        </a>
        <button onclick="document.getElementById('ticketModal').style.display='flex'" class="emergency-btn emergency-btn--form">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Log a Ticket
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ═══ AMC CALCULATOR ═══ -->
<section class="quote-section" id="amc-quote">
  <div class="container">
    <div class="section-tag fade-up" style="justify-content:center">AMC Estimator</div>
    <h2 class="section-title fade-up" style="text-align:center;max-width:640px;margin:0 auto 12px">Annual Maintenance Contract <em>Cost Estimator</em></h2>
    <p class="section-sub fade-up" style="text-align:center;margin:0 auto 36px">Get an indicative AMC range based on your building size, type, and required services.</p>

    <div class="amc-calc fade-up">
      <div class="amc-grid">
        <div>
          <div class="quote-field">
            <label>Building type</label>
            <select id="amcBType" name="buildingType" onchange="calcAmc()">
              <option value="Residential">Residential</option>
              <option value="Commercial">Commercial / Office</option>
              <option value="Retail">Retail / Mall</option>
              <option value="Industrial">Industrial / Warehouse</option>
              <option value="Mixed">Mixed-use</option>
            </select>
          </div>
          <div class="quote-grid-2">
            <div class="quote-field">
              <label>No. of floors</label>
              <input type="number" id="amcFloors" min="1" max="100" value="5" oninput="calcAmc()" />
            </div>
            <div class="quote-field">
              <label>No. of units</label>
              <input type="number" id="amcUnits" min="1" max="2000" value="20" oninput="calcAmc()" />
            </div>
          </div>
          <div class="quote-field">
            <label>Total area (sqm)</label>
            <input type="number" id="amcArea" min="100" max="500000" value="2000" oninput="calcAmc()" />
          </div>
        </div>
        <div>
          <div class="quote-field"><label>Services required</label></div>
          <div class="amc-services-grid">
            <label class="amc-service-check"><input type="checkbox" value="general" id="amcGeneral" onchange="calcAmc()" checked /> General building</label>
            <label class="amc-service-check"><input type="checkbox" value="civil" id="amcCivil" onchange="calcAmc()" /> Civil maintenance</label>
            <label class="amc-service-check"><input type="checkbox" value="mep" id="amcMep" onchange="calcAmc()" /> MEP systems</label>
            <label class="amc-service-check"><input type="checkbox" value="hvac" id="amcHvac" onchange="calcAmc()" /> HVAC service</label>
            <label class="amc-service-check"><input type="checkbox" value="lift" id="amcLift" onchange="calcAmc()" /> Lifts / escalators</label>
            <label class="amc-service-check"><input type="checkbox" value="pool" id="amcPool" onchange="calcAmc()" /> Pool &amp; gym</label>
            <label class="amc-service-check"><input type="checkbox" value="landscape" id="amcLandscape" onchange="calcAmc()" /> Landscaping</label>
            <label class="amc-service-check"><input type="checkbox" value="pest" id="amcPest" onchange="calcAmc()" /> Pest control</label>
          </div>
        </div>
      </div>

      <div class="amc-result" id="amcResult">
        <div class="amc-result-header">Estimated Annual Maintenance Contract</div>
        <div class="amc-result-grid">
          <div class="amc-result-item"><label>Annual AMC estimate</label><strong id="amcAnnual">AED —</strong></div>
          <div class="amc-result-item"><label>Monthly equivalent</label><strong id="amcMonthly">AED —</strong></div>
          <div class="amc-result-item"><label>Preventive maintenance visits/yr</label><strong id="amcVisits">—</strong></div>
          <div class="amc-result-item"><label>Est. savings vs reactive</label><strong id="amcSavings" style="color:var(--success)">—</strong></div>
        </div>
        <p style="font-size:.72rem;color:var(--text-secondary);margin-top:12px">Indicative estimate only. Final AMC pricing is based on a site survey and agreed scope of services.</p>
      </div>

      <form method="post" asp-page="/Submit/AmcRequest" id="amcForm" style="margin-top:24px;padding-top:24px;border-top:1px solid var(--border-subtle)">
        <input type="hidden" name="buildingType" id="amcBTypeHidden" value="Residential" />
        <input type="hidden" name="numberOfFloors" id="amcFloorsHidden" value="5" />
        <input type="hidden" name="numberOfUnits" id="amcUnitsHidden" value="20" />
        <input type="hidden" name="totalAreaSqm" id="amcAreaHidden" value="2000" />
        <input type="hidden" name="servicesNeeded" id="amcServicesHidden" value="" />
        <input type="hidden" name="estimateRange" id="amcEstimateHidden" value="" />

        <div class="section-tag" style="margin-bottom:16px">Request Formal AMC Quote</div>
        <div class="quote-grid-2">
          <div class="quote-field"><label>Your name <span style="color:var(--accent)">*</span></label><input type="text" name="name" required autocomplete="name" placeholder="Ahmed Al Mansoori" maxlength="200" /></div>
          <div class="quote-field"><label>Company (optional)</label><input type="text" name="company" placeholder="Building management or owner" maxlength="200" /></div>
        </div>
        <div class="quote-grid-2">
          <div class="quote-field"><label>Mobile <span style="color:var(--accent)">*</span></label><input type="tel" name="phone" required inputmode="tel" placeholder="+971 50 000 0000" maxlength="50" /></div>
          <div class="quote-field"><label>Email <span style="color:var(--accent)">*</span></label><input type="email" name="email" required placeholder="you@example.com" maxlength="256" /></div>
        </div>
        <div class="quote-field"><label>Building location</label><input type="text" name="location" placeholder="e.g. Al Reem Island, Abu Dhabi" maxlength="400" /></div>
        <button type="submit" class="btn-primary" style="width:100%;justify-content:center;margin-top:4px" onclick="syncAmcHiddens()">
          <span>Request AMC Proposal</span>
        </button>
      </form>
    </div>
  </div>
</section>

