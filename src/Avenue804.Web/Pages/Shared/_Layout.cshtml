@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Avenue804.Web.Services.IFeatureFlagService FeatureFlagService
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Services
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var meta = ViewData["MetaDescription"] as string ?? site?.DefaultMetaDescription ?? "804 Avenue Properties and Contracting — Abu Dhabi's trusted partner for real estate, construction, and maintenance across the UAE.";
    var brand = site?.CompanyDisplayName ?? "804 Avenue";
    var featureFlags = await FeatureFlagService.GetAllAsync();
    bool FF(string flag) => featureFlags.TryGetValue(flag, out var v) && v;
}
<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var pageTitle = $"{ViewData["Title"]} — {brand}";
        var ogImage = ViewData["OgImage"] as string ?? "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80";
        var pageUrl = $"{HttpContextAccessor.HttpContext?.Request.Scheme}://{HttpContextAccessor.HttpContext?.Request.Host}{HttpContextAccessor.HttpContext?.Request.Path}";
    }
    <title>@pageTitle</title>
    <meta name="description" content="@meta" />
    <link rel="canonical" href="@pageUrl" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@meta" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:site_name" content="@brand" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@meta" />
    <meta name="twitter:image" content="@ogImage" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23F59E0B' stroke-width='1.8'%3E%3Cpath d='M3 21h18M5 21V7l7-4 7 4v14'/%3E%3Cpath d='M9 21v-6h6v6'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    @{
        var gaId = (ViewData["GA4Id"] as string) ?? (HttpContextAccessor.HttpContext?.RequestServices.GetService<IConfiguration>()?["Analytics:GA4MeasurementId"]);
    }
    @if (!string.IsNullOrWhiteSpace(gaId))
    {
      <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
      <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','@gaId');</script>
    }
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F59E0B" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="804 Avenue" />
    <!-- Bootstrap 5 — layout & utilities -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <!-- Tom Select — polished selects (pairs with Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" crossorigin="anonymous" />
    <!-- Flatpickr — date picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/assets/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/forms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/services.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/rtl.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/ui-modern.css" asp-append-version="true" />
    <!-- Form/card styles (legacy Bulma class names — no Bulma core required) -->
    <link rel="stylesheet" href="~/assets/css/bulma-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/bootstrap-avenue.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/ui-dropdown.css" asp-append-version="true" />
    <!-- Property card styles — used on home, listings, detail, dashboard, etc. -->
    <link rel="stylesheet" href="~/css/properties.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
    <!-- Organization JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "@brand",
      "url": "@($"{HttpContextAccessor.HttpContext?.Request.Scheme}://{HttpContextAccessor.HttpContext?.Request.Host}")",
      "logo": "@ogImage",
      "description": "@meta",
      "address": { "@@type": "PostalAddress", "addressLocality": "Abu Dhabi", "addressCountry": "AE" },
      "contactPoint": { "@@type": "ContactPoint", "telephone": "@(site?.PhoneE164 ?? "+971504399804")", "contactType": "customer service" }
    }
    </script>
    <style>
            .site-toast{position:fixed;top:88px;left:50%;transform:translateX(-50%);z-index:2100;padding:14px 22px;border-radius:var(--radius-sm,10px);max-width:min(520px,92vw);font-size:.88rem;line-height:1.5;box-shadow:0 12px 40px rgba(15,23,42,.12);animation:toastIn .35s ease}
            .site-toast.ok{background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.4);color:var(--success,#10B981)}
            .site-toast.err{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);color:var(--danger,#EF4444)}
            @@keyframes toastIn{from{opacity:0;transform:translateX(-50%) translateY(-12px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
    </style>
</head>
<body class="enhance-dd @(ViewData["BodyClass"] as string ?? "")">
    <partial name="_PublicNav" />
    @if (TempData["ToastOk"] is string tok && !string.IsNullOrWhiteSpace(tok))
    {
        <div class="site-toast ok" role="status">@tok</div>
    }
    @if (TempData["ToastError"] is string terr && !string.IsNullOrWhiteSpace(terr))
    {
        <div class="site-toast err" role="alert">@terr</div>
    }
    @RenderBody()
    <partial name="_PublicFooter" />
    <partial name="_PublicModals" />
    @if (FF(FeatureFlags.WhatsAppFloat))
    {
        <a href="@(site?.WhatsAppHref ?? "https://wa.me/971504399804")" target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="WhatsApp"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg></a>
    }
    <button class="back-to-top" id="backToTop" type="button" aria-label="Back to top"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6" /></svg></button>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" crossorigin="anonymous"></script>
    <script src="~/assets/js/shared.js" asp-append-version="true"></script>
    <script src="~/assets/js/tom-select-init.js" asp-append-version="true"></script>
    <script src="~/assets/js/autocomplete.js" asp-append-version="true"></script>
    <!-- Flatpickr — auto-initialised on all date inputs -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr" defer></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof flatpickr === 'undefined') return;
      var dateOpts = {
        dateFormat: 'Y-m-d',
        disableMobile: false,
        allowInput: true,
        static: false,
        animate: true
      };
      // Standard date inputs
      document.querySelectorAll('input[type="date"]:not(.flatpickr-input)').forEach(function(el) {
        flatpickr(el, Object.assign({}, dateOpts));
      });
      // Range sliders — update gradient fill dynamically
      document.querySelectorAll('input[type="range"]').forEach(function(r) {
        function syncRange() {
          var min = parseFloat(r.min) || 0;
          var max = parseFloat(r.max) || 100;
          var val = parseFloat(r.value) || 0;
          var pct = ((val - min) / (max - min) * 100).toFixed(1) + '%';
          r.style.setProperty('--range-pct', pct);
        }
        syncRange();
        r.addEventListener('input', syncRange);
      });
    });
    </script>
    <script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.getRegistrations().then(function(regs) {
    regs.forEach(function(r) { r.unregister(); });
  });
  caches.keys().then(function(keys) {
    keys.forEach(function(k) { caches.delete(k); });
  });
}
</script>
    @await RenderSectionAsync("Scripts", required: false)
    @{
        var tawkProp = HttpContextAccessor.HttpContext?.RequestServices.GetService<IConfiguration>()?["LiveChat:TawktoPropertyId"];
        var tawkWidget = HttpContextAccessor.HttpContext?.RequestServices.GetService<IConfiguration>()?["LiveChat:TawktoWidgetId"];
    }
    @if (!string.IsNullOrWhiteSpace(tawkProp) && !string.IsNullOrWhiteSpace(tawkWidget))
    {
      <script>
      var Tawk_API = Tawk_API||{}, Tawk_LoadStart = new Date();
      (function(){
        var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
        s1.async=true;
        s1.src='https://embed.tawk.to/@tawkProp/@tawkWidget';
        s1.charset='UTF-8';
        s1.setAttribute('crossorigin','*');
        s0.parentNode.insertBefore(s1,s0);
      })();
      </script>
    }
    <!-- Cookie consent -->
    <div id="cookieBanner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:3000;background:var(--bg-card);border-top:1px solid var(--border-accent);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;box-shadow:0 -8px 32px rgba(15,23,42,.1)">
      <p style="font-size:.8rem;color:var(--text-secondary);margin:0;max-width:680px">We use cookies to improve your experience and analyse site traffic. By continuing, you agree to our <a asp-page="/Privacy" style="color:var(--accent)">Privacy Policy</a>.</p>
      <div style="display:flex;gap:10px;flex-shrink:0">
        <button onclick="acceptCookies()" class="btn-primary" style="padding:9px 20px;font-size:.72rem"><span>Accept</span></button>
        <button onclick="document.getElementById('cookieBanner').style.display='none'" class="btn-outline" style="padding:9px 20px;font-size:.72rem">Decline</button>
      </div>
    </div>
    <script>
    (function() {
      if (!localStorage.getItem('804-cookie-consent')) {
        var b = document.getElementById('cookieBanner');
        if (b) b.style.display = 'flex';
      }
    })();
    function acceptCookies() {
      localStorage.setItem('804-cookie-consent', 'true');
      document.getElementById('cookieBanner').style.display = 'none';
    }
    </script>
</body>
</html>
