@model Avenue804.Web.Domain.PropertyListing
<a asp-page="/Properties/Detail" asp-route-slug="@Model.Slug" class="prop-card fade-up" style="text-decoration:none;color:inherit;display:block">
  <div class="prop-card-img">
    <img src="@ListingFormat.ListingImageUrl(Model.MainImageUrl)" alt="@Model.Title" loading="lazy" />
    @if (Model.OfferType == ListingOfferType.Sale)
    {
      <span class="prop-badge badge-sale">For sale</span>
    }
    else
    {
      <span class="prop-badge badge-rent">For rent</span>
    }
  </div>
  <div class="prop-card-body">
    <div class="prop-price">
      @ListingFormat.PricePrimary(Model.Price, Model.Currency, Model.OfferType)
      @if (ListingFormat.ShowRentSuffix(Model.OfferType))
      {
        <small>/yr</small>
      }
    </div>
    <div class="prop-name">@Model.Title</div>
    <div class="prop-loc">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      @(string.IsNullOrWhiteSpace(Model.Location) ? "Abu Dhabi, UAE" : Model.Location)
    </div>
    <div class="prop-meta">
      @if (Model.Beds is int beds)
      {
        <span class="prop-meta-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v11a1 1 0 001 1h16a1 1 0 001-1V7"/><path d="M2 7h20l-2-4H4z"/></svg>@beds Beds</span>
      }
      @if (Model.Baths is int baths)
      {
        <span class="prop-meta-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16a1 1 0 011 1v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4a1 1 0 011-1z"/><path d="M6 12V5a2 2 0 012-2h3a2 2 0 012 2v7"/></svg>@baths Baths</span>
      }
      @if (Model.AreaSqft is int sq)
      {
        <span class="prop-meta-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>@sq.ToString("N0") sqft</span>
      }
    </div>
  </div>
</a>
