@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Domain
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var waNum = site?.WhatsAppDigits ?? "971504399804";
}

<!-- ═══ INSTANT QUOTE CALCULATOR ═══ -->
<section class="quote-section" id="get-quote">
  <div class="container">
    <div class="section-tag fade-up" style="justify-content:center">Free Estimate</div>
    <h2 class="section-title fade-up" style="text-align:center;max-width:640px;margin:0 auto 12px">Get an Instant <em>Project Estimate</em></h2>
    <p class="section-sub fade-up" style="text-align:center;margin:0 auto">Enter your project details and get a ballpark AED estimate in seconds — no commitment required.</p>

    <div class="quote-grid">
      <!-- Calculator form -->
      <div class="quote-card">
        <div class="quote-card-head">
          <h3>Project Estimate Calculator</h3>
          <p>Fill in your project details to get a cost range.</p>
        </div>
        <form class="quote-form" method="post" asp-page="/Submit/ServiceQuote" id="quoteForm">
          <input type="hidden" name="returnPage" value="/Contracting#get-quote" />

          <div class="quote-field">
            <label>Service type <span style="color:var(--accent)">*</span></label>
            <select name="serviceType" id="qServiceType" required onchange="calcQuote()">
              <option value="">Select service…</option>
              <option value="@((int)ServiceType.FitOutRenovation)">Interior Fit-Out &amp; Renovation</option>
              <option value="@((int)ServiceType.CivilContracting)">Civil &amp; General Contracting</option>
              <option value="@((int)ServiceType.GypsumCeiling)">Gypsum &amp; Ceiling Works</option>
              <option value="@((int)ServiceType.GlassAluminum)">Glass &amp; Aluminum Works</option>
              <option value="@((int)ServiceType.PaintingFinishing)">Painting &amp; Finishing</option>
              <option value="@((int)ServiceType.Flooring)">Premium Flooring</option>
              <option value="@((int)ServiceType.Signage)">Internal &amp; External Signage</option>
              <option value="@((int)ServiceType.BundlePackage)">Full Fit-Out Bundle (All works)</option>
            </select>
          </div>

          <div class="quote-grid-2">
            <div class="quote-field">
              <label>Area (sqm) <span style="color:var(--accent)">*</span></label>
              <input type="number" name="areaSqm" id="qArea" min="1" max="50000" placeholder="e.g. 200" required oninput="calcQuote()" />
            </div>
            <div class="quote-field">
              <label>Property type</label>
              <select id="qPropType" onchange="calcQuote()">
                <option value="residential">Residential</option>
                <option value="commercial">Commercial / Office</option>
                <option value="retail">Retail / Showroom</option>
                <option value="industrial">Industrial / Warehouse</option>
              </select>
            </div>
          </div>

          <!-- Live estimate box -->
          <div class="quote-estimate" id="quoteEstimate">
            <div class="quote-estimate-label">Estimated project cost</div>
            <div class="quote-estimate-range" id="quoteRange">AED —</div>
            <div class="quote-estimate-note">Indicative range only. Actual cost depends on materials, finishes, and site conditions. Request a formal quote for accuracy.</div>
          </div>
          <input type="hidden" name="estimateRange" id="qEstimateHidden" />

          <div class="quote-field">
            <label>Your name <span style="color:var(--accent)">*</span></label>
            <input type="text" name="name" required autocomplete="name" placeholder="Ahmed Al Mansoori" maxlength="200" />
          </div>
          <div class="quote-grid-2">
            <div class="quote-field">
              <label>Mobile <span style="color:var(--accent)">*</span></label>
              <input type="tel" name="phone" required inputmode="tel" placeholder="+971 50 000 0000" maxlength="50" />
            </div>
            <div class="quote-field">
              <label>Email <span style="color:var(--accent)">*</span></label>
              <input type="email" name="email" required placeholder="you@example.com" maxlength="256" />
            </div>
          </div>
          <div class="quote-grid-2">
            <div class="quote-field">
              <label>Company (optional)</label>
              <input type="text" name="company" placeholder="Your company" maxlength="200" />
            </div>
            <div class="quote-field">
              <label>Location / emirate</label>
              <input type="text" name="location" placeholder="e.g. Al Reem Island, Abu Dhabi" maxlength="400" />
            </div>
          </div>
          <div class="quote-field">
            <label>Preferred timeline</label>
            <select name="timeline">
              <option value="">Flexible</option>
              <option value="ASAP">As soon as possible</option>
              <option value="1 month">Within 1 month</option>
              <option value="3 months">Within 3 months</option>
              <option value="6 months">Within 6 months</option>
            </select>
          </div>
          <div class="quote-field">
            <label>Brief project description</label>
            <textarea name="projectDescription" rows="2" placeholder="Tell us more about your project, special requirements, materials preference…" maxlength="4000"></textarea>
          </div>
          <button type="submit" class="btn-primary" style="width:100%;justify-content:center;padding:15px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9z"/></svg>
            <span>Request Formal Quote</span>
          </button>
          <p style="font-size:.72rem;color:var(--text-tertiary);text-align:center;margin-top:10px">Free, no-obligation. Our team will visit your site and provide a detailed breakdown.</p>
        </form>
      </div>

      <!-- Info panels -->
      <div class="quote-info">
        <div class="quote-info-card">
          <div class="quote-info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h4>What's included in the quote?</h4>
          <p>Our detailed quotes include material costs, labour, project management fees, authority permit fees (if applicable), and a proposed project schedule with milestones.</p>
        </div>
        <div class="quote-info-card">
          <div class="quote-info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h4>How long does it take?</h4>
          <p>Site visit within <strong>24–48 hours</strong> of your request. Formal quote delivered within <strong>3–5 business days</strong> after the site visit and scope confirmation.</p>
        </div>
        <div class="quote-info-card">
          <div class="quote-info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          </div>
          <h4>No hidden charges</h4>
          <p>We use a transparent, itemised pricing format. Any variation to scope is agreed in writing before proceeding — no surprise bills at handover.</p>
        </div>
        <div class="quote-info-card" style="background:linear-gradient(135deg,var(--accent-15),var(--accent-10));border-color:var(--border-accent)">
          <div class="quote-info-icon" style="background:var(--accent);color:#fff">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
          </div>
          <h4>Prefer to chat on WhatsApp?</h4>
          <p style="margin-bottom:12px">Send us your project details and photos directly — our team responds within 2 hours.</p>
          <a href="https://wa.me/@waNum?text=Hi%2C+I'd+like+a+contracting+quote" target="_blank" rel="noopener" class="btn-primary" style="display:inline-flex;padding:10px 20px;font-size:.7rem"><span>Chat on WhatsApp</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

