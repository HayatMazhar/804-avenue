@section Scripts {
<script>
// Quote calculator — AED per sqm rates by service + property type modifier
var _rates = {
  '@((int)ServiceType.FitOutRenovation)':    { residential: [220, 420], commercial: [280, 550], retail: [300, 600], industrial: [180, 350] },
  '@((int)ServiceType.CivilContracting)':    { residential: [350, 700], commercial: [450, 900], retail: [400, 800], industrial: [280, 550] },
  '@((int)ServiceType.GypsumCeiling)':       { residential: [80,  160], commercial: [90,  180], retail: [100, 200], industrial: [70,  140] },
  '@((int)ServiceType.GlassAluminum)':       { residential: [220, 450], commercial: [300, 600], retail: [280, 550], industrial: [180, 380] },
  '@((int)ServiceType.PaintingFinishing)':   { residential: [35,  80],  commercial: [45,  95],  retail: [50,  100], industrial: [28,  60]  },
  '@((int)ServiceType.Flooring)':            { residential: [120, 280], commercial: [150, 320], retail: [180, 400], industrial: [90,  200] },
  '@((int)ServiceType.Signage)':             { residential: [null, null], commercial: [150, 350], retail: [200, 500], industrial: [120, 280] },
  '@((int)ServiceType.BundlePackage)':       { residential: [380, 700], commercial: [500, 950], retail: [520, 1000], industrial: [350, 650] }
};

function calcQuote() {
  var svc   = document.getElementById('qServiceType').value;
  var area  = parseFloat(document.getElementById('qArea').value) || 0;
  var ptype = document.getElementById('qPropType').value;
  var box   = document.getElementById('quoteEstimate');
  var range = document.getElementById('quoteRange');
  var hidden = document.getElementById('qEstimateHidden');

  if (!svc || area <= 0 || !_rates[svc]) { box.classList.remove('show'); return; }

  var r = _rates[svc][ptype] || _rates[svc]['commercial'];
  if (!r[0]) { range.textContent = 'Varies — request a site visit'; box.classList.add('show'); return; }

  var lo = Math.round(area * r[0] / 1000) * 1000;
  var hi = Math.round(area * r[1] / 1000) * 1000;
  var txt = 'AED ' + lo.toLocaleString() + ' – ' + hi.toLocaleString();
  range.textContent = txt;
  hidden.value = txt;
  box.classList.add('show');
}
</script>
}
