@model Avenue804.Web.Models.Public.ServicePageHeroModel
@using Avenue804.Web.Configuration
@inject Avenue804.Web.Services.ICmsTextProvider Cms
<!-- ═══ HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb fade-up"><a asp-page="/Index">Home</a><span class="sep">/</span><span>@Cms[ContentBlockSlugs.AboutCrumb, "About"]</span></div>
    <h1 class="page-hero-title fade-up">
      @if (string.IsNullOrEmpty(Model.HeroTitleHtml)) { <text>About <em>804 Avenue</em></text> }
      else { @Html.Raw(Model.HeroTitleHtml) }
    </h1>
    <p class="page-hero-sub fade-up">
      @if (string.IsNullOrEmpty(Model.HeroSubtitleHtml)) { <text>Building trust, delivering excellence, and shaping the future of real estate and construction across the UAE.</text> }
      else { @Html.Raw(Model.HeroSubtitleHtml) }
    </p>
  </div>
</section>

<!-- ═══ CEO MESSAGE ═══ -->
<style>
  .ceo-section { background:#fff; }
  .ceo-grid { display:grid; grid-template-columns:1fr; gap:40px; align-items:center; }
  @@media (min-width:900px){ .ceo-grid{ grid-template-columns:0.85fr 1.15fr; gap:56px; } }
  .ceo-photo { position:relative; }
  .ceo-photo img { width:100%; height:100%; max-height:520px; object-fit:cover; border-radius:18px; box-shadow:0 24px 60px -18px rgba(8,15,35,.4); }
  .ceo-message { font-size:1.05rem; line-height:1.75; color:var(--text-secondary,#475569); margin:18px 0 24px; }
  .ceo-message p { margin:0 0 14px; }
  .ceo-signoff { display:flex; flex-direction:column; gap:2px; border-top:1px solid #e5e7eb; padding-top:18px; }
  .ceo-signoff strong { font-size:1.05rem; color:var(--text-primary,#0f172a); }
  .ceo-signoff span { font-size:.85rem; color:var(--accent,#c9a04f); font-weight:600; }
</style>
<section class="ceo-section section-pad">
  <div class="container">
    <div class="ceo-grid">
      <div class="ceo-photo fade-up">
        <img src="@Cms[ContentBlockSlugs.AboutCeoPhoto, "https://images.unsplash.com/photo-1560250097-0b93528c311a?w=700&q=80&auto=format&fit=crop"]"
             alt="@Cms[ContentBlockSlugs.AboutCeoName, "804 Avenue CEO"]" loading="lazy" decoding="async" />
      </div>
      <div class="ceo-content">
        <span class="section-tag fade-up">@Cms[ContentBlockSlugs.AboutCeoTag, "Message from the CEO"]</span>
        <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutCeoTitle, "A word from our <em>leadership</em>"])</h2>
        <div class="ceo-message fade-up">
          @Html.Raw(Cms[ContentBlockSlugs.AboutCeoMessage,
            "<p>At 804 Avenue, we built this company on a simple belief: that real estate, construction, and property maintenance should be delivered with honesty, craftsmanship, and genuine care for every client.</p>" +
            "<p>From a single office in Abu Dhabi to a trusted partner across the UAE, our growth has been driven by the relationships we've earned — one project, one home, and one satisfied client at a time.</p>" +
            "<p>As we look ahead, our commitment remains unchanged: to deliver excellence and trust in everything we do. Thank you for being part of our journey.</p>"])
        </div>
        <div class="ceo-signoff fade-up">
          <strong>@Cms[ContentBlockSlugs.AboutCeoName, "The 804 Avenue Leadership"]</strong>
          <span>@Cms[ContentBlockSlugs.AboutCeoRole, "Chief Executive Officer, 804 Avenue"]</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ OUR STORY ═══ -->
<section class="story-section section-pad">
  <div class="container">
    <div class="story-grid">
      <div>
        <span class="section-tag fade-up">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutStoryTag, "Our Story"))</span>
        <h2 class="section-title fade-up">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutStoryTitle, "A Legacy of <em>Excellence</em>"))</h2>
        <div class="story-text fade-up">
          @if (Model.Get(ContentBlockSlugs.AboutStoryBody) is string storyBody)
          { @Html.Raw(storyBody) }
          else
          {
            <p>804 Avenue Properties and Contracting was founded with a clear vision: to become Abu Dhabi's most trusted and integrated partner for real estate, construction, and property maintenance services.</p>
            <p>Headquartered in the heart of Abu Dhabi at Al Ghaith Tower, we combine deep market knowledge with skilled craftsmanship to deliver exceptional results for every client — from individual homeowners to large-scale commercial enterprises.</p>
            <p>Over the years, we have built a reputation for professionalism, quality, and reliability. Our team of licensed engineers, certified technicians, and experienced consultants work together seamlessly to provide end-to-end solutions across the property lifecycle.</p>
            <p>Whether you're buying your dream home, building a new office, or maintaining a residential tower — 804 Avenue is your single point of contact for everything property.</p>
          }
        </div>
      </div>
      <div class="story-img fade-up">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&q=80" alt="804 Avenue office building">
      </div>
    </div>
  </div>
</section>

<!-- ═══ VISION & MISSION ═══ -->
<section class="vm-section section-pad">
  <div class="container" style="text-align:center">
    <span class="section-tag fade-up" style="justify-content:center">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutVmTag, "Our Purpose"))</span>
    <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutVmTitle, "Vision &amp; <em>Mission</em>"])</h2>
    <div class="vm-grid">
      <div class="vm-card fade-up">
        <div class="vm-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>@Cms[ContentBlockSlugs.AboutVisionH3, "Our Vision"]</h3>
        <p>@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutVisionBody, "To be the most trusted and innovative real estate and contracting company in the UAE — recognized for excellence in every property transaction, construction project, and maintenance service we deliver."))</p>
      </div>
      <div class="vm-card fade-up">
        <div class="vm-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 000 20 14.5 14.5 0 000-20"/><path d="M2 12h20"/></svg></div>
        <h3>@Cms[ContentBlockSlugs.AboutMissionH3, "Our Mission"]</h3>
        <p>@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutMissionBody, "To deliver exceptional quality in every property transaction, construction project, and maintenance service — by combining deep expertise, premium materials, and an unwavering commitment to client satisfaction."))</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CORE VALUES ═══ -->
<section class="values-section section-pad">
  <div class="container">
    <span class="section-tag fade-up">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutValuesTag, "Our Principles"))</span>
    <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutValuesTitle, "Core <em>Values</em>"])</h2>
    <div class="values-list">
      @if (Model.Get(ContentBlockSlugs.AboutValuesItems) is string valItems)
      { @Html.Raw(valItems) }
      else
      {
        <div class="value-item fade-up"><div class="value-num">01</div><div><h4>Integrity</h4><p>We operate with complete transparency and honesty in every interaction — building trust through actions, not just words.</p></div></div>
        <div class="value-item fade-up"><div class="value-num">02</div><div><h4>Professionalism</h4><p>Every team member upholds the highest standards of conduct, communication, and workmanship in all that we do.</p></div></div>
        <div class="value-item fade-up"><div class="value-num">03</div><div><h4>Quality</h4><p>We never compromise on materials, processes, or outcomes. Quality is embedded in every phase of our work.</p></div></div>
        <div class="value-item fade-up"><div class="value-num">04</div><div><h4>Innovation</h4><p>We embrace modern methods, technologies, and design thinking to deliver smarter, faster, and better solutions.</p></div></div>
        <div class="value-item fade-up"><div class="value-num">05</div><div><h4>Client Satisfaction</h4><p>Our clients are at the center of everything we do. We measure our success by the satisfaction and loyalty of those we serve.</p></div></div>
      }
    </div>
  </div>
</section>

<!-- ═══ OUR EXPERTISE ═══ -->
<section class="expertise-section section-pad">
  <div class="container">
    <span class="section-tag fade-up">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutExpertiseTag, "Capabilities"))</span>
    <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutExpertiseTitle, "Our <em>Expertise</em>"])</h2>
    <p class="section-sub fade-up">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutExpertiseLead, "Across three integrated divisions, we bring deep domain knowledge and hands-on experience to every engagement."))</p>
    <div class="expertise-list">
      @if (Model.Get(ContentBlockSlugs.AboutExpertiseItems) is string expertItems)
      { @Html.Raw(expertItems) }
      else
      {
        <div class="expertise-item fade-up"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span><strong style="color:var(--text-primary)">Real Estate Brokerage &amp; Advisory</strong> — Buying, selling, leasing, and investment advisory for residential, commercial, and off-plan properties across Abu Dhabi and Dubai.</span></div>
        <div class="expertise-item fade-up"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span><strong style="color:var(--text-primary)">Construction &amp; Contracting</strong> — Civil works, gypsum, glass &amp; aluminum, painting, flooring, interior fit-out, renovation, and signage — from concept to handover.</span></div>
        <div class="expertise-item fade-up"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span><strong style="color:var(--text-primary)">Property Maintenance</strong> — General building, civil, MEP, preventive, and corrective maintenance services with 24/7 emergency support.</span></div>
        <div class="expertise-item fade-up"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span><strong style="color:var(--text-primary)">Project Management</strong> — End-to-end project coordination with dedicated site engineers, safety officers, and quality controllers on every project.</span></div>
        <div class="expertise-item fade-up"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span><strong style="color:var(--text-primary)">Design &amp; Consultation</strong> — Space planning, material selection, MEP coordination, and authority approval support for all project types.</span></div>
      }
    </div>
  </div>
</section>

<!-- ═══ STATS ═══ -->
<section class="stats-bar" id="statsSection">
  <div class="container">
    <div class="stats-grid">
      @if (Model.Get(ContentBlockSlugs.AboutStatsItems) is string aboutStatsItems)
      { @Html.Raw(aboutStatsItems) }
      else
      {
        <div class="fade-up"><div class="stat-num" data-count="500" data-suffix="+">0</div><div class="stat-label">@Cms[ContentBlockSlugs.HomeStatsLabelListings, "Properties Listed"]</div></div>
        <div class="fade-up"><div class="stat-num" data-count="120" data-suffix="+">0</div><div class="stat-label">@Cms[ContentBlockSlugs.HomeStatsLabelProjects, "Projects Delivered"]</div></div>
        <div class="fade-up"><div class="stat-num" data-count="15" data-suffix="+">0</div><div class="stat-label">@Cms[ContentBlockSlugs.HomeStatsLabelYears, "Years Experience"]</div></div>
        <div class="fade-up"><div class="stat-num" data-count="98" data-suffix="%">0</div><div class="stat-label">Client Satisfaction</div></div>
      }
    </div>
  </div>
</section>

@* ═══ TEAM ═══ — hidden for initial launch (replaced by CEO Message section above). Re-enable when real team profiles are ready. *@
@if (false)
{
<!-- ═══ TEAM ═══ -->
<section class="team-section section-pad">
  <div class="container" style="text-align:center">
    <span class="section-tag fade-up" style="justify-content:center">@Cms[ContentBlockSlugs.AboutTeamTag, "Our People"]</span>
    <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutTeamTitle, "Meet the <em>Team</em>"])</h2>
    <p class="section-sub fade-up" style="margin:0 auto 16px">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutTeamLead, "The people behind every successful project, transaction, and client relationship at 804 Avenue."))</p>
    <div class="team-grid">
      @if (Model.Get(ContentBlockSlugs.AboutTeamItems) is string teamItems)
      { @Html.Raw(teamItems) }
      else
      {
        <div class="team-card fade-up"><div class="team-avatar"><span class="team-initials">AA</span></div><h4>Ahmed Al Mansoori</h4><p>Managing Director</p><span class="team-desc">Leads the company's strategic direction with over 18 years of experience in UAE real estate and construction.</span></div>
        <div class="team-card fade-up"><div class="team-avatar"><span class="team-initials">MZ</span></div><h4>Mohammed Al Zaabi</h4><p>Head of Contracting</p><span class="team-desc">Oversees all construction and fit-out projects, ensuring quality delivery and client satisfaction on every site.</span></div>
        <div class="team-card fade-up"><div class="team-avatar"><span class="team-initials">SH</span></div><h4>Sara Al Hashimi</h4><p>Real Estate Director</p><span class="team-desc">Manages the property division with deep knowledge of Abu Dhabi and Dubai's residential and commercial markets.</span></div>
        <div class="team-card fade-up"><div class="team-avatar"><span class="team-initials">KN</span></div><h4>Khalid Al Nuaimi</h4><p>Maintenance Manager</p><span class="team-desc">Leads the maintenance team with a focus on preventive care, rapid response, and long-term asset protection.</span></div>
      }
    </div>
  </div>
</section>

}

<!-- ═══ WHY CHOOSE US ═══ -->
<section class="wcu-section section-pad">
  <div class="container" style="text-align:center">
    <span class="section-tag fade-up" style="justify-content:center">@Html.Raw(Model.GetOr(ContentBlockSlugs.AboutWcuTag, "Why 804 Avenue"))</span>
    <h2 class="section-title fade-up">@Html.Raw(Cms[ContentBlockSlugs.AboutWcuTitle, "Why <em>Choose</em> Us"])</h2>
    <div class="wcu-grid">
      @if (Model.Get(ContentBlockSlugs.AboutWcuItems) is string wcuItems)
      { @Html.Raw(wcuItems) }
      else
      {
        <div class="wcu-item fade-up"><div class="wcu-num">01</div><h4>All-in-One Provider</h4><p>Real estate, contracting, and maintenance — all under one roof for seamless service.</p></div>
        <div class="wcu-item fade-up"><div class="wcu-num">02</div><h4>Licensed &amp; Certified</h4><p>Fully licensed engineers, certified technicians, and accredited consultants on every project.</p></div>
        <div class="wcu-item fade-up"><div class="wcu-num">03</div><h4>On-Time Delivery</h4><p>Structured project management and milestone tracking ensure we deliver on schedule.</p></div>
        <div class="wcu-item fade-up"><div class="wcu-num">04</div><h4>Transparent Pricing</h4><p>No hidden fees — detailed cost breakdowns and clear payment milestones from day one.</p></div>
        <div class="wcu-item fade-up"><div class="wcu-num">05</div><h4>Client-First Approach</h4><p>Responsive support before, during, and after every project — your satisfaction is our priority.</p></div>
      }
    </div>
  </div>
</section>
