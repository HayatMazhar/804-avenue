    <div class="ph-cta__inner fade-up">
      <div class="ph-cta__text">
        <h2 class="ph-cta__title">@Html.Raw(Txt(ContentBlockSlugs.HomeCtaTitle, "Ready to build, renovate or maintain?"))</h2>
        <p class="ph-cta__sub">Call us today — contracting, maintenance &amp; FM under one roof.</p>
        <a href="@(site?.TelHref ?? "tel:+971504399804")" class="ph-cta__phone">
          @(site?.PhoneDisplay ?? "+971 50 43 99 804")
        </a>
      </div>
      <div class="ph-cta__btns">
        <a asp-page="/Submit/ServiceQuote" class="ph-btn ph-btn--white">Get a Free Quote</a>
        <a asp-page="/Services/Index" class="ph-btn ph-btn--outline-white">All Services</a>
      </div>
    </div>
  </div>
</section>
