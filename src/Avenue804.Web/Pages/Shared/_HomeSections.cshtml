@model Avenue804.Web.Pages.IndexModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Configuration
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var B = Model.Blocks;
    string Txt(string slug, string fallback) => B.TryGetValue(slug, out var v) ? v : fallback;
}

<!-- ══════════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
<section class="ph-hero" id="hero">
  <div class="ph-hero__bg">
    <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1800&q=80" alt="Construction and contracting in Abu Dhabi" />
  </div>
  <div class="ph-hero__overlay"></div>
  <div class="ph-hero__content">
    <p class="ph-hero__eyebrow">Abu Dhabi's Trusted Contracting &amp; Property Firm</p>
    <h1 class="ph-hero__title">Build. <span class="ph-hero__hl">Maintain.</span><br>Manage.</h1>
    <p class="ph-hero__sub">Contracting, maintenance &amp; facility management — plus real estate brokerage — all under one roof across the UAE.</p>
    <div class="ph-hero__ctas">
      <a asp-page="/Contact" class="ph-btn ph-btn--primary">Get a Free Quote</a>
      <a asp-page="/Properties" class="ph-btn ph-btn--outline-white">Browse Properties</a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     STATS BAR
══════════════════════════════════════════════ -->
<section class="ph-stats">
  <div class="container">
    <div class="ph-stats__grid">
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="120" data-suffix="+">0</div>
        <div class="ph-stats__label">Projects Delivered</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="15" data-suffix="+">0</div>
        <div class="ph-stats__label">Years Experience</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="98" data-suffix="%">0</div>
        <div class="ph-stats__label">Client Satisfaction</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="500" data-suffix="+">0</div>
        <div class="ph-stats__label">Properties Listed</div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     OUR SERVICES — core business (first section)
══════════════════════════════════════════════ -->
<section class="section-pad section-bg-white">
  <div class="container">
    <p class="ph-tag ph-tag--center fade-up">What We Do</p>
    <h2 class="ph-title ph-title--center fade-up mb-4">Contracting. Maintenance. <em>Facility Management.</em></h2>
    <div class="ph-services__grid">

      <!-- Contracting -->
      <a class="ph-service-card fade-up" asp-page="/Contracting">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="ph-service-card__title">Contracting</h3>
          <p class="ph-service-card__sub">Civil works, interior fit-out, gypsum, flooring, glass &amp; aluminum, signage — end-to-end project delivery.</p>
          <ul class="ph-service-card__list">
            <li>Civil &amp; general contracting</li>
            <li>Interior fit-out &amp; renovation</li>
            <li>Gypsum &amp; ceiling works</li>
            <li>Flooring, painting &amp; finishing</li>
            <li>Glass, aluminum &amp; signage</li>
          </ul>
          <span class="ph-service-card__cta">Learn more →</span>
        </div>
      </a>

      <!-- Maintenance -->
      <a class="ph-service-card fade-up" asp-page="/Maintenance">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          </div>
          <h3 class="ph-service-card__title">Maintenance</h3>
          <p class="ph-service-card__sub">Preventive, corrective and MEP maintenance — keeping your property in peak condition year-round.</p>
          <ul class="ph-service-card__list">
            <li>MEP (mechanical, electrical, plumbing)</li>
            <li>Preventive maintenance contracts</li>
            <li>Corrective &amp; emergency repairs</li>
            <li>General building maintenance</li>
            <li>Civil maintenance works</li>
          </ul>
          <span class="ph-service-card__cta">Learn more →</span>
        </div>
      </a>

      <!-- Facility Management -->
      <a class="ph-service-card fade-up" asp-page="/FacilityManagement">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><path d="M14 7h1M14 11h1M9 7h1M9 11h1"/></svg>
          </div>
          <h3 class="ph-service-card__title">Facility Management</h3>
          <p class="ph-service-card__sub">Complete facility management for buildings, compounds and commercial complexes across the UAE.</p>
          <ul class="ph-service-card__list">
            <li>Building operations management</li>
            <li>Shared services coordination</li>
            <li>Vendor &amp; contractor management</li>
            <li>Health, safety &amp; compliance</li>
            <li>AMC (annual maintenance contracts)</li>
          </ul>
          <span class="ph-service-card__cta">Learn more →</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     ABOUT 804 AVENUE
══════════════════════════════════════════════ -->
<section class="section-pad" style="background:#fff">
  <div class="container">
    <div class="ph-about__grid">
      <div class="ph-about__img fade-up">
        <img src="https://images.unsplash.com/photo-1560179707-f14e90ef3623?w=900&q=80" alt="804 Avenue office" />
        <div class="ph-about__img-card fade-up">
          <div class="ph-about__img-num">15+</div>
          <div class="ph-about__img-label">Years serving the UAE</div>
        </div>
      </div>
      <div class="ph-about__content">
        <p class="ph-tag fade-up">About 804 Avenue</p>
        <h2 class="ph-title fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeAboutTitle, "Your trusted partner in <em>property &amp; construction</em>"))</h2>
        <p class="ph-about__text fade-up">
          @Html.Raw(Txt(ContentBlockSlugs.AboutStripLead,
            "804 Avenue Properties and Contracting is a dynamic company offering professional services in real estate, construction and property maintenance across the UAE. Headquartered in Abu Dhabi, we combine deep market knowledge with skilled craftsmanship to deliver exceptional results for every client."))
        </p>
        <div class="ph-about__points fade-up">
          <div class="ph-about__point">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Licensed &amp; certified engineers and technicians
          </div>
          <div class="ph-about__point">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Real estate, contracting &amp; maintenance under one roof
          </div>
          <div class="ph-about__point">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Transparent pricing — no hidden fees
          </div>
          <div class="ph-about__point">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            On-time delivery with structured project management
          </div>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
          <a asp-page="/About" class="ph-btn ph-btn--primary">About Us</a>
          <a asp-page="/Contact" class="ph-btn ph-btn--outline">Get a Quote</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FEATURED PROPERTIES (secondary — shown after services & about)
══════════════════════════════════════════════ -->
<section class="section-pad" style="background:#f9fafb">
  <div class="container">
    <div class="ph-projects__head">
      <div>
        <p class="ph-tag fade-up">Real Estate</p>
        <h2 class="ph-title fade-up">Featured <em>Properties</em></h2>
      </div>
      <a class="ph-link-all" asp-page="/Properties">Browse all →</a>
    </div>
    <div class="ph-feat-grid">
      @if (Model.FeaturedListings.Count > 0)
      {
        foreach (var p in Model.FeaturedListings)
        {
          <partial name="Shared/_PropertyCard" model="p" />
        }
      }
      else
      {
        <div class="pcard fade-up">
          <div class="pcard__img">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80" alt="Luxury Apartment" />
            <span class="pcard__badge pcard__badge--sale">For Sale</span>
          </div>
          <div class="pcard__body">
            <div class="pcard__price">AED 1,200,000</div>
            <div class="pcard__title">Luxury 2BR Apartment</div>
            <div class="pcard__loc"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Al Reem Island, Abu Dhabi</div>
            <div class="pcard__meta"><span class="pcard__meta-item">2 Beds</span><span class="pcard__meta-item">2 Baths</span><span class="pcard__meta-item">1,250 sqft</span></div>
          </div>
        </div>
        <div class="pcard fade-up">
          <div class="pcard__img">
            <img src="https://images.unsplash.com/photo-1613977257363-707ba9348227?w=800&q=80" alt="Modern Villa" />
            <span class="pcard__badge pcard__badge--rent">For Rent</span>
          </div>
          <div class="pcard__body">
            <div class="pcard__price">AED 180,000 <small>/yr</small></div>
            <div class="pcard__title">Modern 4BR Villa</div>
            <div class="pcard__loc"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Khalifa City, Abu Dhabi</div>
            <div class="pcard__meta"><span class="pcard__meta-item">4 Beds</span><span class="pcard__meta-item">5 Baths</span><span class="pcard__meta-item">3,800 sqft</span></div>
          </div>
        </div>
        <div class="pcard fade-up">
          <div class="pcard__img">
            <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80" alt="Penthouse" />
            <span class="pcard__badge pcard__badge--sale">For Sale</span>
            <span class="pcard__label pcard__label--featured">Featured</span>
          </div>
          <div class="pcard__body">
            <div class="pcard__price">AED 4,500,000</div>
            <div class="pcard__title">Sea View Penthouse</div>
            <div class="pcard__loc"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Corniche Road, Abu Dhabi</div>
            <div class="pcard__meta"><span class="pcard__meta-item">3 Beds</span><span class="pcard__meta-item">4 Baths</span><span class="pcard__meta-item">2,900 sqft</span></div>
          </div>
        </div>
      }
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     TESTIMONIALS
══════════════════════════════════════════════ -->
<section class="section-pad" style="background:#f9fafb">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px">
      <p class="ph-tag ph-tag--center fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeTestiTag, "Client Stories"))</p>
      <h2 class="ph-title ph-title--center fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeTestiTitle, "What our <em>clients</em> say"))</h2>
    </div>
    <div class="ph-testi__grid">
      @if (Model.Testimonials.Count > 0)
      {
        foreach (var t in Model.Testimonials.Take(3))
        {
          <div class="ph-testi-card fade-up">
            <div class="ph-testi-card__stars">
              @for (int s = 1; s <= Math.Min(t.Stars, 5); s++) {
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
              }
            </div>
            <p class="ph-testi-card__text">@t.Quote</p>
            <div class="ph-testi-card__author">
              <div class="ph-testi-card__avatar">@t.AuthorName[0]</div>
              <div>
                <div class="ph-testi-card__name">@t.AuthorName</div>
                @if (!string.IsNullOrWhiteSpace(t.AuthorRole)) { <div class="ph-testi-card__role">@t.AuthorRole</div> }
              </div>
            </div>
          </div>
        }
      }
      else
      {
        <div class="ph-testi-card fade-up">
          <div class="ph-testi-card__stars">
            @for (int i = 0; i < 5; i++) { <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> }
          </div>
          <p class="ph-testi-card__text">804 Avenue helped us find the perfect apartment in Al Reem Island and handled the complete interior fit-out. One company for everything — seamless.</p>
          <div class="ph-testi-card__author">
            <div class="ph-testi-card__avatar">F</div>
            <div><div class="ph-testi-card__name">Fatima Al Mazrouei</div><div class="ph-testi-card__role">Homeowner — Al Reem Island</div></div>
          </div>
        </div>
        <div class="ph-testi-card fade-up">
          <div class="ph-testi-card__stars">
            @for (int i = 0; i < 5; i++) { <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> }
          </div>
          <p class="ph-testi-card__text">Their contracting team delivered our office renovation ahead of schedule. Exceptional quality in gypsum and finishing work. Highly recommended.</p>
          <div class="ph-testi-card__author">
            <div class="ph-testi-card__avatar">J</div>
            <div><div class="ph-testi-card__name">James Mitchell</div><div class="ph-testi-card__role">CEO — Mitchell Group</div></div>
          </div>
        </div>
        <div class="ph-testi-card fade-up">
          <div class="ph-testi-card__stars">
            @for (int i = 0; i < 5; i++) { <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> }
          </div>
          <p class="ph-testi-card__text">We've used 804 Avenue for our annual maintenance contract for two years. Their preventive approach saved us from major issues. Professional and reliable.</p>
          <div class="ph-testi-card__author">
            <div class="ph-testi-card__avatar">A</div>
            <div><div class="ph-testi-card__name">Ahmed Al Dhaheri</div><div class="ph-testi-card__role">Building Manager — Abu Dhabi</div></div>
          </div>
        </div>
      }
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FINAL CTA BANNER
══════════════════════════════════════════════ -->
<section class="ph-cta">
  <div class="container">
    <div class="ph-cta__inner fade-up">
      <div class="ph-cta__text">
        <h2 class="ph-cta__title">@Html.Raw(Txt(ContentBlockSlugs.HomeCtaTitle, "Ready to build, renovate or maintain?"))</h2>
        <p class="ph-cta__sub">Call us today — contracting, maintenance &amp; FM under one roof.</p>
        <a href="@(site?.TelHref ?? "tel:+971504399804")" class="ph-cta__phone">
          @(site?.PhoneDisplay ?? "+971 50 43 99 804")
        </a>
      </div>
      <div class="ph-cta__btns">
        <a asp-page="/Contact" class="ph-btn ph-btn--white">Get a Free Quote</a>
        <a asp-page="/Properties" class="ph-btn ph-btn--outline-white">Browse Properties</a>
      </div>
    </div>
  </div>
</section>
