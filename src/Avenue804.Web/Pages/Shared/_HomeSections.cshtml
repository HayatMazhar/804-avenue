            </div>
            <h3 class="ph-service-card__title">@Cms[ContentBlockSlugs.HomeCardFmTitle, "Facility Management"]</h3>
          </div>
          <p class="ph-service-card__sub">@Html.Raw(Txt(ContentBlockSlugs.HomeServiceCardFmLead, "Complete facility management for buildings, compounds and commercial complexes across the UAE."))</p>
          <ul class="ph-service-card__list">
            @foreach (var line in SplitLines(fmBullets)) { <li>@line</li> }
          </ul>
          <span class="ph-service-card__cta">@Cms[ContentBlockSlugs.HomeCardFmCta, learnMore]</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     ABOUT 804 AVENUE
══════════════════════════════════════════════ -->
<section class="section-pad" style="background:#fff">
  <div class="container">
    <div class="ph-about__grid">
      <div class="ph-about__img fade-up">
        <img src="https://images.unsplash.com/photo-1560179707-f14e90ef3623?w=900&q=80" alt="804 Avenue office" />
        <div class="ph-about__img-card fade-up">
          <div class="ph-about__img-num">@Cms[ContentBlockSlugs.HomeAboutImgYears, "15+"]</div>
          <div class="ph-about__img-label">@Cms[ContentBlockSlugs.HomeAboutImgLabel, "Years serving the UAE"]</div>
        </div>
      </div>
      <div class="ph-about__content">
        <p class="ph-tag fade-up">@Cms[ContentBlockSlugs.HomeAboutTag, "About 804 Avenue"]</p>
        <h2 class="ph-title fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeAboutTitle, "Your trusted partner in <em>property &amp; construction</em>"))</h2>
        <p class="ph-about__text fade-up">
          @Html.Raw(Txt(ContentBlockSlugs.AboutStripLead,
            "804 Avenue Properties and Contracting is a dynamic company offering professional services in real estate, construction and property maintenance across the UAE. Headquartered in Abu Dhabi, we combine deep market knowledge with skilled craftsmanship to deliver exceptional results for every client."))
