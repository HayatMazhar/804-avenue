@model Avenue804.Web.Pages.IndexModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv
@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Configuration
@{
    var site = HttpContextAccessor.HttpContext?.GetSiteBranding();
    var B = Model.Blocks;
    string Txt(string slug, string fallback) => B.TryGetValue(slug, out var v) ? v : fallback;

    // Hero image strategy:
    //  1. If marketing has dropped a local home-hero.webp (and optional @2x) into
    //     wwwroot/assets/img/hero/, prefer it (zero external dependency, fastest).
    //  2. Otherwise fall back to the curated Unsplash construction photo that has
    //     historically been the production hero.
    // We must only emit the WebP <source> when the files actually exist on disk —
    // per HTML spec, if a type-matched <source> picks but fails to load, the browser
    // does NOT fall through to the <img> tag.
    var heroDir = System.IO.Path.Combine(WebHostEnv.WebRootPath, "assets", "img", "hero");
    var hasWebp1x = System.IO.File.Exists(System.IO.Path.Combine(heroDir, "home-hero.webp"));
    var hasWebp2x = System.IO.File.Exists(System.IO.Path.Combine(heroDir, "home-hero@@2x.webp"));
    var hasPng = System.IO.File.Exists(System.IO.Path.Combine(heroDir, "home-hero.png"));
    var localHeroPng = Url.Content("~/assets/img/hero/home-hero.png");
    const string FallbackHeroUrl = "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1800&q=80&auto=format&fit=crop";
    var heroImgSrc = hasPng ? localHeroPng : FallbackHeroUrl;
}

<!-- ══════════════════════════════════════════════
     HERO — service-first (Phase 1)
══════════════════════════════════════════════ -->
<section class="ph-hero" id="hero">
  <div class="ph-hero__bg ph-hero__bg--slides" id="heroSlider" aria-hidden="true">
    <div class="ph-hero__slide ph-hero__slide--active">
      <img src="~/assets/img/hero/hero-slide-1.jpg" alt="" width="1800" height="1000" loading="eager" decoding="async" fetchpriority="high" />
    </div>
    <div class="ph-hero__slide">
      <img src="~/assets/img/hero/hero-slide-2.jpg" alt="" width="1800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="ph-hero__slide">
      <img src="~/assets/img/hero/hero-slide-3.jpg" alt="" width="1800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="ph-hero__slide">
      <img src="~/assets/img/hero/hero-slide-4.jpg" alt="" width="1800" height="1000" loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="ph-hero__overlay"></div>
  <div class="ph-hero__content">
    <p class="ph-hero__eyebrow">@Html.Raw(Txt(ContentBlockSlugs.HomeHeroEyebrow, "Abu Dhabi's Trusted Property, Construction &amp; Maintenance Partner"))</p>
    <h1 class="ph-hero__title">@Html.Raw(Txt(ContentBlockSlugs.HomeHeroTitle, "Buy. Sell. Rent. <span class=\"ph-hero__hl\">Build.</span> Maintain. Manage."))</h1>
    <p class="ph-hero__sub">@Html.Raw(Txt(ContentBlockSlugs.HomeHeroSubtitle, "From premium real estate services to complete construction, fit-out, and maintenance solutions in Abu Dhabi — 804 Avenue is your trusted all-in-one partner."))</p>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     HERO PROPERTY-SEARCH WIDGET — Real Estate only
══════════════════════════════════════════════ -->
<div class="ph-search-wrap">
  <form class="ph-search ph-search--v2 ph-search--re" id="heroReSearch" method="get" action="/Properties">

    <!-- Compact header row: small section title + Buy/Rent pill toggle -->
    <input type="hidden" name="offer" id="heroReOffer" value="sale" />
    <div class="ph-search__re-head">
      <div class="ph-search__re-title">
        <span class="ph-search__re-title-ico" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2h-4a2 2 0 01-2-2v-5h-2v5a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        </span>
        <span>@Cms[ContentBlockSlugs.HomeSearchSectionTitle, "Real Estate"]</span>
      </div>
      <div class="ph-search__re-toggle" role="tablist" aria-label="Buy or Rent">
        <button type="button" class="ph-search__re-toggle-btn active" role="tab" aria-selected="true" data-re-mode="sale">@Cms[ContentBlockSlugs.HomeSearchBuy, "Buy"]</button>
        <button type="button" class="ph-search__re-toggle-btn" role="tab" aria-selected="false" data-re-mode="rent">@Cms[ContentBlockSlugs.HomeSearchRent, "Rent"]</button>
      </div>
    </div>

    <!-- Real Estate panel -->
    <div class="ph-search__form" data-quote-panel="realestate">
      <div class="ph-search__fields">
        <!-- Property category -->
        <div class="ph-search__field">
          <span class="ph-search__field-ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
          </span>
          <div class="ph-search__field-body">
            <div class="ph-search__label">@Cms[ContentBlockSlugs.HomeSearchPropertyType, "Property Type"]</div>
            <select class="ph-search__input" id="heroReCategory" aria-label="Property category">
              <option value="Residential" selected>@Cms[ContentBlockSlugs.HomeSearchOptionResidential, "Residential"]</option>
              <option value="Commercial">@Cms[ContentBlockSlugs.HomeSearchOptionCommercial, "Commercial"]</option>
            </select>
          </div>
        </div>

        <!-- Property details (cascading; JS swaps the list when Property Type changes) -->
        <div class="ph-search__field ph-search__field--wide">
          <span class="ph-search__field-ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></svg>
          </span>
          <div class="ph-search__field-body">
            <div class="ph-search__label">@Cms[ContentBlockSlugs.HomeSearchPropertyDetails, "Property Details"]</div>
            <select class="ph-search__input" name="type" id="heroReDetails" aria-label="Property details"
                    data-details-residential='["Apartment","Villa Apartment","Villa Compound","Villa","Building","Land"]'
                    data-details-commercial='["Shell &amp; Core Offices","Furnished Offices","Warehouse / Stores","Showroom","Shop","Villa","Labor Camp","Building","Land"]'>
              @* Residential is the default — these match data-details-residential.
                 JS (home-hero.js) repopulates this list from data-attributes when
                 Property Type changes. *@
              <option value="Apartment">Apartment</option>
              <option value="Villa Apartment">Villa Apartment</option>
              <option value="Villa Compound">Villa Compound</option>
              <option value="Villa">Villa</option>
              <option value="Building">Building</option>
              <option value="Land">Land</option>
            </select>
          </div>
        </div>

        <!-- Emirate (fixed to Abu Dhabi per brief) -->
        <div class="ph-search__field">
          <span class="ph-search__field-ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div class="ph-search__field-body">
            <div class="ph-search__label">@Cms[ContentBlockSlugs.HomeSearchEmirate, "Emirate"]</div>
            <select class="ph-search__input" name="location" id="heroReEmirate" aria-label="Emirate">
              <option value="Abu Dhabi" selected>@Cms[ContentBlockSlugs.HomeSearchEmirateDefault, "Abu Dhabi"]</option>
            </select>
          </div>
        </div>

        <button type="submit" class="ph-search__btn">
          <span>@Cms[ContentBlockSlugs.HomeSearchButton, "Search"]</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Inquiry link (replaces trust strip) -->
    <div class="ph-search__trust" style="justify-content:center">
      <a href="/Inquiry" class="ph-search__trust-item" style="text-decoration:none;color:var(--accent);font-weight:600">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        @Cms[ContentBlockSlugs.HomeSearchPlanningLink, "Planning to move in future? Click Here."]
      </a>
    </div>
  </form>
</div>

<!-- ══════════════════════════════════════════════
     STATS BAR
══════════════════════════════════════════════ -->
@{
    // Real DB-backed counts from IHomeStatsService (1h cache); see HomeStatsService.cs
    var hs = Model.Stats;
    var projectsCount   = Math.Max(hs.ProjectsDelivered, 0);
    var ticketsCount    = Math.Max(hs.MaintenanceTicketsResolved, 0);
    var listingsCount   = Math.Max(hs.PropertiesListed, 0);
    var yearsCount      = Math.Max(hs.YearsExperience, 1);
    // Render "+" suffix only when there's enough volume to look credible.
    string Suffix(int n) => n >= 5 ? "+" : "";
}
<section class="ph-stats">
  <div class="container">
    <div class="ph-stats__grid">
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="@projectsCount" data-suffix="@Suffix(projectsCount)">0</div>
        <div class="ph-stats__label">@Cms[ContentBlockSlugs.HomeStatsLabelProjects, "Projects Delivered"]</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="@yearsCount" data-suffix="+">0</div>
        <div class="ph-stats__label">@Cms[ContentBlockSlugs.HomeStatsLabelYears, "Years Experience"]</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="@ticketsCount" data-suffix="@Suffix(ticketsCount)">0</div>
        <div class="ph-stats__label">@Cms[ContentBlockSlugs.HomeStatsLabelTickets, "Maintenance Jobs Resolved"]</div>
      </div>
      <div class="ph-stats__item fade-up">
        <div class="ph-stats__num" data-count="@listingsCount" data-suffix="@Suffix(listingsCount)">0</div>
        <div class="ph-stats__label">@Cms[ContentBlockSlugs.HomeStatsLabelListings, "Properties Listed"]</div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     OUR SERVICES — core business (first section)
══════════════════════════════════════════════ -->
@{
    var reBullets = Cms[ContentBlockSlugs.HomeCardReBullets, "Buy & sell residential properties\nCommercial leasing & sales\nOff-plan project sales\nProperty management & rental\nMarket valuation & advisory"];
    var contrBullets = Cms[ContentBlockSlugs.HomeCardContrBullets, "Civil & general contracting\nInterior fit-out & renovation\nGypsum & ceiling works\nFlooring, painting & finishing\nGlass, aluminum & signage"];
    var maintBullets = Cms[ContentBlockSlugs.HomeCardMaintBullets, "MEP (mechanical, electrical, plumbing)\nPreventive maintenance contracts\nCorrective & emergency repairs\nGeneral building maintenance\nCivil maintenance works"];
    var fmBullets = Cms[ContentBlockSlugs.HomeCardFmBullets, "Building operations management\nShared services coordination\nVendor & contractor management\nHealth, safety & compliance\nAMC (annual maintenance contracts)"];
    string[] SplitLines(string s) => s.Replace("\r\n", "\n").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var learnMore = Cms[ContentBlockSlugs.CommonLearnMore, "Learn more →"];
}
<section class="section-pad section-bg-white">
  <div class="container">
    <p class="ph-tag ph-tag--center fade-up">@Cms[ContentBlockSlugs.HomeServicesTag, "What We Do"]</p>
    <h2 class="ph-title ph-title--center fade-up mb-4">@Html.Raw(Cms[ContentBlockSlugs.HomeServicesTitle, "Real Estate. Contracting. Maintenance. <em>Facility Management.</em>"])</h2>
    <div class="ph-services__grid">

      <!-- Real Estate -->
      <a class="ph-service-card fade-up" asp-page="/Properties/Index">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__header">
            <div class="ph-service-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2h-4a2 2 0 01-2-2v-5h-2v5a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
            </div>
            <h3 class="ph-service-card__title">@Cms[ContentBlockSlugs.HomeCardReTitle, "Real Estate"]</h3>
          </div>
          <p class="ph-service-card__sub">@Html.Raw(Cms[ContentBlockSlugs.HomeCardReSub, "Buy, sell or rent residential and commercial properties across Abu Dhabi and the UAE with our brokerage team."])</p>
          <ul class="ph-service-card__list">
            @foreach (var line in SplitLines(reBullets)) { <li>@line</li> }
          </ul>
          <span class="ph-service-card__cta">@Cms[ContentBlockSlugs.HomeCardReCta, learnMore]</span>
        </div>
      </a>

      <!-- Contracting -->
      <a class="ph-service-card fade-up" asp-page="/Contracting">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__header">
            <div class="ph-service-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <h3 class="ph-service-card__title">@Cms[ContentBlockSlugs.HomeCardContrTitle, "Contracting"]</h3>
          </div>
          <p class="ph-service-card__sub">@Html.Raw(Txt(ContentBlockSlugs.HomeServiceCardContrLead, "Civil works, interior fit-out, gypsum, flooring, glass &amp; aluminum, signage — end-to-end project delivery."))</p>
          <ul class="ph-service-card__list">
            @foreach (var line in SplitLines(contrBullets)) { <li>@line</li> }
          </ul>
          <span class="ph-service-card__cta">@Cms[ContentBlockSlugs.HomeCardContrCta, learnMore]</span>
        </div>
      </a>

      <!-- Maintenance -->
      <a class="ph-service-card fade-up" asp-page="/Maintenance">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__header">
            <div class="ph-service-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            </div>
            <h3 class="ph-service-card__title">@Cms[ContentBlockSlugs.HomeCardMaintTitle, "Maintenance"]</h3>
          </div>
          <p class="ph-service-card__sub">@Html.Raw(Txt(ContentBlockSlugs.HomeServiceCardMaintLead, "Preventive, corrective and MEP maintenance — keeping your property in peak condition year-round."))</p>
          <ul class="ph-service-card__list">
            @foreach (var line in SplitLines(maintBullets)) { <li>@line</li> }
          </ul>
          <span class="ph-service-card__cta">@Cms[ContentBlockSlugs.HomeCardMaintCta, learnMore]</span>
        </div>
      </a>

      <!-- Facility Management -->
      <a class="ph-service-card fade-up" asp-page="/FacilityManagement">
        <div class="ph-service-card__img" style="background-image:url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&q=80')"></div>
        <div class="ph-service-card__overlay"></div>
        <div class="ph-service-card__body">
          <div class="ph-service-card__header">
            <div class="ph-service-card__icon">
