<!-- ══════════════════════════════════════════════
     FEATURED PROPERTIES — secondary; hidden when no published listings exist
     (Phase 1: hardcoded Unsplash mock fallback removed; show real data only.)
══════════════════════════════════════════════ -->
@if (Model.FeaturedListings.Count > 0)
{
  <section class="section-pad" style="background:#f9fafb">
    <div class="container">
      <div class="ph-projects__head">
        <div>
          <p class="ph-tag fade-up">Real Estate</p>
          <h2 class="ph-title fade-up">Featured <em>Properties</em></h2>
        </div>
        <a class="ph-link-all" asp-page="/Properties/Index">Browse all →</a>
      </div>
      <div class="ph-feat-grid">
        @foreach (var p in Model.FeaturedListings)
        {
          <partial name="Shared/_PropertyCard" model="p" />
        }
      </div>
    </div>
  </section>
}

<!-- ══════════════════════════════════════════════
     TESTIMONIALS
══════════════════════════════════════════════ -->
<section class="section-pad" style="background:#f9fafb">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px">
      <p class="ph-tag ph-tag--center fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeTestiTag, "Client Stories"))</p>
      <h2 class="ph-title ph-title--center fade-up">@Html.Raw(Txt(ContentBlockSlugs.HomeTestiTitle, "What our <em>clients</em> say"))</h2>
    </div>
    <div class="ph-testi__grid">
      @if (Model.Testimonials.Count > 0)
      {
        foreach (var t in Model.Testimonials.Take(3))
        {
          <div class="ph-testi-card fade-up">
            <div class="ph-testi-card__stars">
              @for (int s = 1; s <= Math.Min(t.Stars, 5); s++) {
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
              }
            </div>
            <p class="ph-testi-card__text">@t.Quote</p>
            <div class="ph-testi-card__author">
              <div class="ph-testi-card__avatar">@t.AuthorName[0]</div>
              <div>
                <div class="ph-testi-card__name">@t.AuthorName</div>
                @if (!string.IsNullOrWhiteSpace(t.AuthorRole)) { <div class="ph-testi-card__role">@t.AuthorRole</div> }
              </div>
            </div>
          </div>
        }
      }
      else
      {
        <div class="ph-testi-card fade-up">
          <div class="ph-testi-card__stars">
