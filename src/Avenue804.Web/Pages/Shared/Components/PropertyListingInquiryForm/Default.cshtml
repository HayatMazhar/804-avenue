@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Models.Public
@using Avenue804.Web.Configuration
@inject Avenue804.Web.Services.ICmsTextProvider Cms
@model PropertyListingInquiryFormViewModel
<form method="post" asp-page="/Submit/PropertyListingInquiry" id="propertyListingInquiryForm" asp-antiforgery="true">

  <!-- Listing reference (populated automatically when opened from a property page) -->
  <div id="pliListingRefBlock" class="pli-listing-ref" hidden>
    <span class="pli-listing-ref__label">Inquiring about</span>
    <span class="pli-listing-ref__value" id="pliListingRefText"></span>
  </div>

  <p class="modal-section-title">@Cms[ContentBlockSlugs.ModalInquiryContactSection, "Your contact details"]</p>
  <div class="fields-2">
    <div class="field">
      <label class="label">Full name <span style="color:var(--accent)">*</span></label>
      <div class="control has-icons-left">
        <input class="input" id="pliName" name="Name" type="text" required autocomplete="name" maxlength="200" placeholder="Ahmed Al Mansoori" />
        <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
      </div>
    </div>
    <div class="field">
      <label class="label">Mobile number <span style="color:var(--accent)">*</span></label>
      <div class="control has-icons-left">
        <input class="input" id="pliPhone" name="Phone" type="tel" required autocomplete="tel" maxlength="50" placeholder="+971 50 000 0000" inputmode="tel" />
        <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.11 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg></span>
      </div>
    </div>
  </div>
  <div class="fields-2">
    <div class="field">
      <label class="label">Email <span style="color:var(--accent)">*</span></label>
      <div class="control has-icons-left">
        <input class="input" id="pliEmail" name="Email" type="email" required autocomplete="email" maxlength="256" placeholder="you@example.com" />
        <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
      </div>
    </div>
    <div class="field">
      <label class="label">I want to <span style="color:var(--accent)">*</span></label>
      <div class="control">
        <div class="select is-fullwidth">
          <select id="pliWant" name="WantToLookupValueId" required>
            <option value="">Select…</option>
            @foreach (var v in Model.WantToOptions)
            {
              <option value="@v.Id">@v.DisplayName</option>
            }
          </select>
        </div>
      </div>
    </div>
  </div>

  <p class="modal-section-title">@Cms[ContentBlockSlugs.ModalInquiryReqSection, "Property requirements"]</p>
  <div class="fields-2">
    <div class="field">
      <label class="label">Property type <span style="color:var(--accent)">*</span></label>
      <div class="control">
        <div class="select is-fullwidth">
          <select id="pliPropType" name="PropertyTypeLookupValueId" required class="no-ts">
            <option value="">Select…</option>
            @foreach (var v in Model.PropertyTypeOptions)
            {
              <option value="@v.Id" data-type-code="@v.Code.ToLowerInvariant()">@v.DisplayName</option>
            }
          </select>
        </div>
      </div>
    </div>
    <div class="field">
      <label class="label">Property details</label>
      <div class="control">
        <div class="select is-fullwidth">
          <select id="pliDetail" name="PropertyDetailLookupValueId" class="no-ts">
            <option value="">Select…</option>
            @foreach (var v in Model.PropertyDetailOptions)
            {
              <option value="@v.Id" data-for-types='@PropertyDetailLookupMetadata.ForTypesDataAttribute(v.Metadata)'>@v.DisplayName</option>
            }
          </select>
        </div>
      </div>
    </div>
  </div>
  <div class="fields-2">
    <div class="field">
      <label class="label">Area / location preference</label>
      <div class="control has-icons-left">
        <input class="input" id="pliArea" name="Area" type="text" maxlength="300" placeholder="e.g. Al Reem Island, Downtown" data-autocomplete="uae" autocomplete="off" />
        <span class="icon is-left"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
      </div>
    </div>
    <div class="field">
      <label class="label">Budget range <span style="color:var(--accent)">*</span></label>
      <div class="control">
        <div class="select is-fullwidth">
          <select id="pliBudget" name="BudgetLookupValueId" required>
            <option value="">Select range…</option>
            @foreach (var v in Model.BudgetOptions)
            {
              <option value="@v.Id">@v.DisplayName</option>
            }
          </select>
        </div>
      </div>
    </div>
  </div>
  <div class="fields-2">
    <div class="field">
      <label class="label">Expected move-in date</label>
      <div class="control">
        <input class="input" id="pliMoveIn" name="ExpectedMoveInDate" type="date" />
      </div>
    </div>
  </div>

  <p class="modal-section-title">@Cms[ContentBlockSlugs.ModalInquiryAddlSection, "Additional details"]</p>
  <div class="field">
    <label class="label">Describe your requirements</label>
    <div class="control">
      <textarea class="textarea" id="pliReq" name="RequirementDetails" rows="3" maxlength="8000" placeholder="Bedrooms, size, view, furnishing, timeline, specific features…"></textarea>
    </div>
  </div>

  <!-- Auto-filled when the inquiry is opened from a property page (so admins know which listing it's about) -->
  <input type="hidden" name="ListingReference" id="pliListingReference" value="" />

  <div class="field" style="margin-top:1.25rem">
    <div class="control">
      <button type="submit" class="button is-primary is-fullwidth is-medium">
        <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg></span>
        <span>@Cms[ContentBlockSlugs.ModalInquirySend, "Send Inquiry"]</span>
      </button>
    </div>
    <p class="help" style="text-align:center;margin-top:.5rem">We will contact you shortly for further details. <a href="/Privacy">Privacy Policy</a>.</p>
  </div>
</form>
