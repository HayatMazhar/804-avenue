@using Avenue804.Web.Infrastructure
@using Avenue804.Web.Models.Public
@using Avenue804.Web.Configuration
@inject Avenue804.Web.Services.ICmsTextProvider Cms
@model PropertyListingInquiryFormViewModel
@*
   Property Listing Inquiry Form — pli3 redesign.
   Matches the polished /Inquiry standalone page: numbered sections,
   floating labels, clean amber accent. IDs and `name` attrs PRESERVED
   so the cascade JS, autocomplete, listing-reference filler, and
   server submit handler all keep working.
*@
<form method="post" asp-page="/Submit/PropertyListingInquiry" id="propertyListingInquiryForm" asp-antiforgery="true" class="pli3">

  <!-- Listing reference (populated automatically when opened from a property page) -->
  <div id="pliListingRefBlock" class="pli3-ref" hidden>
    <svg class="pli3-ref__ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
    <span class="pli3-ref__label">Inquiring about</span>
    <span class="pli3-ref__value" id="pliListingRefText"></span>
  </div>

  <!-- ─── 1. Your details ───────────────────────────── -->
  <div class="pli3-sec"><span class="pli3-sec__num">1</span>Your contact details</div>

  <div class="pli3-row">
    <div class="pli3-float">
      <input class="pli3-float__input" id="pliName" name="Name" type="text" required autocomplete="name" maxlength="200" placeholder=" " />
      <label for="pliName">Full name <span class="pli3-req">*</span></label>
    </div>
    <div class="pli3-float">
      <input class="pli3-float__input" id="pliPhone" name="Phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="50" placeholder=" " />
      <label for="pliPhone">Mobile number <span class="pli3-req">*</span></label>
    </div>
  </div>

  <div class="pli3-row">
    <div class="pli3-float">
      <input class="pli3-float__input" id="pliEmail" name="Email" type="email" required autocomplete="email" maxlength="256" placeholder=" " />
      <label for="pliEmail">Email address <span class="pli3-req">*</span></label>
    </div>
    <div class="pli3-select">
      <span class="pli3-select__lbl">I want to <span class="pli3-req">*</span></span>
      <select class="pli3-select__input no-ts" id="pliWant" name="WantToLookupValueId" required>
        <option value="">Select…</option>
        @foreach (var v in Model.WantToOptions)
        {
          <option value="@v.Id">@v.DisplayName</option>
        }
      </select>
    </div>
  </div>

  <!-- ─── 2. Property requirement ───────────────────── -->
  <div class="pli3-sec"><span class="pli3-sec__num">2</span>Property requirement</div>

  <div class="pli3-row">
    <div class="pli3-select">
      <span class="pli3-select__lbl">Property type <span class="pli3-req">*</span></span>
      <select class="pli3-select__input no-ts" id="pliPropType" name="PropertyTypeLookupValueId" required>
        <option value="">Select…</option>
        @foreach (var v in Model.PropertyTypeOptions)
        {
          <option value="@v.Id" data-type-code="@v.Code.ToLowerInvariant()">@v.DisplayName</option>
        }
      </select>
    </div>
    <div class="pli3-select">
      <span class="pli3-select__lbl">Property details</span>
      <select class="pli3-select__input no-ts" id="pliDetail" name="PropertyDetailLookupValueId">
        <option value="">Select…</option>
        @foreach (var v in Model.PropertyDetailOptions)
        {
          <option value="@v.Id" data-for-types='@PropertyDetailLookupMetadata.ForTypesDataAttribute(v.Metadata)'>@v.DisplayName</option>
        }
      </select>
    </div>
  </div>

  <div class="pli3-row">
    <div class="pli3-float">
      <input class="pli3-float__input" id="pliArea" name="Area" type="text" maxlength="300" placeholder=" " data-autocomplete="uae" autocomplete="off" />
      <label for="pliArea">Area / location preference</label>
    </div>
    <div class="pli3-select">
      <span class="pli3-select__lbl">Budget range <span class="pli3-req">*</span></span>
      <select class="pli3-select__input no-ts" id="pliBudget" name="BudgetLookupValueId" required>
        <option value="">Select range…</option>
        @foreach (var v in Model.BudgetOptions)
        {
          <option value="@v.Id">@v.DisplayName</option>
        }
      </select>
    </div>
  </div>

  <div class="pli3-row">
    <div class="pli3-select">
      <span class="pli3-select__lbl">Expected move-in date</span>
      <input class="pli3-select__input" id="pliMoveIn" name="ExpectedMoveInDate" type="date" />
    </div>
    <div></div>
  </div>

  <!-- ─── 3. Anything else ──────────────────────────── -->
  <div class="pli3-sec"><span class="pli3-sec__num">3</span>Anything else?</div>

  <div class="pli3-float">
    <textarea class="pli3-float__input pli3-float__textarea" id="pliReq" name="RequirementDetails" rows="3" maxlength="8000" placeholder=" "></textarea>
    <label for="pliReq">Requirement details — bedrooms, size, view, furnishing, timeline, features…</label>
  </div>

  <input type="hidden" name="ListingReference" id="pliListingReference" value="" />

  @* reCAPTCHA v3 token — renders nothing unless a SiteKey + the recaptcha flag are configured. *@
  <partial name="_RecaptchaToken" model="@("property_inquiry")" />

  <div class="pli3-actions">
    <button type="submit" class="pli3-submit">
      <span>@Cms[ContentBlockSlugs.ModalInquirySend, "Send Inquiry"]</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <p class="pli3-fineprint">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      Secure submission — by submitting you agree to our <a href="/Privacy">Privacy Policy</a>.
    </p>
  </div>
</form>
