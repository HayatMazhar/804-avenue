@page "/Blog/{slug}"
@using Avenue804.Web.Domain
@model Avenue804.Web.Pages.Blog.BlogDetailModel
@{
    var P = Model.Post!;
    var publishedDate = (P.PublishedAt ?? P.CreatedAt).ToString("MMMM d, yyyy");
    var keywordsContent = string.Join(", ", new[] { P.FocusKeyword, P.Tags }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

@section Head {
  @if (!string.IsNullOrWhiteSpace(keywordsContent))
  {
    <meta name="keywords" content="@keywordsContent" />
  }
}

@section Styles {
<style>
  .bp-hero{padding:60px 0 40px;background:linear-gradient(160deg,var(--bg-surface),var(--bg-deep))}
  .bp-hero-inner{max-width:820px;margin:0 auto;padding:0 20px}
  .bp-cat-pill{display:inline-block;background:var(--accent);color:#fff;font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:18px}
  .bp-title{font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;color:var(--text-primary);line-height:1.18;margin:0 0 16px}
  .bp-meta{display:flex;flex-wrap:wrap;gap:14px;font-size:.85rem;color:var(--text-tertiary);align-items:center}
  .bp-meta strong{color:var(--text-secondary)}
  .bp-cover{width:100%;max-height:520px;object-fit:cover;border-radius:var(--radius-md);margin:0 0 32px}
  .bp-body{max-width:820px;margin:0 auto;padding:0 20px;font-size:1rem;line-height:1.85;color:var(--text-secondary)}
  .bp-body h2,.bp-body h3,.bp-body h4{font-family:var(--font-display);color:var(--text-primary);margin:32px 0 12px;line-height:1.3}
  .bp-body h2{font-size:1.55rem}
  .bp-body h3{font-size:1.25rem}
  .bp-body p{margin:0 0 18px}
  .bp-body a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .bp-body ul,.bp-body ol{margin:0 0 22px;padding-left:22px}
  .bp-body li{margin-bottom:8px}
  .bp-body img{max-width:100%;height:auto;border-radius:var(--radius-sm);margin:16px 0}
  .bp-body blockquote{margin:24px 0;padding:14px 22px;border-left:3px solid var(--accent);background:var(--bg-card);font-style:italic;color:var(--text-secondary)}
  .bp-tags{max-width:820px;margin:40px auto 0;padding:0 20px;display:flex;flex-wrap:wrap;gap:8px}
  .bp-tag{display:inline-flex;align-items:center;padding:5px 12px;background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:999px;font-size:.75rem;color:var(--text-secondary)}
  .bp-related{margin-top:60px}
  .bp-related-title{font-family:var(--font-display);font-size:1.3rem;font-weight:700;color:var(--text-primary);margin:0 0 22px;text-align:center}
  .bp-related-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
  .bp-related-card{display:flex;flex-direction:column;background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:var(--radius-md);overflow:hidden;text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s}
  .bp-related-card:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(15,23,42,.1)}
  .bp-related-img{aspect-ratio:16/10;background:linear-gradient(135deg,var(--accent),var(--cyan,#0ea5e9));background-size:cover;background-position:center}
  .bp-related-body{padding:14px 16px}
  .bp-related-cat{font-size:.65rem;color:var(--accent);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:6px}
  .bp-related-name{font-family:var(--font-display);font-size:.95rem;font-weight:700;color:var(--text-primary);line-height:1.4;margin:0}
</style>
}

<section class="bp-hero">
  <div class="container">
    <div class="bp-hero-inner">
      <div class="breadcrumb fade-up" style="margin-bottom:18px"><a asp-page="/Index">Home</a><span class="sep">/</span><a asp-page="/Blog/Index">Blog</a><span class="sep">/</span><span>@P.Title</span></div>
      <span class="bp-cat-pill fade-up">@P.Category.ToDisplayString()</span>
      <h1 class="bp-title fade-up">@P.Title</h1>
      <div class="bp-meta fade-up">
        @if (!string.IsNullOrWhiteSpace(P.AuthorName))
        {
          <span>By <strong>@P.AuthorName</strong></span>
          <span>·</span>
        }
        <span>@publishedDate</span>
        <span>·</span>
        <span>@Model.ReadingMinutes min read</span>
      </div>
    </div>
  </div>
</section>

<section class="section-pad">
  @if (!string.IsNullOrWhiteSpace(P.CoverImageUrl))
  {
    <div class="container" style="max-width:980px">
      <img src="@P.CoverImageUrl" alt="@P.Title" class="bp-cover fade-up" />
    </div>
  }

  <article class="bp-body fade-up">
    @Html.Raw(P.Content)
  </article>

  @if (!string.IsNullOrWhiteSpace(P.Tags))
  {
    <div class="bp-tags fade-up">
      @foreach (var t in P.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
      {
        <a class="bp-tag" asp-page="/Blog/Index" asp-route-category="@((int)P.Category)">#@t</a>
      }
    </div>
  }

  @if (Model.Related.Count > 0)
  {
    <div class="container bp-related">
      <h2 class="bp-related-title">More from <em>@P.Category.ToDisplayString()</em></h2>
      <div class="bp-related-grid">
        @foreach (var r in Model.Related)
        {
          var imgStyle = string.IsNullOrWhiteSpace(r.CoverImageUrl) ? "" : $"background-image:url('{r.CoverImageUrl}')";
          <a asp-page="/Blog/Detail" asp-route-slug="@r.Slug" class="bp-related-card">
            <div class="bp-related-img" style="@imgStyle"></div>
            <div class="bp-related-body">
              <div class="bp-related-cat">@r.Category.ToDisplayString()</div>
              <h3 class="bp-related-name">@r.Title</h3>
            </div>
          </a>
        }
      </div>
    </div>
  }
</section>
