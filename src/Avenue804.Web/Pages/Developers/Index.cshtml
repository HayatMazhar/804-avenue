@page "/Developers"
@model Avenue804.Web.Pages.Developers.DevelopersIndexModel
@{
    ViewData["Title"] = "Developers — 804 Avenue";
    ViewData["MetaDescription"] = "Browse UAE property developers featured by 804 Avenue. Explore each developer's profile and their off-plan projects and ready inventory.";
}

<section class="dev-hero" style="background:linear-gradient(180deg,#0B1224 0%,#111B33 100%);color:#fff;padding:90px 0 70px;position:relative;overflow:hidden">
  <div class="container" style="position:relative;z-index:2">
    <div style="font-size:.78rem;color:rgba(255,255,255,.6);margin-bottom:18px">
      <a asp-page="/Index" style="color:rgba(255,255,255,.6);text-decoration:none">Home</a>
      <span style="opacity:.5;margin:0 8px">/</span>
      <span>Developers</span>
    </div>
    <span style="display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:rgba(245,158,11,.15);color:#F59E0B;font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px">
      <span style="width:6px;height:6px;border-radius:999px;background:#F59E0B"></span>
      Trusted developers
    </span>
    <h1 style="font-family:var(--font-display,inherit);font-size:clamp(2rem,4vw,3rem);font-weight:700;margin:0 0 14px;letter-spacing:-.01em">
      UAE Property <em style="font-style:normal;background:linear-gradient(135deg,#FCD34D 0%,#F59E0B 60%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">Developers</em>
    </h1>
    <p style="font-size:1rem;color:rgba(255,255,255,.78);max-width:640px;line-height:1.6;margin:0">
      Explore the developers behind the UAE's most sought-after projects. Each profile lists every published off-plan and ready property we currently have available.
    </p>
  </div>
</section>

<section style="background:#F7F8FB;padding:64px 0 80px">
  <div class="container">
    @if (!Model.Developers.Any())
    {
      <div style="background:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:48px 24px;text-align:center;color:#475569">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;color:#94A3B8"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
        <p style="margin:0;font-weight:600;color:#0F172A">No developers listed yet</p>
        <p style="margin:6px 0 0;font-size:.88rem">Check back soon — developer profiles will appear here as we add them.</p>
      </div>
    }
    else
    {
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px">
        @foreach (var d in Model.Developers)
        {
          <a asp-page="/Developers/Profile" asp-route-slug="@d.Slug"
             style="display:flex;flex-direction:column;background:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:22px;text-decoration:none;color:inherit;transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease"
             onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 14px 36px rgba(8,15,35,.08)';this.style.borderColor='rgba(245,158,11,.3)'"
             onmouseout="this.style.transform='';this.style.boxShadow='';this.style.borderColor='#E5E7EB'">
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
              @if (!string.IsNullOrWhiteSpace(d.LogoUrl))
              {
                <img src="@d.LogoUrl" alt="@d.Name" style="width:54px;height:54px;border-radius:10px;object-fit:cover;background:#F1F5F9;flex:none" loading="lazy" />
              }
              else
              {
                <div style="width:54px;height:54px;border-radius:10px;background:linear-gradient(135deg,rgba(245,158,11,.15),rgba(245,158,11,.04));color:#F59E0B;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.2rem;flex:none">@d.Name.Substring(0, 1).ToUpper()</div>
              }
              <div style="min-width:0;flex:1">
                <div style="font-weight:700;font-size:1rem;color:#0F172A;line-height:1.3;letter-spacing:-.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@d.Name</div>
                @if (d.EstablishedYear.HasValue || !string.IsNullOrWhiteSpace(d.Headquarters))
                {
                  <div style="font-size:.72rem;color:#94A3B8;margin-top:3px">
                    @if (d.EstablishedYear.HasValue) { <span>Est. @d.EstablishedYear</span> }
                    @if (d.EstablishedYear.HasValue && !string.IsNullOrWhiteSpace(d.Headquarters)) { <span> · </span> }
                    @if (!string.IsNullOrWhiteSpace(d.Headquarters)) { <span>@d.Headquarters</span> }
                  </div>
                }
              </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(d.Description))
            {
              <p style="font-size:.82rem;color:#475569;line-height:1.5;margin:0 0 14px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">@d.Description</p>
            }

            <div style="display:flex;gap:8px;margin-top:auto">
              <span style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:rgba(245,158,11,.08);color:#F59E0B;font-size:.7rem;font-weight:700">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
                @d.ListingCount @(d.ListingCount == 1 ? "project" : "projects")
              </span>
              @if (d.OffPlanCount > 0)
              {
                <span style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:rgba(59,130,246,.10);color:#3B82F6;font-size:.7rem;font-weight:700">
                  @d.OffPlanCount off-plan
                </span>
              }
              <span style="margin-left:auto;color:#94A3B8;display:inline-flex;align-items:center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        }
      </div>
    }
  </div>
</section>
