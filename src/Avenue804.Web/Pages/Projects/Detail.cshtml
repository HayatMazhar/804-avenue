@page "/Projects/{slug}"
@model Avenue804.Web.Pages.Projects.DetailModel
@{
  var P = Model.Project!;
  ViewData["Title"] = P.Title;
  ViewData["NavActive"] = "projects";
  var img = string.IsNullOrWhiteSpace(P.CoverImageUrl)
    ? "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1600&q=80"
    : P.CoverImageUrl.Trim();
}

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb fade-up">
      <a asp-page="/Index">Home</a><span class="sep">/</span>
      <a asp-page="/Projects/Index">Projects</a><span class="sep">/</span>
      <span>@P.Title</span>
    </div>
    <h1 class="page-hero-title fade-up">@P.Title</h1>
    @if (!string.IsNullOrWhiteSpace(P.Summary))
    {
      <p class="page-hero-sub fade-up">@P.Summary</p>
    }
  </div>
</section>

<section class="section-pad projects-section">
  <div class="container">
    <div class="listing-detail-layout fade-up">
      <div>
        <div class="listing-detail-media">
          <img src="@img" alt="@P.Title" />
        </div>
        @if (!string.IsNullOrWhiteSpace(P.Description))
        {
          <div class="proj-detail-desc">@P.Description</div>
        }
      </div>
      <aside class="proj-detail-sidebar">
        <p class="proj-detail-sidebar__heading">Interested in similar work?</p>
        <button type="button" class="proj-detail-sidebar__btn btn-primary nav-modal-link" data-modal-open="modal-inquiry" data-inquiry-subject="Project: @P.Title (@P.Slug)">
          <span>Send an inquiry</span>
        </button>
        <a asp-page="/Contracting" class="proj-detail-sidebar__btn btn-outline">Contracting services</a>
        <a asp-page="/Contact" class="proj-detail-sidebar__btn btn-outline">Contact us</a>
      </aside>
    </div>
  </div>
</section>

@section Styles {
<style>
.proj-detail-desc { font-size: .95rem; color: #6b7280; line-height: 1.8; margin-top: 28px; white-space: pre-wrap; }
.proj-detail-sidebar {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 24px;
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.proj-detail-sidebar__heading { font-size: .88rem; color: #6b7280; margin: 0 0 4px; }
.proj-detail-sidebar__btn { display: flex; justify-content: center; width: 100%; border: none; cursor: pointer; text-decoration: none; }
</style>
}
