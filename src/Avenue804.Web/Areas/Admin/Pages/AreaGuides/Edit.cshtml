@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.AreaGuides.EditModel
@{
    ViewData["Title"] = "Edit area guide";
    ViewData["AdminSection"] = "area-guides";
}

<div class="admin-back"><a asp-page="Index">← Area guides</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">@(string.IsNullOrWhiteSpace(Model.F.Name) ? "Edit area guide" : Model.F.Name)</h1>
      <p class="as-form-page__sub">Maintain the public guide for this area — overview, prices &amp; landmarks.</p>
    </div>
    <div class="as-form-page__pill" style="background:@(Model.F.IsPublished ? "var(--as-accent-08)" : "var(--as-soft)");border-color:@(Model.F.IsPublished ? "var(--as-accent-50,rgba(245,158,11,.4))" : "var(--as-border)");color:@(Model.F.IsPublished ? "var(--as-accent)" : "var(--as-mute)");">
      @(Model.F.IsPublished ? "Live" : "Draft")
    </div>
  </header>

  <form method="post">
    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Identity</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.Name">Community name <span class="req">*</span></label>
          <input asp-for="F.Name" />
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.City">City</label>
            <input asp-for="F.City" placeholder="e.g. Abu Dhabi" />
          </div>
          <div class="as-field">
            <label asp-for="F.Emirate">Emirate</label>
            <input asp-for="F.Emirate" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="F.HeroImageUrl">Hero image URL</label>
          <input asp-for="F.HeroImageUrl" type="url" />
        </div>
        <div class="as-field">
          <label asp-for="F.ShortDescription">Short description</label>
          <textarea asp-for="F.ShortDescription" rows="2" placeholder="1–2 sentence summary shown on directory cards and the hero lede."></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Overview</h2>
          <p class="as-section__sub">HTML allowed.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.Overview">Overview</label>
          <textarea asp-for="F.Overview" rows="6"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Lifestyle &amp; amenities</h2>
          <p class="as-section__sub">One entry per line — rendered as bullets on the public page.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.Amenities">Amenities</label>
            <textarea asp-for="F.Amenities" rows="3"></textarea>
          </div>
          <div class="as-field">
            <label asp-for="F.Attractions">Attractions</label>
            <textarea asp-for="F.Attractions" rows="3"></textarea>
          </div>
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.LifestyleServices">Lifestyle &amp; services</label>
            <textarea asp-for="F.LifestyleServices" rows="3"></textarea>
          </div>
          <div class="as-field">
            <label asp-for="F.Shopping">Shopping</label>
            <textarea asp-for="F.Shopping" rows="3"></textarea>
          </div>
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.Education">Education</label>
            <textarea asp-for="F.Education" rows="3"></textarea>
          </div>
          <div class="as-field">
            <label asp-for="F.Dining">Dining</label>
            <textarea asp-for="F.Dining" rows="3"></textarea>
          </div>
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.Healthcare">Healthcare</label>
            <textarea asp-for="F.Healthcare" rows="3"></textarea>
          </div>
          <div class="as-field">
            <label asp-for="F.Transportation">Transportation</label>
            <textarea asp-for="F.Transportation" rows="3"></textarea>
          </div>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Investment information</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.AverageRoiPercent">Average ROI %</label>
            <input asp-for="F.AverageRoiPercent" type="number" step="0.01" min="0" max="100" />
          </div>
          <div class="as-field">
            <label asp-for="F.RentalYieldPercent">Rental yield %</label>
            <input asp-for="F.RentalYieldPercent" type="number" step="0.01" min="0" max="100" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="F.InvestmentInsights">Investment insights</label>
          <textarea asp-for="F.InvestmentInsights" rows="4"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Average prices</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.AvgPriceSaleSqft">Avg sale / sqft (AED)</label>
            <input asp-for="F.AvgPriceSaleSqft" type="number" />
          </div>
          <div class="as-field">
            <label asp-for="F.AvgRentYearly">Avg 1BR rent / yr (AED)</label>
            <input asp-for="F.AvgRentYearly" type="number" />
          </div>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l9 4-9 4-9-4 9-4z"/><path d="M3 14l9 4 9-4"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Lifestyle &amp; transport</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.PopularWith">Popular with</label>
          <input asp-for="F.PopularWith" />
        </div>
        <div class="as-field">
          <label asp-for="F.NearbyLandmarks">Nearby landmarks</label>
          <input asp-for="F.NearbyLandmarks" />
        </div>
        <div class="as-field">
          <label asp-for="F.SchoolsNearby">Schools nearby</label>
          <input asp-for="F.SchoolsNearby" />
        </div>
        <div class="as-field">
          <label asp-for="F.TransportLinks">Transport links</label>
          <input asp-for="F.TransportLinks" />
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Visibility</h2>
        </div>
      </header>
      <div class="as-section__body">
        <label class="as-toggle">
          <input asp-for="F.IsPublished" />
          <span class="as-toggle__switch"></span>
          <span class="as-toggle__text">
            <span class="as-toggle__title">Published</span>
            <span class="as-toggle__sub">Visible on the public Area Guides page.</span>
          </span>
        </label>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info"><span class="dot" style="background:@(Model.F.IsPublished ? "var(--as-success)" : "var(--as-mute)");"></span>@(Model.F.IsPublished ? "Live on the public site" : "Draft")</div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Save changes
        </button>
      </div>
    </footer>
  </form>
</div>
