@page
@model Avenue804.Web.Areas.Admin.Pages.ServiceReports.IndexModel
@{
    ViewData["Title"] = "Service Reports";
    ViewData["AdminSection"] = "service-reports";
}
<p class="admin-back admin-back--tight"><a asp-page="Create">+ Add report</a></p>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Date</th><th>Title</th><th>Client</th><th>Report file</th></tr></thead>
    <tbody>
      @foreach (var r in Model.Items)
      {
        <tr>
          <td>@r.VisitDate.ToString("d MMM yyyy")</td>
          <td>@r.Title</td>
          <td>@r.ClientName<br /><span class="muted small">@r.ClientEmail</span></td>
          <td>
            @if (!string.IsNullOrWhiteSpace(r.ReportFileUrl))
            {
              <a href="@r.ReportFileUrl" target="_blank" class="link-accent small"><i class="bi bi-download me-1" aria-hidden="true"></i>Download</a>
            }
            else { <span class="muted">No file</span> }
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
@if (!Model.Items.Any()) { <p class="muted admin-empty">No service reports yet.</p> }
