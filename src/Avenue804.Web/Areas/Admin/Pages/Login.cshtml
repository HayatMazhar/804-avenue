@page
@model LoginModel
@{
    Layout = "_AdminLoginLayout";
    ViewData["Title"] = "Admin login";
}

<style>
  .input-wrap { position: relative; }
  .input-wrap > input { padding-left: 42px !important; padding-right: 42px !important; }
  .input-wrap .icon-l {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }
  .input-wrap .pw-toggle {
    position: absolute;
    right: 10px; top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    color: #94a3b8;
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: inline-flex;
  }
  .input-wrap .pw-toggle:hover { color: #f59e0b; background: #fef3c7; }
</style>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="err">@Model.ErrorMessage</div>
}

<form method="post" class="login-form">
  <div class="modal-field">
    <label asp-for="Input.Email">Email address</label>
    <div class="input-wrap">
      <svg class="icon-l" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      <input asp-for="Input.Email" autocomplete="username" placeholder="admin@804avenue.ae" />
    </div>
    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
  </div>

  <div class="modal-field">
    <label asp-for="Input.Password">Password</label>
    <div class="input-wrap">
      <svg class="icon-l" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      <input asp-for="Input.Password" autocomplete="current-password" placeholder="Enter your password" id="pwField" />
      <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password">
        <svg id="pwEye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
  </div>

  <button type="submit" class="btn-login-full">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
    Sign in to Admin
  </button>
</form>

<p class="login-footnote">
  <i class="bi bi-shield-lock" style="color:#f59e0b;margin-right:4px"></i>
  Restricted to authorised staff only. Contact your administrator if you need an account.
</p>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    (function(){
      var btn = document.getElementById('pwToggle');
      var fld = document.getElementById('pwField');
      var eye = document.getElementById('pwEye');
      if (!btn || !fld) return;
      btn.addEventListener('click', function(){
        var show = fld.type === 'password';
        fld.type = show ? 'text' : 'password';
        eye.innerHTML = show
          ? '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
          : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
      });
    })();
  </script>
}
