@page
@model LoginModel
@{
    Layout = "_AdminLoginLayout";
    ViewData["Title"] = "Admin login";
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="err">@Model.ErrorMessage</div>
}
<form method="post" class="login-form">
  <div class="modal-field">
    <label asp-for="Input.Email"></label>
    <input asp-for="Input.Email" autocomplete="username" />
    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
  </div>
  <div class="modal-field">
    <label asp-for="Input.Password"></label>
    <input asp-for="Input.Password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
  </div>
  <button type="submit" class="btn-primary btn-login-full"><span>Sign in</span></button>
</form>
<p class="login-footnote">Default user is created from <code>Seed:AdminEmail</code> / <code>Seed:AdminPassword</code> in appsettings (Development only).</p>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
