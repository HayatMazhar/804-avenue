@page
@model Avenue804.Web.Areas.Admin.Pages.Inquiries.IndexModel
@{
    ViewData["Title"] = "Inquiries";
    string BadgeClass(InquiryStatus s) => s switch
    {
        InquiryStatus.New => "badge badge-new",
        InquiryStatus.InProgress => "badge badge-progress",
        _ => "badge badge-closed"
    };
}
<p class="muted admin-lead-muted">@Model.TotalCount total</p>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>From</th>
        <th>Topic</th>
        <th>Subject</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var row in Model.Items)
    {
      <tr>
        <td>@row.CreatedAt.LocalDateTime.ToString("g")</td>
        <td>
          <a asp-page="Detail" asp-route-id="@row.Id">@row.Name</a><br />
          <span class="muted small">@row.Email</span>
        </td>
        <td class="muted small">@(row.TopicLookup?.DisplayName ?? "—")</td>
        <td>@row.Subject</td>
        <td><span class="@BadgeClass(row.Status)">@row.Status</span></td>
      </tr>
    }
    </tbody>
  </table>
</div>
@if (Model.Items.Count == 0)
{
  <p class="muted admin-empty">No inquiries yet.</p>
}
<div class="pager">
  @if (Model.PageNumber > 1)
  {
    <a asp-page="Index" asp-route-p="@(Model.PageNumber - 1)">Previous</a>
  }
  <span>Page @Model.PageNumber of @Model.TotalPages</span>
  @if (Model.PageNumber < Model.TotalPages)
  {
    <a asp-page="Index" asp-route-p="@(Model.PageNumber + 1)">Next</a>
  }
</div>
