@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var pageTitle = ViewData["Title"] as string ?? "Admin";
    var pageSub = ViewData["AdminSub"] as string;
    var unread = ViewData["UnreadNotifs"] as int? ?? 0;
}
<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@pageTitle — 804 Admin</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <link rel="stylesheet" href="~/assets/css/shared.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/forms-ui.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/ui-modern.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/bulma-theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/bootstrap-avenue.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/ui-dropdown.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/admin-shell.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <div class="as-shell enhance-dd" id="asShell">

    <!-- ─── Sidebar ─────────────────────────────────────── -->
    <aside class="as-side" aria-label="Admin navigation">
      <div class="as-side__brand as-side__brand--img">
        <a asp-area="" asp-page="/Index" target="_blank" rel="noopener" class="as-side__brand-link" aria-label="804 Avenue — open public site">
          <img src="~/assets/img/brand/logo-804avenue-transparent.png"
               alt="804 Avenue — Properties &amp; Contracting"
               class="as-side__brand-img"
               width="180" height="58"
               decoding="async" />
        </a>
        <span class="as-side__brand-sub">Admin Console</span>
      </div>
      <div class="as-side__scroll">
        <partial name="_AdminNav" />
      </div>
      <div class="as-side__foot">
        <span>v1.0</span>
        <a asp-area="" asp-page="/Index" target="_blank" rel="noopener">View site →</a>
      </div>
    </aside>

    <!-- ─── Main column ─────────────────────────────────── -->
    <div class="as-main">
      <header class="as-top">
        <button type="button" class="as-top__menu-btn" id="asMenuBtn" aria-label="Toggle navigation">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <div class="as-top__title">
          <div class="as-top__crumbs">
            <a asp-area="Admin" asp-page="/Index">Admin</a>
            <span>/</span>
            <span>@pageTitle</span>
          </div>
          <h1 class="as-top__h1">@pageTitle</h1>
        </div>

        <div class="as-top__spacer"></div>

        <a asp-area="" asp-page="/Index" class="as-top__action as-top__action--hide-sm" target="_blank" rel="noopener" title="Open public site in a new tab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View site
        </a>

        <a asp-area="Admin" asp-page="/Notifications/Index" class="as-top__bell" title="Notifications">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          @if (unread > 0) { <span class="as-top__bell-count">@unread</span> }
        </a>

        <form asp-area="Admin" asp-page="/Logout" method="post" class="admin-logout-form" style="margin:0;">
          <button type="submit" class="as-top__logout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Log out
          </button>
        </form>
      </header>

      <main class="as-body">
        @if (TempData["ToastOk"] is string admOk && !string.IsNullOrWhiteSpace(admOk))
        {
          <div class="as-toast as-toast--ok" role="status">@admOk</div>
        }
        @RenderBody()
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" crossorigin="anonymous"></script>
  <script src="~/assets/js/tom-select-init.js" asp-append-version="true"></script>
  <script src="~/assets/js/autocomplete.js" asp-append-version="true"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr" defer></script>
  <script>
  (function () {
    var shell = document.getElementById('asShell');
    var btn = document.getElementById('asMenuBtn');
    if (btn && shell) {
      btn.addEventListener('click', function () {
        shell.classList.toggle('is-side-open');
      });
      shell.addEventListener('click', function (e) {
        if (shell.classList.contains('is-side-open') &&
            !e.target.closest('.as-side') &&
            !e.target.closest('#asMenuBtn')) {
          shell.classList.remove('is-side-open');
        }
      });
    }
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof flatpickr === 'undefined') return;
      document.querySelectorAll('input[type="date"]:not(.flatpickr-input)').forEach(function (el) {
        flatpickr(el, { dateFormat: 'Y-m-d', allowInput: true, animate: true });
      });
      document.querySelectorAll('input[type="range"]').forEach(function (r) {
        function sync() { var mn = parseFloat(r.min) || 0, mx = parseFloat(r.max) || 100, v = parseFloat(r.value) || 0; r.style.setProperty('--range-pct', ((v - mn) / (mx - mn) * 100).toFixed(1) + '%'); }
        sync(); r.addEventListener('input', sync);
      });
    });
  })();
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
