<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — 804 Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/assets/css/shared.css" asp-append-version="true" />
  <style>
    body { margin: 0; min-height: 100vh; background: var(--bg-deep); }
    .login-shell { max-width: 480px; margin: 0 auto; padding: 48px 24px 80px; }
    .login-shell h1 { font-family: var(--font-display); font-size: 1.35rem; color: var(--text-primary); margin: 0 0 8px; }
    .login-shell .sub { color: var(--text-tertiary); font-size: 0.88rem; margin-bottom: 28px; }
  </style>
</head>
<body>
  <div class="login-shell">
    <h1>@ViewData["Title"]</h1>
    <p class="sub">804 Avenue administration</p>
    @RenderBody()
  </div>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
