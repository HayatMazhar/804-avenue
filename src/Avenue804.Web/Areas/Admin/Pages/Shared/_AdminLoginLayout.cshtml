<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — 804 Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="~/assets/css/shared.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/forms-ui.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/ui-modern.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/bulma-theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/bootstrap-avenue.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true" />
  <style>
    body { margin: 0; min-height: 100vh; background: var(--bg-deep); display: flex; align-items: center; justify-content: center; }
    .login-shell { width: 100%; max-width: 400px; padding: 24px; }
    .login-card { background: #fff; border: 1px solid #e2e5e9; border-radius: 14px; padding: 36px 32px; box-shadow: 0 4px 24px rgba(15,23,42,.06); }
    .login-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
    .login-brand svg { color: var(--accent); }
    .login-brand-text { font-family: var(--font-nav); font-weight: 800; font-size: 1rem; color: var(--text-primary); letter-spacing: .03em; }
    .login-brand-text span { color: var(--accent); }
    .login-shell h1 { font-family: var(--font-display); font-size: 1.2rem; color: var(--text-primary); margin: 0 0 4px; }
    .login-shell .sub { color: var(--text-tertiary); font-size: 0.8rem; margin-bottom: 24px; }
  </style>
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="login-brand">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
        <div class="login-brand-text">804 <span>AVENUE</span></div>
      </div>
      <h1>@ViewData["Title"]</h1>
      <p class="sub">Sign in to the admin panel</p>
      @RenderBody()
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
