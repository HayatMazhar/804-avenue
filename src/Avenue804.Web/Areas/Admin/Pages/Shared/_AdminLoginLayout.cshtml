@{
    var pageTitle = ViewData["Title"] as string ?? "Admin login";
}
<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@pageTitle — 804 Admin</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
  <link rel="icon" type="image/png" sizes="32x32" href="~/assets/img/brand/favicon-32.png" asp-append-version="true" />
  <link rel="icon" type="image/png" sizes="16x16" href="~/assets/img/brand/favicon-16.png" asp-append-version="true" />
  <link rel="apple-touch-icon" sizes="180x180" href="~/assets/img/brand/favicon-180.png" asp-append-version="true" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }

    body.admin-login-body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      color: #0f172a;
      min-height: 100vh;
      display: flex;
      background: #f4f6fa;
    }

    /* ── Left: brand panel ─────────────────────────── */
    .al-brand {
      flex: 1 1 55%;
      position: relative;
      overflow: hidden;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #fff;
      background:
        radial-gradient(900px 500px at 90% -10%, rgba(245,158,11,.28), transparent 60%),
        radial-gradient(700px 400px at 0% 110%, rgba(6,182,212,.18), transparent 55%),
        linear-gradient(135deg, #0b1220 0%, #11203b 50%, #0f172a 100%);
    }
    .al-brand::before {
      content: '';
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.05) 1px, transparent 0);
      background-size: 28px 28px;
      pointer-events: none;
      mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
    }
    .al-brand > * { position: relative; z-index: 2; }

    .al-logo { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
    .al-logo__img {
      display: block;
      height: 56px;
      width: auto;
      max-width: 220px;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }
    .al-logo__sub {
      font-size: .65rem;
      color: rgba(255,255,255,.55);
      text-transform: uppercase;
      letter-spacing: .18em;
      padding-left: 2px;
    }

    .al-brand__h1 {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 4vw, 2.8rem);
      line-height: 1.05;
      letter-spacing: -.02em;
      font-weight: 700;
      max-width: 480px;
      margin: 0 0 18px;
    }
    .al-brand__h1 em {
      font-style: normal;
      background: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .al-brand__lead {
      font-size: 1rem;
      color: rgba(255,255,255,.78);
      max-width: 460px;
      line-height: 1.6;
      margin: 0;
    }
    .al-feats {
      list-style: none;
      margin: 28px 0 0;
      padding: 0;
      display: grid;
      gap: 14px;
    }
    .al-feats li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: .9rem;
      color: rgba(255,255,255,.88);
    }
    .al-feats svg {
      flex-shrink: 0;
      background: rgba(245,158,11,.15);
      border: 1px solid rgba(245,158,11,.4);
      border-radius: 8px;
      padding: 5px;
      color: #f59e0b;
    }

    .al-brand__bot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      font-size: .72rem;
      color: rgba(255,255,255,.45);
    }
    .al-brand__bot a {
      color: rgba(255,255,255,.7);
      text-decoration: none;
      transition: color .15s;
    }
    .al-brand__bot a:hover { color: #f59e0b; }

    /* ── Right: form panel ─────────────────────────── */
    .al-form-pane {
      flex: 1 1 45%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 40px;
    }
    .al-card {
      width: 100%;
      max-width: 420px;
    }
    .al-card__head { margin-bottom: 28px; }
    .al-card__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border: 1px solid rgba(245,158,11,.35);
      background: rgba(245,158,11,.08);
      color: #b45309;
      border-radius: 99px;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .al-card__h2 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.85rem;
      font-weight: 700;
      letter-spacing: -.015em;
      margin: 0 0 6px;
      color: #0f172a;
    }
    .al-card__sub {
      font-size: .92rem;
      color: #64748b;
      margin: 0;
    }

    .err {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(239,68,68,.08);
      border: 1px solid rgba(239,68,68,.35);
      color: #991b1b;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: .85rem;
      margin-bottom: 18px;
    }
    .err::before {
      content: '!';
      flex-shrink: 0;
      width: 22px; height: 22px;
      border-radius: 50%;
      background: #ef4444;
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: .8rem;
    }

    .login-form { display: flex; flex-direction: column; gap: 16px; }
    .modal-field { display: flex; flex-direction: column; gap: 6px; }
    .modal-field > label {
      font-size: .75rem;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .modal-field input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      font-family: inherit;
      font-size: .95rem;
      background: #fff;
      color: #0f172a;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .modal-field input:focus {
      outline: none;
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245,158,11,.15);
    }
    .field-validation-error {
      color: #b91c1c;
      font-size: .76rem;
      margin-top: 4px;
    }

    .btn-login-full {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: #0b1220;
      color: #fff;
      border: 1.5px solid #0b1220;
      border-radius: 10px;
      padding: 13px 16px;
      font-family: inherit;
      font-size: .95rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 8px;
      transition: all .15s ease;
    }
    .btn-login-full:hover {
      background: #f59e0b;
      border-color: #f59e0b;
      color: #0b1220;
      transform: translateY(-1px);
      box-shadow: 0 10px 22px rgba(245,158,11,.4);
    }

    .login-footnote {
      margin-top: 22px;
      padding: 12px 14px;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 10px;
      font-size: .76rem;
      color: #64748b;
      line-height: 1.5;
    }
    .login-footnote code {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 4px;
      padding: 1px 6px;
      font-size: .72rem;
      color: #b45309;
    }

    /* ── Responsive ─────────────────────────────────── */
    @@media (max-width: 980px) {
      body.admin-login-body { flex-direction: column; }
      .al-brand {
        flex: 0 0 auto;
        padding: 32px 24px;
      }
      .al-brand__h1 { font-size: 1.6rem; margin-bottom: 12px; }
      .al-brand__lead { font-size: .9rem; }
      .al-feats { display: none; }
      .al-brand__bot { display: none; }
      .al-form-pane {
        flex: 1 1 auto;
        padding: 32px 20px;
      }
      .al-card__h2 { font-size: 1.5rem; }
    }
    @@media (max-width: 480px) {
      .al-brand { padding: 24px 20px; }
      .al-logo__img { height: 44px; max-width: 180px; }
      .al-brand__h1 { font-size: 1.35rem; }
    }
  </style>
</head>
<body class="admin-login-body">

  <!-- ── Left brand panel ─────────────────────────── -->
  <aside class="al-brand">
    <div class="al-logo">
      <img src="~/assets/img/brand/logo-804avenue-transparent.png"
           alt="804 Avenue — Properties &amp; Contracting"
           class="al-logo__img"
           width="200" height="64"
           decoding="async" />
      <span class="al-logo__sub">Admin Console</span>
    </div>

    <div>
      <h1 class="al-brand__h1">One console for the <em>entire business.</em></h1>
      <p class="al-brand__lead">
        Run the public site, manage inquiries, dispatch service jobs and
        ship new content — all from a single, unified console.
      </p>
      <ul class="al-feats">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
          Page-by-page CMS for every public surface
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
          Property inquiries, service requests &amp; AMC in one inbox
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
          Real-time dashboards &amp; emergency-ticket alerting
        </li>
      </ul>
    </div>

    <div class="al-brand__bot">
      <span>© @DateTime.UtcNow.Year 804 Avenue</span>
      <a href="/" target="_blank" rel="noopener">View public site →</a>
    </div>
  </aside>

  <!-- ── Right form panel ─────────────────────────── -->
  <section class="al-form-pane">
    <div class="al-card">
      <div class="al-card__head">
        <span class="al-card__eyebrow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1l3 6 6 1-4.5 4 1 6L12 15l-5.5 3 1-6L3 8l6-1z"/></svg>
          Secure access
        </span>
        <h2 class="al-card__h2">Welcome back</h2>
        <p class="al-card__sub">Sign in to the 804 Avenue admin console.</p>
      </div>

      @RenderBody()
    </div>
  </section>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
