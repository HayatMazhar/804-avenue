@{
    var section = ViewData["AdminSection"] as string ?? "";
    string CssFor(string key) => string.Equals(section, key, StringComparison.OrdinalIgnoreCase)
        ? "as-side__link is-active"
        : "as-side__link";
}

@* ─── Overview ──────────────────────────────────────────── *@
<div class="as-side__group">
  <p class="as-side__group-title">Overview</p>
  <a class="@CssFor("dashboard")" asp-area="Admin" asp-page="/Index">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <span>Dashboard</span>
  </a>
  <a class="@CssFor("notifications")" asp-area="Admin" asp-page="/Notifications/Index">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
    <span>Notifications</span>
  </a>
</div>

