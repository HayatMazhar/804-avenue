@page
@model Avenue804.Web.Areas.Admin.Pages.Developers.CreateModel
@{
    ViewData["Title"] = "Add developer";
    ViewData["AdminSection"] = "developers";
}

<div class="admin-back"><a asp-page="Index">← Developers</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">Add developer</h1>
      <p class="as-form-page__sub">Create a developer brand that listings can be linked to.</p>
    </div>
  </header>

  <form method="post">
    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Brand basics</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.Name">Developer name <span class="req">*</span></label>
          <input asp-for="F.Name" />
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.Headquarters">Headquarters</label>
            <input asp-for="F.Headquarters" placeholder="e.g. Abu Dhabi, UAE" />
          </div>
          <div class="as-field">
            <label asp-for="F.EstablishedYear">Established year</label>
            <input asp-for="F.EstablishedYear" type="number" placeholder="e.g. 2004" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="F.Description">Company overview (brief introduction)</label>
          <textarea asp-for="F.Description" rows="4"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Mission, vision &amp; philosophy</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.Mission">Company mission</label>
          <textarea asp-for="F.Mission" rows="3" placeholder="Mission statement"></textarea>
        </div>
        <div class="as-field">
          <label asp-for="F.Vision">Company vision</label>
          <textarea asp-for="F.Vision" rows="3" placeholder="Vision statement"></textarea>
        </div>
        <div class="as-field">
          <label asp-for="F.Philosophy">Company philosophy</label>
          <textarea asp-for="F.Philosophy" rows="3" placeholder="Core values and philosophy"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M9 13.5L7 22l5-3 5 3-2-8.5"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Achievements &amp; statistics</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="F.YearsInBusiness">Years in business</label>
            <input asp-for="F.YearsInBusiness" type="number" min="0" placeholder="e.g. 20" />
          </div>
          <div class="as-field">
            <label asp-for="F.TotalProjects">Total projects</label>
            <input asp-for="F.TotalProjects" type="number" min="0" placeholder="e.g. 45" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="F.UnitsDelivered">Units delivered</label>
          <input asp-for="F.UnitsDelivered" type="number" min="0" placeholder="e.g. 12000" />
        </div>
        <div class="as-field">
          <label asp-for="F.AwardsRecognition">Awards &amp; recognition</label>
          <textarea asp-for="F.AwardsRecognition" rows="3" placeholder="Industry awards and achievements (one per line)"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Branding &amp; web</h2>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="F.LogoUrl">Logo URL</label>
          <input asp-for="F.LogoUrl" type="url" placeholder="https://…/logo.png" />
        </div>
        <div class="as-field">
          <label asp-for="F.WebsiteUrl">Website URL</label>
          <input asp-for="F.WebsiteUrl" type="url" placeholder="https://developer.com" />
        </div>
        <label class="as-toggle">
          <input asp-for="F.IsActive" />
          <span class="as-toggle__switch"></span>
          <span class="as-toggle__text">
            <span class="as-toggle__title">Active</span>
            <span class="as-toggle__sub">Show in listing dropdowns &amp; the public Developers page.</span>
          </span>
        </label>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info"><span class="dot" style="background:var(--as-mute);"></span>Saving creates the developer profile.</div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Save developer
        </button>
      </div>
    </footer>
  </form>
</div>
