@page
@model Avenue804.Web.Areas.Admin.Pages.SiteSettings.CreateModel
@{
    ViewData["Title"] = "Add site setting";
    ViewData["AdminSection"] = "site-settings";
}

<div class="admin-back"><a asp-page="Index">← Site settings</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">Add site setting</h1>
      <p class="as-form-page__sub">Override a value from <code>appsettings</code> at runtime — e.g. <code>PhoneDisplay</code> for the public phone number.</p>
    </div>
  </header>

  <form method="post">
    <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Setting</h2>
          <p class="as-section__sub">Pick from a known key or type a new one.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="Form.Key">Key <span class="req">*</span></label>
          <input asp-for="Form.Key" list="site-setting-key-suggestions" maxlength="120" required autocomplete="off" placeholder="e.g. PhoneDisplay" style="font-family:'SFMono-Regular',Consolas,monospace;" />
          <datalist id="site-setting-key-suggestions">
            @foreach (var k in Model.KeyChoices)
            {
              <option value="@k.Value" />
            }
          </datalist>
          <span asp-validation-for="Form.Key" class="field-validation-error"></span>
        </div>
        <div class="as-field">
          <label asp-for="Form.Value">Value <span class="req">*</span></label>
          <textarea asp-for="Form.Value" rows="4" required></textarea>
          <span asp-validation-for="Form.Value" class="field-validation-error"></span>
        </div>
        <div class="as-field">
          <label asp-for="Form.Description">Description</label>
          <input asp-for="Form.Description" placeholder="Optional note about what this setting controls." />
        </div>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info"><span class="dot" style="background:var(--as-mute);"></span>Saving creates the override.</div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Save setting
        </button>
      </div>
    </footer>
  </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
