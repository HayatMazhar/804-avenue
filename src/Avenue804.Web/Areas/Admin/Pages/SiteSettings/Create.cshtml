@page
@model Avenue804.Web.Areas.Admin.Pages.SiteSettings.CreateModel
@{
    ViewData["Title"] = "Add site setting";
}
<p class="admin-back"><a asp-page="Index">← Site settings</a></p>
<p class="muted admin-detail-lead">Use a key that matches a property under <code>Site</code> in appsettings (e.g. <code>PhoneDisplay</code>) to override public branding. You can also enter a custom key for future use.</p>
<form method="post" class="admin-form">
  <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>
  <div class="row">
    <label asp-for="Form.Key"></label>
    <input asp-for="Form.Key" list="site-setting-key-suggestions" maxlength="120" required autocomplete="off" placeholder="e.g. PhoneDisplay" />
    <datalist id="site-setting-key-suggestions">
      @foreach (var k in Model.KeyChoices)
      {
        <option value="@k.Value" />
      }
    </datalist>
    <span asp-validation-for="Form.Key" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.Value"></label>
    <textarea asp-for="Form.Value" rows="4" required></textarea>
    <span asp-validation-for="Form.Value" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.Description"></label>
    <input asp-for="Form.Description" />
  </div>
  <button type="submit" class="btn-primary"><span>Save</span></button>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
