@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.SiteSettings.EditModel
@{
    ViewData["Title"] = "Edit setting";
}
<p class="admin-back"><a asp-page="Index">← Site settings</a></p>
<form method="post" class="admin-form">
  <input type="hidden" asp-for="Form.Key" />
  <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>
  <div class="row">
    <label>Key</label>
    <input type="text" value="@Model.KeyName" readonly class="admin-input-readonly-dim" />
  </div>
  <div class="row">
    <label asp-for="Form.Value"></label>
    <textarea asp-for="Form.Value" rows="5" required></textarea>
    <span asp-validation-for="Form.Value" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.Description"></label>
    <input asp-for="Form.Description" />
  </div>
  <div class="admin-flex-row">
    <button type="submit" class="btn-primary"><span>Save</span></button>
    <button type="submit" class="btn-outline btn-danger-outline" asp-page-handler="Delete" formnovalidate onclick="return confirm('Remove this override? The site will fall back to appsettings.');">Delete</button>
  </div>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
