@page
@model Avenue804.Web.Areas.Admin.Pages.OwnerRequests.IndexModel
@{
    ViewData["Title"] = "Listing requests";
}
<p class="muted admin-lead-muted">@Model.TotalCount total</p>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Intent</th>
        <th>Category</th>
        <th>Sub-type</th>
        <th>Emirate</th>
        <th>Area</th>
        <th>I am</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var row in Model.Items)
    {
      <tr>
        <td>@row.CreatedAt.LocalDateTime.ToString("g")</td>
        <td><a asp-page="Detail" asp-route-id="@row.Id">@row.Name</a></td>
        <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : Html.Raw($"<a href=\"tel:{row.Phone}\">{row.Phone}</a>"))</td>
        <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : Html.Raw($"<a href=\"mailto:{row.Email}\">{row.Email}</a>"))</td>
        <td>@row.Intent</td>
        <td class="muted">@(row.PropertyCategory ?? "—")</td>
        <td class="muted">@(row.PropertySubType ?? "—")</td>
        <td class="muted">@(row.Emirate ?? "—")</td>
        <td class="muted">@(row.Area ?? "—")</td>
        <td class="muted">@(row.IAmRole ?? "—")</td>
        <td class="muted" title="@row.Details">@(string.IsNullOrWhiteSpace(row.Details) ? "—" : (row.Details.Length > 60 ? row.Details[..60] + "…" : row.Details))</td>
      </tr>
    }
    </tbody>
  </table>
</div>
@if (Model.Items.Count == 0)
{
  <p class="muted admin-empty">No listing requests yet.</p>
}
<div class="pager">
  @if (Model.PageNumber > 1)
  {
    <a asp-page="Index" asp-route-p="@(Model.PageNumber - 1)">Previous</a>
  }
  <span>Page @Model.PageNumber of @Model.TotalPages</span>
  @if (Model.PageNumber < Model.TotalPages)
  {
    <a asp-page="Index" asp-route-p="@(Model.PageNumber + 1)">Next</a>
  }
</div>
