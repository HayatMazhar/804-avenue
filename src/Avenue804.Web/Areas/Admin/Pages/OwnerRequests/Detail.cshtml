@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.OwnerRequests.DetailModel
@{
    ViewData["Title"] = "Listing request";
    ViewData["AdminSection"] = "owner-requests";
    var row = Model.Row!;
    var initial = string.IsNullOrWhiteSpace(row.Name) ? "?" : row.Name.Trim()[0].ToString().ToUpperInvariant();
}

<div class="admin-back"><a asp-page="Index">← Listing requests</a></div>

<div class="as-form-page">
  <div class="as-detail-hero">
    <div class="as-detail-hero__main">
      <div class="as-detail-hero__avatar">@initial</div>
      <div>
        <h1 class="as-detail-hero__title">@row.Name</h1>
        <p class="as-detail-hero__sub">
          <a href="mailto:@row.Email" class="link-accent">@row.Email</a>
          @if (!string.IsNullOrWhiteSpace(row.Phone)) { <span> · </span> <a href="tel:@row.Phone" class="link-accent">@row.Phone</a> }
          <span> · </span> @row.CreatedAt.LocalDateTime.ToString("dd MMM yyyy · HH:mm")
        </p>
      </div>
    </div>
    <div class="as-detail-hero__actions">
      <span class="badge badge-progress">@row.Intent</span>
      @if (!string.IsNullOrWhiteSpace(row.Phone)) {
        <a class="as-btn as-btn--ghost" href="tel:@row.Phone">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Call
        </a>
      }
      <a class="as-btn as-btn--primary" href="mailto:@row.Email">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Reply
      </a>
    </div>
  </div>

  <section class="as-section">
    <header class="as-section__head">
      <div class="as-section__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <div class="as-section__title-wrap">
        <h2 class="as-section__title">Request details</h2>
      </div>
    </header>
    <div class="as-section__body">
      <dl class="detail-dl">
        <dt>Intent</dt>
        <dd>@row.Intent</dd>
        <dt>Location / title</dt>
        <dd>@(string.IsNullOrWhiteSpace(row.LocationOrTitle) ? "—" : row.LocationOrTitle)</dd>
      </dl>
    </div>
  </section>

  <section class="as-section">
    <header class="as-section__head">
      <div class="as-section__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
      </div>
      <div class="as-section__title-wrap">
        <h2 class="as-section__title">Notes</h2>
      </div>
    </header>
    <div class="as-section__body">
      <p style="margin:0;font-size:.95rem;line-height:1.65;color:var(--as-ink);white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(row.Details) ? "— No additional details provided." : row.Details)</p>
    </div>
  </section>
</div>
