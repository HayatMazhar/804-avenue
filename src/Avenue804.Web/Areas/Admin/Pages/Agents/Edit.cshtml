@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.Agents.EditModel
@{
    ViewData["Title"] = "Edit agent";
    ViewData["AdminSection"] = "agents";
    var initial = string.IsNullOrWhiteSpace(Model.Form.Name) ? "?" : Model.Form.Name.Trim()[0].ToString().ToUpperInvariant();
}

<div class="admin-back"><a asp-page="Index">← Agents</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">@(string.IsNullOrWhiteSpace(Model.Form.Name) ? "Edit agent" : Model.Form.Name)</h1>
      <p class="as-form-page__sub">Update contact details, photo, bio and Agent-Portal access.</p>
    </div>
    <div class="as-form-page__pill" style="background:@(Model.Form.IsActive ? "var(--as-accent-08)" : "var(--as-soft)");border-color:@(Model.Form.IsActive ? "var(--as-accent-50,rgba(245,158,11,.4))" : "var(--as-border)");color:@(Model.Form.IsActive ? "var(--as-accent)" : "var(--as-mute)");">
      @(Model.Form.IsActive ? "Active" : "Inactive")
    </div>
  </header>

  <form method="post">
    <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Identity</h2>
          <p class="as-section__sub">Display name and job title shown on listings &amp; the Agents page.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row" style="grid-template-columns:80px 1fr;align-items:center;">
          <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#fb923c);color:#0b1220;display:grid;place-items:center;font-family:'DM Serif Display',serif;font-size:1.8rem;font-weight:700;box-shadow:0 8px 16px rgba(245,158,11,.35);overflow:hidden;">
            @if (!string.IsNullOrWhiteSpace(Model.Form.AvatarUrl))
            { <img src="@Model.Form.AvatarUrl" alt="@Model.Form.Name" style="width:100%;height:100%;object-fit:cover;" /> }
            else { @initial }
          </div>
          <div class="as-field">
            <label asp-for="Form.AvatarUrl">Photo URL</label>
            <input asp-for="Form.AvatarUrl" type="url" placeholder="https://…/agent-photo.jpg" />
            <p class="as-field-hint">Square image, 400×400 ideal.</p>
          </div>
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="Form.Name">Full name <span class="req">*</span></label>
            <input asp-for="Form.Name" />
          </div>
          <div class="as-field">
            <label asp-for="Form.Title">Job title</label>
            <input asp-for="Form.Title" placeholder="e.g. Senior Property Consultant" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="Form.Bio">Bio</label>
          <textarea asp-for="Form.Bio" rows="3" placeholder="Short bio shown on the public agent profile."></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Contact channels</h2>
          <p class="as-section__sub">Phone, email and WhatsApp — used for the "Contact agent" buttons.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="Form.Phone">Phone</label>
            <input asp-for="Form.Phone" type="tel" placeholder="+971 2 000 0000" />
          </div>
          <div class="as-field">
            <label asp-for="Form.Email">Email</label>
            <input asp-for="Form.Email" type="email" placeholder="agent@804avenue.ae" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="Form.WhatsAppNumber">WhatsApp number</label>
          <input asp-for="Form.WhatsAppNumber" type="tel" placeholder="+971 50 000 0000" />
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Performance &amp; SLA</h2>
          <p class="as-section__sub">Shown as trust signals on the agent profile.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="Form.ResponseTime">Response time</label>
            <input asp-for="Form.ResponseTime" placeholder="e.g. Within 2 hours" />
          </div>
          <div class="as-field">
            <label asp-for="Form.ResponseRatePct">Response rate (%)</label>
            <input asp-for="Form.ResponseRatePct" type="number" min="0" max="100" placeholder="0–100" />
          </div>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Portal access &amp; visibility</h2>
          <p class="as-section__sub">Link to a user account so the agent can manage their own listings &amp; leads.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="Form.UserId">Linked user account</label>
          <input asp-for="Form.UserId" placeholder="Paste the user's email or ID" />
          <p class="as-field-hint">Once linked, this user can access <code>/AgentPortal</code> to manage listings and leads.</p>
        </div>
        <label class="as-toggle">
          <input asp-for="Form.IsActive" />
          <span class="as-toggle__switch"></span>
          <span class="as-toggle__text">
            <span class="as-toggle__title">Active agent</span>
            <span class="as-toggle__sub">Inactive agents are hidden from the public directory.</span>
          </span>
        </label>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info">
        <span class="dot" style="background:@(Model.Form.IsActive ? "var(--as-success)" : "var(--as-mute)");"></span>
        @(Model.Form.IsActive ? "Visible on the public agent directory" : "Hidden from public directory")
      </div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Save changes
        </button>
      </div>
    </footer>
  </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
