@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.PropertyInquiries.DetailModel
@using Avenue804.Web.Domain
@{
    ViewData["Title"] = "Property inquiry";
    ViewData["AdminSection"] = "property-inquiries";
    var row = Model.Row!;
    var initial = string.IsNullOrWhiteSpace(row.Name) ? "?" : row.Name.Trim()[0].ToString().ToUpperInvariant();
    var statusBadge = row.Status switch
    {
        InquiryStatus.New => ("badge-new", "New"),
        InquiryStatus.InProgress => ("badge-progress", "In progress"),
        _ => ("badge-closed", "Closed")
    };
}

<div class="admin-back"><a asp-page="Index">← Property inquiries</a></div>

<div class="as-form-page">
  <!-- Hero -->
  <div class="as-detail-hero">
    <div class="as-detail-hero__main">
      <div class="as-detail-hero__avatar">@initial</div>
      <div>
        <h1 class="as-detail-hero__title">@row.Name</h1>
        <p class="as-detail-hero__sub">
          <a href="mailto:@row.Email" class="link-accent">@row.Email</a>
          @if (!string.IsNullOrWhiteSpace(row.Phone)) { <span> · </span> <a href="tel:@row.Phone" class="link-accent">@row.Phone</a> }
          <span> · </span> <span>@row.CreatedAt.LocalDateTime.ToString("dd MMM yyyy · HH:mm")</span>
        </p>
      </div>
    </div>
    <div class="as-detail-hero__actions">
      <span class="badge @statusBadge.Item1">@statusBadge.Item2</span>
      @if (!string.IsNullOrWhiteSpace(row.Phone)) {
        <a class="as-btn as-btn--ghost" href="tel:@row.Phone">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Call
        </a>
      }
      <a class="as-btn as-btn--primary" href="mailto:@row.Email">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Reply by email
      </a>
    </div>
  </div>

  <!-- Inquiry detail -->
  <section class="as-section">
    <header class="as-section__head">
      <div class="as-section__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="as-section__title-wrap">
        <h2 class="as-section__title">What they're looking for</h2>
        <p class="as-section__sub">Submitted from the public Property Inquiry modal.</p>
      </div>
    </header>
    <div class="as-section__body">
      <dl class="detail-dl">
        <dt>I want to</dt>
        <dd>@(row.WantToLookup?.DisplayName ?? "—")</dd>
        <dt>Property type</dt>
        <dd>@(row.PropertyTypeLookup?.DisplayName ?? "—")</dd>
        <dt>Property details</dt>
        <dd>@(row.PropertyDetailLookup?.DisplayName ?? "—")</dd>
        <dt>Requirement details</dt>
        <dd>@(string.IsNullOrWhiteSpace(row.RequirementDetails) ? "—" : row.RequirementDetails)</dd>
        <dt>Area</dt>
        <dd>@(string.IsNullOrWhiteSpace(row.Area) ? "—" : row.Area)</dd>
        <dt>Budget</dt>
        <dd>@(row.BudgetLookup?.DisplayName ?? "—")</dd>
        <dt>Move-in date</dt>
        <dd>@(row.ExpectedMoveInDate?.ToString("d") ?? "—")</dd>
        @if (row.IAmLookup != null) { <dt>I am (legacy)</dt> <dd>@row.IAmLookup.DisplayName</dd> }
        @if (row.LocationLookup != null) { <dt>Location (legacy)</dt> <dd>@row.LocationLookup.DisplayName</dd> }
        @if (!string.IsNullOrWhiteSpace(row.OtherDetails)) { <dt>Other details</dt> <dd>@row.OtherDetails</dd> }
      </dl>
    </div>
  </section>

  <!-- Status update -->
  <form method="post">
    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Update status</h2>
          <p class="as-section__sub">Move this inquiry through the workflow as you action it.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field" style="max-width:280px;">
          <label asp-for="Status">Status</label>
          <select asp-for="Status" asp-items="Html.GetEnumSelectList<InquiryStatus>()"></select>
        </div>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info"><span class="dot" style="background:var(--as-accent);"></span>Saving updates the inquiry list immediately.</div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Back to list</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Save status
        </button>
      </div>
    </footer>
  </form>
</div>
