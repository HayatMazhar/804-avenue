@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.PropertyInquiries.DetailModel
@using Avenue804.Web.Domain
@{
    ViewData["Title"] = "Property inquiry";
    var row = Model.Row!;
}
<p style="margin-bottom:20px"><a asp-page="Index" style="color:var(--accent);font-weight:600">← Property inquiries</a></p>
<div class="detail-block">
  <h3>@row.Name</h3>
  <dl class="detail-dl">
    <dt>Email</dt>
    <dd><a href="mailto:@row.Email">@row.Email</a></dd>
    <dt>Mobile</dt>
    <dd>@row.Phone</dd>
    <dt>I want to</dt>
    <dd>@(row.WantToLookup?.DisplayName ?? "—")</dd>
    <dt>Property type</dt>
    <dd>@(row.PropertyTypeLookup?.DisplayName ?? "—")</dd>
    <dt>Property details</dt>
    <dd>@(row.PropertyDetailLookup?.DisplayName ?? "—")</dd>
    <dt>Requirement details</dt>
    <dd>@(string.IsNullOrWhiteSpace(row.RequirementDetails) ? "—" : row.RequirementDetails)</dd>
    <dt>Area</dt>
    <dd>@(string.IsNullOrWhiteSpace(row.Area) ? "—" : row.Area)</dd>
    <dt>Budget</dt>
    <dd>@(row.BudgetLookup?.DisplayName ?? "—")</dd>
    <dt>Expected move-in date</dt>
    <dd>@(row.ExpectedMoveInDate?.ToString("d") ?? "—")</dd>
    @if (row.IAmLookup != null)
    {
      <dt>I am (legacy)</dt>
      <dd>@row.IAmLookup.DisplayName</dd>
    }
    @if (row.LocationLookup != null)
    {
      <dt>Location (legacy)</dt>
      <dd>@row.LocationLookup.DisplayName</dd>
    }
    @if (!string.IsNullOrWhiteSpace(row.OtherDetails))
    {
      <dt>Other details (legacy)</dt>
      <dd>@row.OtherDetails</dd>
    }
    <dt>Received</dt>
    <dd>@row.CreatedAt.LocalDateTime.ToString("f")</dd>
  </dl>
</div>
<form method="post" class="admin-form" style="max-width:360px">
  <div class="row">
    <label asp-for="Status">Status</label>
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<InquiryStatus>()"></select>
  </div>
  <button type="submit" class="btn-primary"><span>Save status</span></button>
</form>
