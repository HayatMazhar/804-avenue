@page
@model Avenue804.Web.Areas.Admin.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "New project";
}
<p class="admin-back"><a asp-page="Index">← Projects</a></p>
<form method="post" class="admin-form">
  <div class="row">
    <label asp-for="Form.Title"></label>
    <input asp-for="Form.Title" />
    <span asp-validation-for="Form.Title" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.Slug">Slug (optional)</label>
    <input asp-for="Form.Slug" placeholder="auto from title" />
  </div>
  <div class="row">
    <label asp-for="Form.Summary"></label>
    <textarea asp-for="Form.Summary" class="admin-textarea-short"></textarea>
  </div>
  <div class="row">
    <label asp-for="Form.Description"></label>
    <textarea asp-for="Form.Description"></textarea>
  </div>
  <div class="row">
    <label asp-for="Form.CoverImageUrl"></label>
    <input asp-for="Form.CoverImageUrl" />
  </div>
  <div class="row chk">
    <input asp-for="Form.IsPublished" />
    <label asp-for="Form.IsPublished" class="admin-label-inline">Published</label>
  </div>
  <button type="submit" class="btn-primary"><span>Create</span></button>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
