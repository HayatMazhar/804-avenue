@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.Projects.EditModel
@{
    ViewData["Title"] = "Edit project";
    ViewData["AdminSection"] = "projects";
}

<div class="admin-back"><a asp-page="Index">← Projects</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">@(string.IsNullOrWhiteSpace(Model.Form.Title) ? "Edit project" : Model.Form.Title)</h1>
      <p class="as-form-page__sub">Update the public project profile — summary, description, cover image and visibility.</p>
    </div>
    <div class="as-form-page__pill" style="background:@(Model.Form.IsPublished ? "var(--as-accent-08)" : "var(--as-soft)");border-color:@(Model.Form.IsPublished ? "var(--as-accent-50,rgba(245,158,11,.4))" : "var(--as-border)");color:@(Model.Form.IsPublished ? "var(--as-accent)" : "var(--as-mute)");">
      @(Model.Form.IsPublished ? "Live" : "Draft")
    </div>
  </header>

  <form method="post">
    <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Basics</h2>
          <p class="as-section__sub">Project title, slug and short summary.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="Form.Title">Project title <span class="req">*</span></label>
          <input asp-for="Form.Title" />
          <span asp-validation-for="Form.Title" class="field-validation-error"></span>
        </div>
        <div class="as-field">
          <label asp-for="Form.Slug">URL slug</label>
          <input asp-for="Form.Slug" placeholder="auto-generated from title if blank" />
        </div>
        <div class="as-field">
          <label asp-for="Form.Summary">Short summary</label>
          <textarea asp-for="Form.Summary" rows="2" placeholder="One-line teaser shown on the project card."></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Description</h2>
          <p class="as-section__sub">Long-form description shown on the public project page.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="Form.Description">Description</label>
          <textarea asp-for="Form.Description" rows="6"></textarea>
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Cover image</h2>
          <p class="as-section__sub">Hero photo used on the project card and detail page.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-field">
          <label asp-for="Form.CoverImageUrl">Cover image URL</label>
          <input asp-for="Form.CoverImageUrl" placeholder="https://…/cover.jpg" />
          @if (!string.IsNullOrWhiteSpace(Model.Form.CoverImageUrl))
          {
            <img src="@Model.Form.CoverImageUrl" alt="Cover" class="img-preview-thumb" style="margin-top:8px;" />
          }
        </div>
      </div>
    </section>

    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Visibility</h2>
          <p class="as-section__sub">Control whether the project is visible on the public site.</p>
        </div>
      </header>
      <div class="as-section__body">
        <label class="as-toggle">
          <input asp-for="Form.IsPublished" />
          <span class="as-toggle__switch"></span>
          <span class="as-toggle__text">
            <span class="as-toggle__title">Published</span>
            <span class="as-toggle__sub">Visible on the public Projects page as soon as you save.</span>
          </span>
        </label>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info">
        <span class="dot" style="background:@(Model.Form.IsPublished ? "var(--as-success)" : "var(--as-mute)");"></span>
        @(Model.Form.IsPublished ? "Live on the public site" : "Currently in draft")
      </div>
      <div class="as-form-foot__actions">
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Save changes
        </button>
      </div>
    </footer>
  </form>

  <form method="post" asp-page-handler="Delete" class="as-danger-zone" onsubmit="return confirm('Delete this project? This cannot be undone.');">
    <div class="as-danger-zone__text">
      <p class="as-danger-zone__title">Delete this project</p>
      <p class="as-danger-zone__sub">Permanently removes the project and any progress updates linked to it.</p>
    </div>
    <button type="submit" class="as-btn as-btn--danger">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 01-2 2H9a2 2 0 01-2-2L5 6"/></svg>
      Delete project
    </button>
  </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
