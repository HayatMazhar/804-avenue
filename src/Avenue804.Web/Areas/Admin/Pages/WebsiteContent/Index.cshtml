@page
@model Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel
@{
    ViewData["Title"] = "Page Content";
    ViewData["AdminSub"] = "Edit every public-facing page in one place.";
}

<style>
  .as-wc__img{display:flex;gap:14px;align-items:flex-start}
  .as-wc__img-preview{width:84px;height:84px;border-radius:12px;object-fit:cover;border:1px solid var(--as-border,#e5e7eb);background:#f1f5f9;flex:none}
  .as-wc__img-controls{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px}
  .as-wc__file{font-size:.82rem;color:var(--as-mute,#64748b)}
  .as-wc__file::file-selector-button{margin-right:10px;padding:7px 12px;border-radius:8px;border:1px solid var(--as-border,#e5e7eb);background:#fff;font-weight:600;font-size:.8rem;cursor:pointer;color:var(--as-ink,#0f172a)}
  .as-wc__file::file-selector-button:hover{background:#f8fafc}
</style>

<div class="as-wc">

  <!-- ─── Sidebar tabs (one entry per public page) ─── -->
  <nav class="as-wc__nav" aria-label="Page picker">
    <p class="as-wc__navtitle">Brand</p>
    <button type="button" class="as-wc__tab is-active" data-tab="branding">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20"/></svg>
      Brand &amp; contact
      <span class="as-wc__tab-count">@Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel.BrandingFields.Count</span>
    </button>

    <p class="as-wc__navtitle" style="margin-top:8px;">Public pages</p>
    @foreach (var pg in Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel.ContentPages)
    {
      <button type="button" class="as-wc__tab" data-tab="@pg.Id">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        @pg.Title
        <span class="as-wc__tab-count">@pg.Fields.Count</span>
      </button>
    }

    @if (Model.OrphanFields.Count > 0)
    {
      <p class="as-wc__navtitle" style="margin-top:8px;">Other</p>
      <button type="button" class="as-wc__tab" data-tab="page-other">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        Unwired blocks
        <span class="as-wc__tab-count">@Model.OrphanFields.Count</span>
      </button>
    }
  </nav>

  <!-- ─── Panels ─────────────────────────────────────── -->
  <div>

    <!-- ── Brand & contact panel ── -->
    <section class="as-wc__panel is-active" data-panel="branding" id="branding">
      <div class="as-wc__panel-head">
        <div class="as-wc__panel-info">
          <h2 class="as-wc__panel-title">Brand &amp; contact</h2>
          <p class="as-wc__panel-sub">Company name, phone, email, social URLs and other details that appear in the navigation, footer and metadata across the entire site.</p>
        </div>
      </div>
      <form method="post" asp-page-handler="Branding" class="as-wc__form">
        <div class="as-wc__fields">
          @{ var fpairs = Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel.BrandingFields.Select((f, i) => new { F = f, I = i }).ToList(); }
          @for (int i = 0; i < fpairs.Count; i += 2)
          {
            <div class="as-wc__row">
              @{
                var a = fpairs[i].F;
                var aVal = Model.Settings.TryGetValue(a.Key, out var aS) ? aS.Value : "";
              }
              <div class="as-wc__field">
                <label class="as-wc__label">@a.Label</label>
                <input type="text" name="ss_@a.Key" value="@aVal" class="as-wc__input" placeholder="@a.Label" />
                @if (!string.IsNullOrWhiteSpace(a.Hint)) { <span class="as-wc__hint">@a.Hint</span> }
              </div>
              @if (i + 1 < fpairs.Count)
              {
                var b = fpairs[i + 1].F;
                var bVal = Model.Settings.TryGetValue(b.Key, out var bS) ? bS.Value : "";
                <div class="as-wc__field">
                  <label class="as-wc__label">@b.Label</label>
                  <input type="text" name="ss_@b.Key" value="@bVal" class="as-wc__input" placeholder="@b.Label" />
                  @if (!string.IsNullOrWhiteSpace(b.Hint)) { <span class="as-wc__hint">@b.Hint</span> }
                </div>
              }
              else
              {
                <div></div>
              }
            </div>
          }
        </div>
        <div class="as-wc__sticky-bar">
          <span class="as-wc__sticky-info">@Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel.BrandingFields.Count fields · changes are global.</span>
          <button type="submit" class="as-btn as-btn--primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Save brand settings
          </button>
        </div>
      </form>
    </section>

    <!-- ── Orphan / unwired blocks panel ── -->
    @if (Model.OrphanFields.Count > 0)
    {
      <section class="as-wc__panel" data-panel="page-other" id="page-other">
        <div class="as-wc__panel-head">
          <div class="as-wc__panel-info">
            <h2 class="as-wc__panel-title">Unwired content blocks</h2>
            <p class="as-wc__panel-sub">
              These slugs exist in the database but aren't yet mapped to a public page tab.
              Edit them here as a fallback, then ask a developer to add them to the page editor with a friendly label.
            </p>
          </div>
          <span class="as-wc__preview" style="background:var(--as-soft);color:var(--as-mute);border-color:var(--as-border);">
            @Model.OrphanFields.Count fallback field@(Model.OrphanFields.Count == 1 ? "" : "s")
          </span>
        </div>
        <form method="post" asp-page-handler="Content" class="as-wc__form">
          <input type="hidden" name="__page" value="page-other" />
          <div class="as-wc__fields">
            @foreach (var field in Model.OrphanFields)
            {
              var formKey = "cb_" + field.Slug.Replace('.', '_');
              var body = Model.BlockBodies.TryGetValue(field.Slug, out var b) ? b : "";
              <div class="as-wc__field">
                <label class="as-wc__label">@field.Label</label>
                <textarea name="@formKey" class="as-wc__textarea" rows="3" placeholder="@field.Slug">@body</textarea>
                <span class="as-wc__hint">@field.Hint · slug: @field.Slug</span>
              </div>
            }
          </div>
          <div class="as-wc__sticky-bar">
            <span class="as-wc__sticky-info">@Model.OrphanFields.Count unmapped block(s).</span>
            <button type="submit" class="as-btn as-btn--primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Save unwired blocks
            </button>
          </div>
        </form>
      </section>
    }

    <!-- ── Per-page panels ── -->
    @foreach (var pg in Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel.ContentPages)
    {
      <section class="as-wc__panel" data-panel="@pg.Id" id="@pg.Id">
        <div class="as-wc__panel-head">
          <div class="as-wc__panel-info">
            <h2 class="as-wc__panel-title">@pg.Title</h2>
            <p class="as-wc__panel-sub">@pg.Description</p>
          </div>
          @if (!string.IsNullOrWhiteSpace(pg.PreviewUrl))
          {
            <a class="as-wc__preview" href="@pg.PreviewUrl" target="_blank" rel="noopener">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              Preview @pg.PreviewUrl
            </a>
          }
        </div>
        <form method="post" asp-page-handler="Content" class="as-wc__form" enctype="multipart/form-data">
          <input type="hidden" name="__page" value="@pg.Id" />
          <div class="as-wc__fields">
            @foreach (var field in pg.Fields)
            {
              var formKey = "cb_" + field.Slug.Replace('.', '_');
              var body = Model.BlockBodies.TryGetValue(field.Slug, out var b) ? b : "";
              <div class="as-wc__field">
                <label class="as-wc__label">@field.Label</label>
                @if (field.IsImage)
                {
                  var fileKey = "file_" + field.Slug.Replace('.', '_');
                  <div class="as-wc__img">
                    <img class="as-wc__img-preview" src="@(string.IsNullOrWhiteSpace(body) ? "/assets/img/team/ceo-placeholder.svg" : body)" alt="Preview" />
                    <div class="as-wc__img-controls">
                      <input type="file" name="@fileKey" accept="image/*" class="as-wc__file" />
                      <input type="text" name="@formKey" value="@body" class="as-wc__input" placeholder="…or paste an image URL / path" />
                    </div>
                  </div>
                }
                else if (field.IsTextarea)
                {
                  <textarea name="@formKey" class="as-wc__textarea" rows="4" placeholder="@field.Label">@body</textarea>
                }
                else
                {
                  <input type="text" name="@formKey" value="@body" class="as-wc__input" placeholder="@field.Label" />
                }
                @if (!string.IsNullOrWhiteSpace(field.Hint))
                {
                  <span class="as-wc__hint">@field.Hint · slug: @field.Slug</span>
                }
                else
                {
                  <span class="as-wc__hint">slug: @field.Slug</span>
                }
              </div>
            }
          </div>
          <div class="as-wc__sticky-bar">
            <span class="as-wc__sticky-info">@pg.Fields.Count fields on this page.</span>
            <button type="submit" class="as-btn as-btn--primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Save @pg.Title
            </button>
          </div>
        </form>
      </section>
    }
  </div>
</div>

@section Scripts {
<script>
(function () {
  var tabs = document.querySelectorAll('.as-wc__tab');
  var panels = document.querySelectorAll('.as-wc__panel');

  function activate(id, push) {
    tabs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-tab') === id); });
    panels.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-panel') === id); });
    if (push) {
      try { history.replaceState(null, '', '#' + id); } catch (_) { /* ignored */ }
    }
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var id = tab.getAttribute('data-tab');
      activate(id, true);
      var panel = document.querySelector('[data-panel="' + id + '"]');
      if (panel && panel.scrollIntoView) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Honour URL hash so dashboard quick-links land on the right tab.
  var hash = (location.hash || '').replace('#', '');
  if (hash && document.querySelector('[data-panel="' + hash + '"]')) {
    activate(hash, false);
  }

  window.addEventListener('hashchange', function () {
    var h = (location.hash || '').replace('#', '');
    if (h && document.querySelector('[data-panel="' + h + '"]')) activate(h, false);
  });
})();
</script>
}
