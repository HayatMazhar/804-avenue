@page
@model Avenue804.Web.Areas.Admin.Pages.WebsiteContent.IndexModel
@{
    ViewData["Title"] = "Website Content";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="toast-admin ok" role="status">@Model.SuccessMessage</div>
}

<!-- ═══ TAB NAV ═══ -->
<div class="wc-tabs" id="wcTabs">
    <button class="wc-tab active" type="button" data-tab="branding">Site Branding</button>
    @foreach (var grp in IndexModel.ContentSections)
    {
        <button class="wc-tab" type="button" data-tab="@grp.Group.Replace(" ", "-").ToLower()">@grp.Group</button>
    }
</div>

<!-- ═══ BRANDING TAB ═══ -->
<div class="wc-panel active" data-panel="branding">
    <form method="post" asp-page-handler="Branding" class="wc-form">
        <p class="muted mb-3">Company details, contact info, and social links shown across the site.</p>
        <div class="wc-grid">
            @foreach (var (key, label) in IndexModel.BrandingFields)
            {
                var val = Model.Settings.TryGetValue(key, out var s) ? s.Value : "";
                <div class="wc-field">
                    <label class="wc-label">@label</label>
                    <input type="text" name="ss_@key" value="@val" class="wc-input" placeholder="@label" />
                    <span class="wc-slug">@key</span>
                </div>
            }
        </div>
        <div class="wc-actions">
            <button type="submit" class="btn-primary"><span>Save Branding</span></button>
        </div>
    </form>
</div>

<!-- ═══ CONTENT TABS ═══ -->
@foreach (var grp in IndexModel.ContentSections)
{
    var panelId = grp.Group.Replace(" ", "-").ToLower();
    <div class="wc-panel" data-panel="@panelId">
        <form method="post" asp-page-handler="Content" class="wc-form">
            <p class="muted mb-3">Edit the text and copy shown on the <strong>@grp.Group</strong>.</p>
            <div class="wc-fields-list">
                @foreach (var field in grp.Fields)
                {
                    var formKey = "cb_" + field.Slug.Replace('.', '_');
                    var body = Model.BlockBodies.TryGetValue(field.Slug, out var b) ? b : "";
                    <div class="wc-field wc-field--full">
                        <label class="wc-label">@field.Label</label>
                        @if (field.IsTextarea)
                        {
                            <textarea name="@formKey" class="wc-textarea" rows="5" placeholder="@field.Label">@body</textarea>
                        }
                        else
                        {
                            <input type="text" name="@formKey" value="@body" class="wc-input" placeholder="@field.Label" />
                        }
                        <span class="wc-slug">@field.Slug</span>
                    </div>
                }
            </div>
            <div class="wc-actions">
                <button type="submit" class="btn-primary"><span>Save @grp.Group</span></button>
            </div>
        </form>
    </div>
}

@section Scripts {
<style>
.wc-tabs { display: flex; gap: 0; border-bottom: 2px solid #e2e5e9; margin-bottom: 24px; flex-wrap: wrap; }
.wc-tab {
    padding: 10px 18px;
    font-family: var(--font-nav);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--text-tertiary);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    transition: color .15s, border-color .15s;
    white-space: nowrap;
}
.wc-tab:hover { color: var(--text-primary); }
.wc-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.wc-panel { display: none; }
.wc-panel.active { display: block; }
.wc-form { max-width: 900px; }
.wc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
.wc-fields-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; }
.wc-field { display: flex; flex-direction: column; gap: 4px; }
.wc-field--full { grid-column: 1 / -1; }
.wc-label { font-family: var(--font-nav); font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--text-secondary); }
.wc-slug { font-size: .6rem; color: var(--text-tertiary); font-family: monospace; }
.wc-input {
    width: 100%;
    padding: 9px 12px;
    border: 1.5px solid #e2e5e9;
    border-radius: 7px;
    font-family: var(--font-body);
    font-size: .84rem;
    color: var(--text-primary);
    background: #fff;
    transition: border-color .15s;
    box-sizing: border-box;
}
.wc-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-15); }
.wc-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1.5px solid #e2e5e9;
    border-radius: 7px;
    font-family: var(--font-body);
    font-size: .84rem;
    color: var(--text-primary);
    background: #fff;
    resize: vertical;
    min-height: 100px;
    line-height: 1.6;
    box-sizing: border-box;
}
.wc-textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-15); }
.wc-actions { padding-top: 8px; }
@@media (max-width: 640px) {
    .wc-grid { grid-template-columns: 1fr; }
    .wc-tabs { gap: 0; }
    .wc-tab { padding: 8px 12px; font-size: .65rem; }
}
</style>
<script>
(function() {
    var tabs = document.querySelectorAll('.wc-tab');
    var panels = document.querySelectorAll('.wc-panel');
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            tabs.forEach(function(t) { t.classList.remove('active'); });
            panels.forEach(function(p) { p.classList.remove('active'); });
            tab.classList.add('active');
            var target = tab.getAttribute('data-tab');
            var panel = document.querySelector('[data-panel="' + target + '"]');
            if (panel) panel.classList.add('active');
        });
    });
})();
</script>
}
