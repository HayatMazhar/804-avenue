@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greet = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.UtcNow - at;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return at.ToLocalTime().ToString("MMM d");
    }
    string DotKind(string k) => k switch
    {
        "property" => "as-feed__dot--info",
        "owner"    => "as-feed__dot--info",
        "service"  => "as-feed__dot--warn",
        "amc"      => "as-feed__dot--warn",
        _          => ""
    };
}

<!-- ─── Critical alerts ─────────────────────────── -->
@if (Model.OpenEmergencyTickets > 0)
{
  <div class="as-alert" role="alert">
    <div class="as-alert__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="as-alert__main">
      <h3 class="as-alert__title">@Model.OpenEmergencyTickets open emergency ticket@(Model.OpenEmergencyTickets == 1 ? "" : "s")</h3>
      <p class="as-alert__sub">A customer is waiting for an urgent response. Triage now to keep your SLA promise.</p>
    </div>
    <a class="as-alert__cta" asp-area="Admin" asp-page="/ServiceRequests/Index">
      Triage tickets
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
}
else if (Model.PendingRatingCount > 5)
{
  <div class="as-alert as-alert--warn" role="alert">
    <div class="as-alert__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    </div>
    <div class="as-alert__main">
      <h3 class="as-alert__title">@Model.PendingRatingCount reviews waiting for approval</h3>
      <p class="as-alert__sub">Approved reviews build trust on listing pages — clear the queue.</p>
    </div>
    <a class="as-alert__cta" asp-area="Admin" asp-page="/Ratings/Index">
      Review now
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
}

<!-- ─── Hero greeting ─────────────────────────────── -->
<div class="as-dash-hero">
  <div class="as-dash-hero__inner">
    <div>
      <div class="as-dash-hero__greet">@greet</div>
      <h2 class="as-dash-hero__h1">Here's what's happening today.</h2>
      <p class="as-dash-hero__sub">
        @Model.NewPropertyListingInquiryCount new property inquiries,
        @Model.NewServiceQuotes new contracting quotes,
        @Model.NewAmcRequests new AMC requests
        and @Model.UnreadNotifications unread notifications waiting for you.
      </p>
    </div>
    <div class="as-dash-hero__actions">
      <a class="as-btn as-btn--primary" asp-area="Admin" asp-page="/PropertyInquiries/Index">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        Property inquiries
      </a>
      <a class="as-btn as-btn--ghost" asp-area="Admin" asp-page="/WebsiteContent/Index">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Edit website
      </a>
    </div>
  </div>
</div>

<!-- ─── KPI cards ─────────────────────────────────── -->
<div class="as-kpis">
  <div class="as-kpi">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
      </span>
      @if (Model.NewPropertyListingInquiryCount > 0)
      { <span class="as-kpi__pill as-kpi__pill--new">@Model.NewPropertyListingInquiryCount NEW</span> }
    </div>
    <div class="as-kpi__num">@Model.PropertyListingInquiryCount</div>
    <div class="as-kpi__label">Property inquiries</div>
  </div>

  <div class="as-kpi">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
      </span>
      @if (Model.NewInquiryCount > 0)
      { <span class="as-kpi__pill as-kpi__pill--new">@Model.NewInquiryCount NEW</span> }
    </div>
    <div class="as-kpi__num">@Model.InquiryCount</div>
    <div class="as-kpi__label">Contact inquiries</div>
  </div>

  <div class="as-kpi as-kpi--warn">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      </span>
      @if (Model.NewServiceQuotes + Model.NewAmcRequests > 0)
      { <span class="as-kpi__pill as-kpi__pill--warn">@(Model.NewServiceQuotes + Model.NewAmcRequests) NEW</span> }
    </div>
    <div class="as-kpi__num">@(Model.NewServiceQuotes + Model.NewAmcRequests)</div>
    <div class="as-kpi__label">New service requests</div>
  </div>

  @if (Model.OpenEmergencyTickets > 0)
  {
    <div class="as-kpi as-kpi--danger">
      <div class="as-kpi__head">
        <span class="as-kpi__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <span class="as-kpi__pill as-kpi__pill--danger">URGENT</span>
      </div>
      <div class="as-kpi__num">@Model.OpenEmergencyTickets</div>
      <div class="as-kpi__label">Open emergency tickets</div>
    </div>
  }

  <div class="as-kpi">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      </span>
    </div>
    <div class="as-kpi__num">@Model.PublishedListings</div>
    <div class="as-kpi__label">Published listings</div>
  </div>

  <div class="as-kpi">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      </span>
    </div>
    <div class="as-kpi__num">@Model.PublicUserCount.ToString("N0")</div>
    <div class="as-kpi__label">Registered users</div>
  </div>

  <div class="as-kpi as-kpi--info">
    <div class="as-kpi__head">
      <span class="as-kpi__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </span>
    </div>
    <div class="as-kpi__num">@Model.TotalViews.ToString("N0")</div>
    <div class="as-kpi__label">Total listing views</div>
  </div>

  @if (Model.PendingRatingCount > 0)
  {
    <div class="as-kpi as-kpi--warn">
      <div class="as-kpi__head">
        <span class="as-kpi__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <span class="as-kpi__pill as-kpi__pill--warn">REVIEW</span>
      </div>
      <div class="as-kpi__num">@Model.PendingRatingCount</div>
      <div class="as-kpi__label">Reviews awaiting approval</div>
    </div>
  }
</div>

<!-- ─── Two-column: chart + activity ─────────────── -->
<div class="as-dash-grid">
  <div class="as-card">
    <div class="as-card__head">
      <div>
        <h3 class="as-card__title">Property inquiries — last 7 days</h3>
        <p class="as-card__sub">Daily volume from the public site.</p>
      </div>
      <a class="as-card__action" asp-area="Admin" asp-page="/PropertyInquiries/Index">View all →</a>
    </div>
    <div class="as-chart">
      <canvas id="inquiryChart" height="100"></canvas>
    </div>
  </div>

  <div class="as-card">
    <div class="as-card__head">
      <div>
        <h3 class="as-card__title">Recent activity</h3>
        <p class="as-card__sub">Latest things across all surfaces.</p>
      </div>
    </div>
    <div class="as-card__body as-card__body--flush">
      @if (Model.RecentActivity.Count == 0)
      {
        <div style="padding:28px;color:var(--as-mute);text-align:center;font-size:.85rem;">No recent activity yet.</div>
      }
      else
      {
        <ul class="as-feed">
          @foreach (var a in Model.RecentActivity)
          {
            <li class="as-feed__item">
              <span class="as-feed__dot @DotKind(a.Kind)">
                @switch (a.Kind)
                {
                  case "property":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
                    break;
                  case "contact":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                    break;
                  case "owner":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    break;
                  case "service":
                  case "amc":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                    break;
                  default:
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                    break;
                }
              </span>
              <div class="as-feed__main">
                <p class="as-feed__title">
                  @if (!string.IsNullOrWhiteSpace(a.Url)) { <a href="@a.Url">@a.Title</a> }
                  else { @a.Title }
                </p>
                <div class="as-feed__meta">@a.Meta · @Ago(a.At)</div>
              </div>
            </li>
          }
        </ul>
      }
    </div>
  </div>
</div>

<!-- ─── Page-content quick links ─────────────────── -->
<div class="as-card" style="margin-bottom:24px;">
  <div class="as-card__head">
    <div>
      <h3 class="as-card__title">Edit website content</h3>
      <p class="as-card__sub">Jump straight into the page you want to edit. All copy is CMS-driven.</p>
    </div>
    <a class="as-card__action" asp-area="Admin" asp-page="/WebsiteContent/Index">Open editor →</a>
  </div>
  <div class="as-card__body">
    <div class="as-quick-grid">
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-home">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg></span>
        <div><div class="as-quick__name">Home page</div><div class="as-quick__sub">Hero, about, CTA</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-services">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg></span>
        <div><div class="as-quick__name">Services hub</div><div class="as-quick__sub">/Services page</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-about">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0113 0"/></svg></span>
        <div><div class="as-quick__name">About</div><div class="as-quick__sub">Story, vision, team</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-contracting">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></span>
        <div><div class="as-quick__name">Contracting</div><div class="as-quick__sub">Service detail page</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-maintenance">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg></span>
        <div><div class="as-quick__name">Maintenance</div><div class="as-quick__sub">Service detail page</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="page-facility">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg></span>
        <div><div class="as-quick__name">Facility Mgmt</div><div class="as-quick__sub">Service detail page</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/WebsiteContent/Index" asp-fragment="branding">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20"/></svg></span>
        <div><div class="as-quick__name">Brand &amp; contact</div><div class="as-quick__sub">Phone, email, socials</div></div>
      </a>
      <a class="as-quick" asp-area="Admin" asp-page="/Lookups/Index">
        <span class="as-quick__icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg></span>
        <div><div class="as-quick__name">Lookups</div><div class="as-quick__sub">Filters &amp; categories</div></div>
      </a>
    </div>
  </div>
</div>

<!-- ─── Top listings ─────────────────────────────── -->
@if (Model.TopListings.Count > 0)
{
  <div class="as-card">
    <div class="as-card__head">
      <div>
        <h3 class="as-card__title">Top properties by views</h3>
        <p class="as-card__sub">Your best-performing listings right now.</p>
      </div>
      <a class="as-card__action" asp-area="Admin" asp-page="/Listings/Index">All listings →</a>
    </div>
    <div class="as-card__body as-card__body--flush">
      <table class="admin-table">
        <thead><tr><th style="width:40px;">#</th><th>Property</th><th>Type</th><th style="width:90px;text-align:right;">Views</th></tr></thead>
        <tbody>
          @for (int i = 0; i < Model.TopListings.Count; i++)
          {
            var p = Model.TopListings[i];
            <tr>
              <td><strong style="color:var(--as-accent);">@(i + 1)</strong></td>
              <td><a asp-area="" asp-page="/Properties/Detail" asp-route-slug="@p.Slug">@p.Title</a></td>
              <td>@(p.OfferType == Avenue804.Web.Domain.ListingOfferType.Sale ? "For sale" : "For rent")</td>
              <td style="text-align:right;"><strong>@p.ViewCount.ToString("N0")</strong></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
  var data = @Html.Raw(Model.InquiryChartJson);
  var ctx = document.getElementById('inquiryChart');
  if (!ctx || !data) return;
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: data.labels,
      datasets: [{
        label: 'Inquiries',
        data: data.data,
        backgroundColor: 'rgba(245,158,11,0.30)',
        borderColor: 'rgba(245,158,11,0.95)',
        borderWidth: 2,
        borderRadius: 6,
        maxBarThickness: 36
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0b1220', titleColor: '#fff', bodyColor: '#fff', cornerRadius: 8, padding: 10 } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1, color: '#64748B', font:{size:11} }, grid: { color: 'rgba(15,23,42,.06)' } },
        x: { ticks: { color: '#64748B', font:{size:11} }, grid: { display: false } }
      }
    }
  });
})();
</script>
}
