@page
@model Avenue804.Web.Areas.Admin.Pages.Manual.IndexModel
@{
    ViewData["Title"] = "User Manuals";
    ViewData["AdminSection"] = "manual";
}

<style>
  .mln-hero {
    background: linear-gradient(135deg, #0b1220 0%, #11203b 50%, #0f172a 100%);
    color: #fff;
    border-radius: 16px;
    padding: 40px 36px;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
  }
  .mln-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.05) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
  }
  .mln-hero > * { position: relative; z-index: 2; }
  .mln-hero__eyebrow {
    display: inline-block;
    background: rgba(245,158,11,.18);
    color: #fbbf24;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 14px;
  }
  .mln-hero__title {
    font-family: 'DM Serif Display', serif;
    font-size: 2.1rem;
    font-weight: 700;
    margin: 0 0 8px;
    letter-spacing: -.02em;
  }
  .mln-hero__title em {
    font-style: normal;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .mln-hero__sub {
    font-size: .98rem;
    color: rgba(255,255,255,.7);
    margin: 0;
    max-width: 640px;
  }

  .mln-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @@media (max-width: 800px) { .mln-cards { grid-template-columns: 1fr; } }

  .mln-card {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e9ecef;
    padding: 28px 28px 24px;
    transition: transform .2s, box-shadow .2s, border-color .2s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .mln-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(8,15,35,.12);
    border-color: #fde68a;
    color: inherit;
  }
  .mln-card__icon {
    width: 56px; height: 56px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
  }
  .mln-card__icon--blue { background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1d4ed8; }
  .mln-card__icon--gold { background: linear-gradient(135deg, #fff8e1, #fed7aa); color: #d97706; }

  .mln-card__label {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #9ca3af;
    margin: 0 0 4px;
  }
  .mln-card__title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 10px;
    letter-spacing: -.01em;
  }
  .mln-card__desc {
    font-size: .88rem;
    color: #6c757d;
    line-height: 1.55;
    margin: 0 0 20px;
    flex: 1;
  }
  .mln-card__meta {
    display: flex;
    gap: 12px;
    font-size: .76rem;
    color: #6c757d;
    margin-bottom: 16px;
    padding-top: 14px;
    border-top: 1px solid #f1f3f5;
  }
  .mln-card__meta span { display: inline-flex; align-items: center; gap: 5px; }
  .mln-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: .85rem;
    color: #d97706;
    align-self: flex-start;
    transition: gap .15s;
  }
  .mln-card:hover .mln-card__cta { gap: 10px; }
  .mln-card__cta i { font-size: 1rem; }

  .mln-foot {
    margin-top: 24px;
    padding: 14px 18px;
    background: #f8f9fb;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    font-size: .82rem;
    color: #6c757d;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mln-foot i { color: #f59e0b; }
</style>

<!-- Hero -->
<div class="mln-hero">
  <span class="mln-hero__eyebrow">Documentation</span>
  <h2 class="mln-hero__title">User <em>Manuals</em></h2>
  <p class="mln-hero__sub">Detailed module-based guides for both the public website and the admin console. Click any card to explore.</p>
</div>

<!-- Two cards -->
<div class="mln-cards">

  <a asp-area="Admin" asp-page="/Manual/Website" class="mln-card">
    <div class="mln-card__icon mln-card__icon--blue">
      <i class="bi bi-globe2" style="font-size:1.8rem"></i>
    </div>
    <p class="mln-card__label">For Everyone</p>
    <h3 class="mln-card__title">Public Website Manual</h3>
    <p class="mln-card__desc">Complete guide for visitors &amp; registered users — how to search properties, submit inquiries, request services, manage your account and more.</p>
    <div class="mln-card__meta">
      <span><i class="bi bi-collection"></i> 16 modules</span>
      <span><i class="bi bi-people"></i> Visitors &amp; users</span>
    </div>
    <span class="mln-card__cta">Open manual <i class="bi bi-arrow-right"></i></span>
  </a>

  <a asp-area="Admin" asp-page="/Manual/Admin" class="mln-card">
    <div class="mln-card__icon mln-card__icon--gold">
      <i class="bi bi-shield-lock-fill" style="font-size:1.8rem"></i>
    </div>
    <p class="mln-card__label">Staff Only</p>
    <h3 class="mln-card__title">Admin Console Manual</h3>
    <p class="mln-card__desc">Full reference for administrators — managing listings, handling inquiries, CMS, users, settings, staff accounts, feature flags &amp; every module in the console.</p>
    <div class="mln-card__meta">
      <span><i class="bi bi-collection"></i> 25 modules</span>
      <span><i class="bi bi-shield-lock"></i> Restricted access</span>
    </div>
    <span class="mln-card__cta">Open manual <i class="bi bi-arrow-right"></i></span>
  </a>

</div>

<div class="mln-foot">
  <i class="bi bi-info-circle"></i>
  <span>Each manual is organised into focused modules with a sidebar for quick navigation, search, and step-by-step walkthroughs. For technical support, contact the development team.</span>
</div>
