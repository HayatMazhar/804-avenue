@section Scripts {
  <script>
  (function () {
    var sideItems = document.querySelectorAll('.man-side__item');
    var modules   = document.querySelectorAll('.man-mod');
    var search    = document.getElementById('manSearch');
    var mainPane  = document.querySelector('.man-main');

    function activate(modId, push) {
      var mod = document.getElementById('mod-' + modId);
      if (!mod) return;
      modules.forEach(function(m){ m.classList.remove('is-active'); });
      mod.classList.add('is-active');
      sideItems.forEach(function(b){
        b.classList.toggle('is-active', b.dataset.mod === modId);
      });
      if (push) history.replaceState(null, '', '#' + modId);
      if (mainPane) mainPane.scrollTop = 0;
    }

    sideItems.forEach(function(btn){
      btn.addEventListener('click', function(){
        activate(btn.dataset.mod, true);
      });
    });

    // URL hash → open module
    if (window.location.hash) {
      var target = window.location.hash.replace('#','');
      if (document.getElementById('mod-' + target)) activate(target, false);
    }

    // Search filter
    if (search) {
      search.addEventListener('input', function(){
        var q = search.value.trim().toLowerCase();
        sideItems.forEach(function(btn){
          var match = !q || btn.textContent.toLowerCase().includes(q);
          btn.classList.toggle('is-hidden', !match);
        });
      });
    }
  })();
  </script>
}
