@page
@model Avenue804.Web.Areas.Admin.Pages.Manual.AdminModel
@{
    ViewData["Title"] = "Admin Console Manual";
    ViewData["AdminSection"] = "manual";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/manual.css" asp-append-version="true" />
}

<div class="man-app">

  <!-- ── Sidebar ─────────────────────────────────────── -->
  <aside class="man-side">
    <div class="man-side__head">
      <a asp-area="Admin" asp-page="/Manual/Index" class="man-side__back">
        <i class="bi bi-arrow-left"></i> All Manuals
      </a>
      <h2 class="man-side__title">Admin Manual</h2>
      <p class="man-side__sub">Authorised staff only</p>
    </div>

    <div class="man-side__search">
      <input type="search" id="manSearch" placeholder="Search modules…" />
    </div>

    <nav class="man-side__nav" id="manNav">

      <p class="man-side__group-title">Getting Started</p>
      <button class="man-side__item is-active" data-mod="login">
        <i class="bi bi-door-open man-side__item-icon"></i> Login &amp; Access
        <span class="man-side__item-num">01</span>
      </button>
      <button class="man-side__item" data-mod="roles">
        <i class="bi bi-shield-lock man-side__item-icon"></i> Roles &amp; Credentials
        <span class="man-side__item-num">02</span>
      </button>
      <button class="man-side__item" data-mod="staff">
        <i class="bi bi-people man-side__item-icon"></i> Staff Accounts
        <span class="man-side__item-num">03</span>
      </button>
      <button class="man-side__item" data-mod="dashboard">
        <i class="bi bi-speedometer2 man-side__item-icon"></i> Dashboard
        <span class="man-side__item-num">04</span>
      </button>

      <p class="man-side__group-title">Properties &amp; Inquiries</p>
      <button class="man-side__item" data-mod="listings">
        <i class="bi bi-building man-side__item-icon"></i> Property Listings
        <span class="man-side__item-num">05</span>
      </button>
      <button class="man-side__item" data-mod="prop-inquiries">
        <i class="bi bi-chat-square-dots man-side__item-icon"></i> Property Inquiries
        <span class="man-side__item-num">06</span>
      </button>
      <button class="man-side__item" data-mod="gen-inquiries">
        <i class="bi bi-envelope man-side__item-icon"></i> General Inquiries
        <span class="man-side__item-num">07</span>
      </button>
      <button class="man-side__item" data-mod="owner-req">
        <i class="bi bi-house-add man-side__item-icon"></i> Owner Requests
        <span class="man-side__item-num">08</span>
      </button>

      <p class="man-side__group-title">Operations</p>
      <button class="man-side__item" data-mod="service-req">
        <i class="bi bi-tools man-side__item-icon"></i> Service Requests
        <span class="man-side__item-num">09</span>
      </button>
      <button class="man-side__item" data-mod="projects">
        <i class="bi bi-diagram-3 man-side__item-icon"></i> Projects &amp; Portfolio
        <span class="man-side__item-num">10</span>
      </button>
      <button class="man-side__item" data-mod="progress">
        <i class="bi bi-graph-up-arrow man-side__item-icon"></i> Project Progress
        <span class="man-side__item-num">11</span>
      </button>
      <button class="man-side__item" data-mod="reports">
        <i class="bi bi-clipboard-data man-side__item-icon"></i> Service Reports
        <span class="man-side__item-num">12</span>
      </button>

      <p class="man-side__group-title">Catalogue</p>
      <button class="man-side__item" data-mod="areas">
        <i class="bi bi-geo-alt man-side__item-icon"></i> Area Guides
        <span class="man-side__item-num">13</span>
      </button>
      <button class="man-side__item" data-mod="developers">
        <i class="bi bi-bricks man-side__item-icon"></i> Developers
        <span class="man-side__item-num">14</span>
      </button>
      <button class="man-side__item" data-mod="agents">
        <i class="bi bi-person-badge man-side__item-icon"></i> Agents
        <span class="man-side__item-num">15</span>
      </button>
      <button class="man-side__item" data-mod="testimonials">
        <i class="bi bi-chat-quote man-side__item-icon"></i> Testimonials
        <span class="man-side__item-num">16</span>
      </button>
      <button class="man-side__item" data-mod="ratings">
        <i class="bi bi-star man-side__item-icon"></i> Ratings &amp; Reviews
        <span class="man-side__item-num">17</span>
      </button>

      <p class="man-side__group-title">Content (CMS)</p>
      <button class="man-side__item" data-mod="cms">
        <i class="bi bi-layout-text-sidebar man-side__item-icon"></i> Website Content
        <span class="man-side__item-num">18</span>
      </button>
      <button class="man-side__item" data-mod="blocks">
        <i class="bi bi-grid-1x2 man-side__item-icon"></i> Content Blocks
        <span class="man-side__item-num">19</span>
      </button>

      <p class="man-side__group-title">System</p>
      <button class="man-side__item" data-mod="users">
        <i class="bi bi-person-lines-fill man-side__item-icon"></i> Public Users
        <span class="man-side__item-num">20</span>
      </button>
      <button class="man-side__item" data-mod="settings">
        <i class="bi bi-sliders man-side__item-icon"></i> Site Settings
        <span class="man-side__item-num">21</span>
      </button>
      <button class="man-side__item" data-mod="newsletter">
        <i class="bi bi-newspaper man-side__item-icon"></i> Newsletter
        <span class="man-side__item-num">22</span>
      </button>
      <button class="man-side__item" data-mod="lookups">
        <i class="bi bi-list-ul man-side__item-icon"></i> Lookups
        <span class="man-side__item-num">23</span>
      </button>
      <button class="man-side__item" data-mod="features">
        <i class="bi bi-toggles man-side__item-icon"></i> Feature Flags
        <span class="man-side__item-num">24</span>
      </button>
      <button class="man-side__item" data-mod="notifications">
        <i class="bi bi-bell man-side__item-icon"></i> Notifications
        <span class="man-side__item-num">25</span>
      </button>

    </nav>
  </aside>

  <!-- ── Main content ────────────────────────────────── -->
  <main class="man-main">

    <!-- ── 01 — Login & Access ──────────────────────────── -->
    <article class="man-mod is-active" id="mod-login">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-door-open" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 01</p>
          <h2 class="man-mod__hero-title">Login &amp; Access</h2>
          <p class="man-mod__hero-sub">How to access the Admin Console.</p>
        </div>
      </div>

      <p>The Admin Console is available at <span class="man-key">/Admin/Login</span>. Only users with a staff role can sign in.</p>

      <h3><i class="bi bi-1-circle"></i> Login Steps</h3>
      <div class="man-steps">
        <div class="man-step"><span class="man-step__num">1</span><span class="man-step__text">Navigate to <span class="man-key">804avenue.ae/Admin/Login</span></span></div>
        <div class="man-step"><span class="man-step__num">2</span><span class="man-step__text">Enter your <strong>Email</strong> &amp; <strong>Password</strong></span></div>
        <div class="man-step"><span class="man-step__num">3</span><span class="man-step__text">Click <strong>Sign in to Admin</strong> — you'll land on the Dashboard</span></div>
      </div>

      <h3><i class="bi bi-layout-sidebar"></i> Console Layout</h3>
      <table>
        <thead><tr><th>Area</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td>Left Sidebar</td><td>Main navigation grouped by function</td></tr>
          <tr><td>Top Bar</td><td>Breadcrumb, View Site button, notifications, log out</td></tr>
          <tr><td>Main Area</td><td>Tables, forms, dashboards for the current page</td></tr>
        </tbody>
      </table>

      <div class="man-callout man-callout--warn">
        <i class="bi bi-shield-exclamation"></i>
        <span>After <strong>5 failed attempts</strong> the account is locked for 15 minutes. Never share credentials.</span>
      </div>
    </article>

    <!-- ── 02 — Roles & Credentials ─────────────────────── -->
    <article class="man-mod" id="mod-roles">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-shield-lock" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 02</p>
          <h2 class="man-mod__hero-title">Roles &amp; Credentials</h2>
          <p class="man-mod__hero-sub">Default account and what each role can access.</p>
        </div>
      </div>

      <h3><i class="bi bi-key"></i> Default Admin Credentials</h3>
      <table>
        <tbody>
          <tr><td><strong>Email</strong></td><td><span class="man-key">admin&#64;804avenue.ae</span></td></tr>
          <tr><td><strong>Password</strong></td><td><span class="man-key">Avenue804!Admin#2026</span></td></tr>
          <tr><td><strong>Role</strong></td><td><span class="man-pill man-pill--red">Admin</span></td></tr>
        </tbody>
      </table>

      <div class="man-callout man-callout--warn">
        <i class="bi bi-exclamation-triangle"></i>
        <span>Change the default admin password immediately after first login — go to <strong>Staff Accounts → Reset PW</strong>.</span>
      </div>

      <h3><i class="bi bi-people-fill"></i> Available Roles</h3>
      <table>
        <thead><tr><th>Role</th><th>What they can access</th></tr></thead>
        <tbody>
          <tr><td><span class="man-pill man-pill--red">Admin</span></td><td>Full access — everything</td></tr>
          <tr><td><span class="man-pill man-pill--green">ContentEditor</span></td><td>Dashboard, CMS, Content Blocks, Area Guides, Testimonials, Projects, Progress, Agents, Developers, Notifications</td></tr>
          <tr><td><span class="man-pill man-pill--blue">PropertyManager</span></td><td>Dashboard, Listings, Agents, Developers, Property Inquiries, Owner Requests, Area Guides, Notifications</td></tr>
          <tr><td><span class="man-pill man-pill--orange">SupportAgent</span></td><td>Dashboard, Property Inquiries, General Inquiries, Owner Requests, Service Requests, Service Reports, Ratings, Notifications</td></tr>
        </tbody>
      </table>

      <h3><i class="bi bi-table"></i> Role Access Matrix</h3>
      <table>
        <thead><tr><th>Section</th><th>Admin</th><th>Editor</th><th>PropMgr</th><th>Support</th></tr></thead>
        <tbody>
          <tr><td>Dashboard / Notifications</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Website CMS / Content Blocks</td><td>✓</td><td>✓</td><td>—</td><td>—</td></tr>
          <tr><td>Listings</td><td>✓</td><td>—</td><td>✓</td><td>—</td></tr>
          <tr><td>Property Inquiries</td><td>✓</td><td>—</td><td>✓</td><td>✓</td></tr>
          <tr><td>General Inquiries</td><td>✓</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>Service Requests / Reports</td><td>✓</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>Owner Requests</td><td>✓</td><td>—</td><td>✓</td><td>✓</td></tr>
          <tr><td>Projects / Progress</td><td>✓</td><td>✓</td><td>—</td><td>—</td></tr>
          <tr><td>Area Guides / Testimonials</td><td>✓</td><td>✓</td><td>✓</td><td>—</td></tr>
          <tr><td>Agents / Developers</td><td>✓</td><td>✓</td><td>✓</td><td>—</td></tr>
          <tr><td>Ratings</td><td>✓</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>Public Users / Staff</td><td>✓</td><td>—</td><td>—</td><td>—</td></tr>
          <tr><td>Site Settings / Lookups / Features</td><td>✓</td><td>—</td><td>—</td><td>—</td></tr>
          <tr><td>Newsletter</td><td>✓</td><td>—</td><td>—</td><td>—</td></tr>
        </tbody>
      </table>
    </article>

    <!-- ── 03 — Staff Accounts ──────────────────────────── -->
    <article class="man-mod" id="mod-staff">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-people" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 03</p>
          <h2 class="man-mod__hero-title">Staff Accounts</h2>
          <p class="man-mod__hero-sub">Create &amp; manage staff who can access the admin console.</p>
        </div>
      </div>

      <p>Page: <span class="man-key">/Admin/Staff</span> (Admin role only).</p>

      <h3><i class="bi bi-person-plus"></i> Create a Staff Account</h3>
      <div class="man-steps">
        <div class="man-step"><span class="man-step__num">1</span><span class="man-step__text">Go to <strong>System → Staff Accounts</strong>.</span></div>
        <div class="man-step"><span class="man-step__num">2</span><span class="man-step__text">Scroll to the <strong>Create Staff Account</strong> form.</span></div>
        <div class="man-step"><span class="man-step__num">3</span><span class="man-step__text">Enter Name, Email, Password &amp; choose a <strong>Role</strong>.</span></div>
        <div class="man-step"><span class="man-step__num">4</span><span class="man-step__text">Click <strong>Create Account</strong> — share credentials with the staff member.</span></div>
      </div>

      <h3><i class="bi bi-arrow-repeat"></i> Change Role</h3>
      <p>In the staff table, use the <strong>Change Role</strong> dropdown then click <strong>Set</strong>. Effective on next page load.</p>

      <h3><i class="bi bi-key"></i> Reset Password</h3>
      <p>In the <strong>Reset PW</strong> column, type the new password then click <strong>Reset</strong>.</p>

      <h3><i class="bi bi-pause-circle"></i> Suspend / Delete</h3>
      <p><strong>Suspend</strong> blocks login while preserving the account. <strong>Activate</strong> restores access. <strong>Delete</strong> permanently removes the account.</p>

      <div class="man-callout man-callout--warn">
        <i class="bi bi-exclamation-triangle"></i>
        <span>You cannot suspend or delete your own admin account. When a staff member leaves, prefer <strong>Suspend</strong> over Delete to preserve audit history.</span>
      </div>
    </article>

    <!-- ── 04 — Dashboard ───────────────────────────────── -->
    <article class="man-mod" id="mod-dashboard">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-speedometer2" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 04</p>
          <h2 class="man-mod__hero-title">Dashboard</h2>
          <p class="man-mod__hero-sub">Real-time snapshot of the entire platform.</p>
        </div>
      </div>

      <p>The Dashboard at <span class="man-key">/Admin</span> is the first page after login.</p>

      <h3><i class="bi bi-bar-chart"></i> KPI Cards</h3>
      <table>
        <tbody>
          <tr><td>Property Inquiries</td><td>Total inquiries about listings</td></tr>
          <tr><td>General Inquiries</td><td>Contact form submissions</td></tr>
          <tr><td>Service Requests</td><td>Quote, maintenance &amp; AMC requests</td></tr>
          <tr><td>Published Listings</td><td>Live property listings</td></tr>
          <tr><td>Registered Users</td><td>Public user accounts</td></tr>
          <tr><td>Listing Views</td><td>Total views across all detail pages</td></tr>
          <tr><td>Pending Reviews</td><td>Ratings awaiting approval</td></tr>
          <tr><td>Emergency Tickets</td><td>Urgent maintenance (alert if &gt; 0)</td></tr>
        </tbody>
      </table>

      <h3><i class="bi bi-graph-up"></i> Other Sections</h3>
      <ul>
        <li><strong>7-Day Inquiry Chart</strong> — bar chart of inquiry volume</li>
        <li><strong>Recent Activity Feed</strong> — latest 10 events across all modules</li>
        <li><strong>CMS Quick Links</strong> — shortcuts to common content pages</li>
      </ul>
    </article>

    <!-- ── 05 — Listings ────────────────────────────────── -->
    <article class="man-mod" id="mod-listings">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-building" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 05</p>
          <h2 class="man-mod__hero-title">Property Listings</h2>
          <p class="man-mod__hero-sub">Create, edit &amp; publish properties.</p>
        </div>
      </div>

      <p>Manage at <span class="man-key">/Admin/Listings</span>.</p>

      <h3><i class="bi bi-plus-circle"></i> Create a Listing</h3>
      <div class="man-steps">
        <div class="man-step"><span class="man-step__num">1</span><span class="man-step__text">Click <strong>+ New Listing</strong></span></div>
        <div class="man-step"><span class="man-step__num">2</span><span class="man-step__text">Enter <strong>title, slug, offer type, price, currency</strong></span></div>
        <div class="man-step"><span class="man-step__num">3</span><span class="man-step__text">Set <strong>property type, beds, baths, area, floor, parking</strong></span></div>
        <div class="man-step"><span class="man-step__num">4</span><span class="man-step__text">Enter <strong>location</strong> using UAE areas autocomplete</span></div>
        <div class="man-step"><span class="man-step__num">5</span><span class="man-step__text">Write <strong>description</strong> &amp; upload main + gallery images</span></div>
        <div class="man-step"><span class="man-step__num">6</span><span class="man-step__text">Assign an <strong>agent</strong> &amp; set status (Draft / Published)</span></div>
        <div class="man-step"><span class="man-step__num">7</span><span class="man-step__text">Click <strong>Save Listing</strong></span></div>
      </div>

      <h3><i class="bi bi-upload"></i> Bulk Import &amp; Review</h3>
      <ul>
        <li><strong>Bulk Import</strong> (<span class="man-key">/Admin/Listings/BulkImport</span>) — upload a CSV file to create multiple listings</li>
        <li><strong>Review Queue</strong> (<span class="man-key">/Admin/Listings/Review</span>) — approve/reject owner-submitted listings before they go live</li>
      </ul>

      <h3><i class="bi bi-card-checklist"></i> Key Fields</h3>
      <table>
        <thead><tr><th>Field</th><th>Required</th></tr></thead>
        <tbody>
          <tr><td>Title, Slug, Offer Type, Price, Location, Main Image</td><td><span class="man-pill man-pill--green">Yes</span></td></tr>
          <tr><td>Description, Property Type, Beds/Baths/Area</td><td><span class="man-pill man-pill--blue">Recommended</span></td></tr>
          <tr><td>Previous Price (shows discount badge)</td><td><span class="man-pill man-pill--orange">Optional</span></td></tr>
          <tr><td>Is Featured (homepage strip)</td><td><span class="man-pill man-pill--orange">Optional</span></td></tr>
        </tbody>
      </table>
    </article>

    <!-- ── 06 — Property Inquiries ──────────────────────── -->
    <article class="man-mod" id="mod-prop-inquiries">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-chat-square-dots" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 06</p>
          <h2 class="man-mod__hero-title">Property Inquiries</h2>
          <p class="man-mod__hero-sub">Inquiries submitted about specific listings.</p>
        </div>
      </div>

      <p>Manage at <span class="man-key">/Admin/PropertyInquiries</span>.</p>

      <h3><i class="bi bi-list-columns"></i> What's Shown</h3>
      <ul>
        <li>Date, name, email, phone, linked listing, intent (Buy/Rent/Sell), budget, status</li>
      </ul>

      <h3><i class="bi bi-arrow-right-circle"></i> Workflow</h3>
      <div class="man-steps">
        <div class="man-step"><span class="man-step__num">1</span><span class="man-step__text">Click <strong>View</strong> on any row</span></div>
        <div class="man-step"><span class="man-step__num">2</span><span class="man-step__text">Review details &amp; the linked property</span></div>
        <div class="man-step"><span class="man-step__num">3</span><span class="man-step__text">Update <strong>Status</strong>: New → In Progress → Resolved</span></div>
        <div class="man-step"><span class="man-step__num">4</span><span class="man-step__text">Add internal <strong>notes</strong> &amp; contact the inquirer</span></div>
      </div>

      <p>Click <strong>Export CSV</strong> on the index page to download all inquiries.</p>
    </article>

    <!-- ── 07 — General Inquiries ───────────────────────── -->
    <article class="man-mod" id="mod-gen-inquiries">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-envelope" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 07</p>
          <h2 class="man-mod__hero-title">General Inquiries</h2>
          <p class="man-mod__hero-sub">Contact form submissions from the website.</p>
        </div>
      </div>

      <p>Page: <span class="man-key">/Admin/Inquiries</span>. Each entry shows date, name, email, phone, topic, and message. Click <strong>Detail</strong> to read the full message and update status.</p>

      <div class="man-callout man-callout--note">
        <i class="bi bi-info-circle"></i>
        <span>New general inquiries also send an email notification to <strong>info&#64;804avenue.ae</strong>.</span>
      </div>
    </article>

    <!-- ── 08 — Owner Requests ──────────────────────────── -->
    <article class="man-mod" id="mod-owner-req">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-house-add" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 08</p>
          <h2 class="man-mod__hero-title">Owner / Listing Requests</h2>
          <p class="man-mod__hero-sub">Properties submitted by users for listing.</p>
        </div>
      </div>

      <p>Page: <span class="man-key">/Admin/OwnerRequests</span>.</p>

      <div class="man-steps">
        <div class="man-step"><span class="man-step__num">1</span><span class="man-step__text">Open the request from the table</span></div>
        <div class="man-step"><span class="man-step__num">2</span><span class="man-step__text">Review property details &amp; photos</span></div>
        <div class="man-step"><span class="man-step__num">3</span><span class="man-step__text"><strong>Approve &amp; Create Listing</strong> — converts into editable listing</span></div>
        <div class="man-step"><span class="man-step__num">4</span><span class="man-step__text">Or <strong>Reject</strong> with an optional reason sent by email</span></div>
      </div>
    </article>

    <!-- ── 09 — Service Requests ────────────────────────── -->
    <article class="man-mod" id="mod-service-req">
      <div class="man-mod__hero">
        <div class="man-mod__hero-icon"><i class="bi bi-tools" style="font-size:1.6rem"></i></div>
        <div>
          <p class="man-mod__hero-eyebrow">Module 09</p>
          <h2 class="man-mod__hero-title">Service Requests</h2>
