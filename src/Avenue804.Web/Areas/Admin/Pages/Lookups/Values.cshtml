@page "{categoryId:int}"
@model Avenue804.Web.Areas.Admin.Pages.Lookups.ValuesModel
@{
    ViewData["Title"] = "Lookup values — " + Model.Category?.Name;
}
<p class="admin-back"><a asp-page="Index">← Lookups</a></p>
<h2 class="admin-lookup-cat-title"><code>@Model.Category?.Code</code></h2>
<div class="admin-table-wrap admin-table-wrap--mb">
  <table class="admin-table">
    <thead><tr><th>Code</th><th>Display</th><th>Sort</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
      <tr>
        <td><code>@r.Code</code></td>
        <td>@r.DisplayName</td>
        <td>@r.SortOrder</td>
        <td>@(r.IsActive ? "Yes" : "No")</td>
        <td><a asp-page="ValueEdit" asp-route-id="@r.Id">Edit</a></td>
      </tr>
    }
    </tbody>
  </table>
</div>
<h3 class="admin-lookup-section-title">Add value</h3>
<form method="post" asp-page-handler="Add" class="admin-form">
  <input type="hidden" asp-for="CategoryId" />
  <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>
  <div class="row">
    <label asp-for="NewValue.Code"></label>
    <input asp-for="NewValue.Code" required />
    <span asp-validation-for="NewValue.Code" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="NewValue.DisplayName"></label>
    <input asp-for="NewValue.DisplayName" required />
  </div>
  <div class="row">
    <label asp-for="NewValue.SortOrder"></label>
    <input asp-for="NewValue.SortOrder" type="number" />
  </div>
  <div class="row chk">
    <input asp-for="NewValue.IsActive" />
    <label asp-for="NewValue.IsActive" class="admin-label-inline"></label>
  </div>
  <div class="row">
    <label asp-for="NewValue.Metadata"></label>
    <input asp-for="NewValue.Metadata" placeholder="Optional JSON" />
  </div>
  <button type="submit" class="btn-primary"><span>Add</span></button>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
