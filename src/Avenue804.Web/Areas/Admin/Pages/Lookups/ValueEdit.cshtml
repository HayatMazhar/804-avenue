@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.Lookups.ValueEditModel
@{
    ViewData["Title"] = "Edit lookup value";
}
<p class="admin-back"><a asp-page="Values" asp-route-categoryId="@Model.CategoryId">← @Model.CategoryName</a></p>
<form method="post" class="admin-form">
  <div asp-validation-summary="ModelOnly" class="admin-validation-danger"></div>
  <div class="row">
    <label asp-for="Form.Code"></label>
    <input asp-for="Form.Code" required />
    <span asp-validation-for="Form.Code" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.DisplayName"></label>
    <input asp-for="Form.DisplayName" required />
  </div>
  <div class="row">
    <label asp-for="Form.SortOrder"></label>
    <input asp-for="Form.SortOrder" type="number" />
  </div>
  <div class="row chk">
    <input asp-for="Form.IsActive" />
    <label asp-for="Form.IsActive" class="admin-label-inline"></label>
  </div>
  <div class="row">
    <label asp-for="Form.Metadata"></label>
    <input asp-for="Form.Metadata" />
  </div>
  <div class="admin-flex-row">
    <button type="submit" class="btn-primary"><span>Save</span></button>
    <button type="submit" class="btn-outline btn-danger-outline" asp-page-handler="Delete" formnovalidate onclick="return confirm('Delete this value?');">Delete</button>
  </div>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
