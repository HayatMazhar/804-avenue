@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.Lookups.ValueEditModel
@{
    ViewData["Title"] = "Edit lookup value";
}
<p style="margin-bottom:20px"><a asp-page="Values" asp-route-categoryId="@Model.CategoryId" style="color:var(--accent);font-weight:600">← @Model.CategoryName</a></p>
<form method="post" class="admin-form">
  <div asp-validation-summary="ModelOnly" class="muted" style="color:var(--danger)"></div>
  <div class="row">
    <label asp-for="Form.Code"></label>
    <input asp-for="Form.Code" required />
    <span asp-validation-for="Form.Code" class="muted"></span>
  </div>
  <div class="row">
    <label asp-for="Form.DisplayName"></label>
    <input asp-for="Form.DisplayName" required />
  </div>
  <div class="row">
    <label asp-for="Form.SortOrder"></label>
    <input asp-for="Form.SortOrder" type="number" />
  </div>
  <div class="row chk">
    <label asp-for="Form.IsActive"></label>
    <input asp-for="Form.IsActive" />
  </div>
  <div class="row">
    <label asp-for="Form.Metadata"></label>
    <input asp-for="Form.Metadata" />
  </div>
  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
    <button type="submit" class="btn-primary"><span>Save</span></button>
    <button type="submit" class="btn-outline" style="border-color:var(--danger);color:var(--danger)" asp-page-handler="Delete" formnovalidate onclick="return confirm('Delete this value?');">Delete</button>
  </div>
</form>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
