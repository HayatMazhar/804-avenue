@page
@using Avenue804.Web.Configuration
@model Avenue804.Web.Areas.Admin.Pages.ContentBlocks.IndexModel
@{
    ViewData["Title"] = "Content blocks";
}
<p class="muted admin-lead-muted">Published HTML/text by slug. Wired slugs (edit these to change public copy):</p>
<ul class="muted admin-wired-list">
  @foreach (var s in ContentBlockSlugs.AllWiredSlugs)
  {
    <li><code>@s</code></li>
  }
</ul>
<p class="admin-back admin-back--tight"><a asp-page="Create">+ New block</a></p>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Slug</th><th>Title</th><th>Published</th><th>Updated</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
      <tr>
        <td><code>@r.Slug</code></td>
        <td>@(r.Title ?? "—")</td>
        <td>@(r.IsPublished ? "Yes" : "No")</td>
        <td>@r.UpdatedAt.LocalDateTime.ToString("g")</td>
        <td><a asp-page="Edit" asp-route-id="@r.Id">Edit</a></td>
      </tr>
    }
    </tbody>
  </table>
</div>
@if (Model.Rows.Count == 0)
{
  <p class="muted">No content blocks yet.</p>
}
