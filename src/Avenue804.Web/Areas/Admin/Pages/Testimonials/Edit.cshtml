@page "{id:int}"
@model Avenue804.Web.Areas.Admin.Pages.Testimonials.EditModel
@{
    ViewData["Title"] = "Edit testimonial";
    ViewData["AdminSection"] = "testimonials";
}

<div class="admin-back"><a asp-page="Index">← Testimonials</a></div>

<div class="as-form-page">
  <header class="as-form-page__head">
    <div class="as-form-page__title-wrap">
      <h1 class="as-form-page__title">@(string.IsNullOrWhiteSpace(Model.Form.AuthorName) ? "Edit testimonial" : Model.Form.AuthorName)</h1>
      <p class="as-form-page__sub">Edit a customer quote shown on the public site.</p>
    </div>
  </header>

  <form method="post">
    <section class="as-section">
      <header class="as-section__head">
        <div class="as-section__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3-1 5-4 5-8h-5V8c0-2 1-3 3-3M14 21c3-1 5-4 5-8h-5V8c0-2 1-3 3-3"/></svg>
        </div>
        <div class="as-section__title-wrap">
          <h2 class="as-section__title">Quote</h2>
          <p class="as-section__sub">The testimonial body, author and rating.</p>
        </div>
      </header>
      <div class="as-section__body">
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="Form.AuthorName">Author name</label>
            <input asp-for="Form.AuthorName" />
          </div>
          <div class="as-field">
            <label asp-for="Form.AuthorRole">Author role / title</label>
            <input asp-for="Form.AuthorRole" placeholder="Homeowner — Al Reem Island" />
          </div>
        </div>
        <div class="as-field">
          <label asp-for="Form.Quote">Quote</label>
          <textarea asp-for="Form.Quote" rows="4"></textarea>
        </div>
        <div class="as-row as-row--2">
          <div class="as-field">
            <label asp-for="Form.Stars">Stars (1–5)</label>
            <input asp-for="Form.Stars" type="number" min="1" max="5" />
          </div>
          <div class="as-field">
            <label asp-for="Form.SortOrder">Sort order</label>
            <input asp-for="Form.SortOrder" type="number" />
          </div>
        </div>
        <label class="as-toggle">
          <input asp-for="Form.IsActive" />
          <span class="as-toggle__switch"></span>
          <span class="as-toggle__text">
            <span class="as-toggle__title">Active</span>
            <span class="as-toggle__sub">Inactive testimonials are hidden from the public site.</span>
          </span>
        </label>
      </div>
    </section>

    <footer class="as-form-foot">
      <div class="as-form-foot__info"><span class="dot" style="background:@(Model.Form.IsActive ? "var(--as-success)" : "var(--as-mute)");"></span>@(Model.Form.IsActive ? "Visible on the public site" : "Hidden")</div>
      <div class="as-form-foot__actions">
        <button type="submit" asp-page-handler="Delete" onclick="return confirm('Delete this testimonial?')" class="as-btn as-btn--danger">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 01-2 2H9a2 2 0 01-2-2L5 6"/></svg>
          Delete
        </button>
        <a class="as-btn as-btn--ghost" asp-page="Index">Cancel</a>
        <button type="submit" class="as-btn as-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Save changes
        </button>
      </div>
    </footer>
  </form>
</div>
