@page
@model Avenue804.Web.Areas.Admin.Pages.Newsletter.IndexModel
@{
    ViewData["Title"] = "Newsletter";
    ViewData["AdminSection"] = "newsletter";
}
<div class="admin-toolbar">
  <a asp-page="Digest" class="btn-outline admin-btn-sm"><i class="bi bi-envelope me-1" aria-hidden="true"></i>Send Digest</a>
  <p class="muted">@Model.TotalCount subscriber@(Model.TotalCount != 1 ? "s" : ""). <a asp-area="Admin" asp-page="/Newsletter/Index" asp-route-export="csv" class="link-accent">Export CSV</a></p>
</div>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Date</th><th>Email</th><th>Name</th><th>Preferences</th><th>Active</th></tr></thead>
    <tbody>
      @foreach (var s in Model.Items)
      {
        <tr>
          <td>@s.SubscribedAt.ToString("d MMM yyyy")</td>
          <td>@s.Email</td>
          <td>@(s.Name ?? "—")</td>
          <td>@(s.Preferences ?? "All")</td>
          <td>@(s.IsActive ? "✓" : "—")</td>
        </tr>
      }
    </tbody>
  </table>
</div>
@if (!Model.Items.Any()) { <p class="muted admin-empty">No subscribers yet.</p> }
